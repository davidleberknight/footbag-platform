# =============================================================================
# /etc/systemd/system/footbag-backup.service
#
# One-shot SQLite backup producer; scheduled by footbag-backup.timer.
# Install: sudo cp ops/systemd/footbag-backup.service /etc/systemd/system/
#          sudo cp ops/systemd/footbag-backup.timer   /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now footbag-backup.timer
#
# Host prerequisites: sqlite3 CLI (apt-get install -y sqlite3), aws CLI with
# the /root/.aws assumed-role chain, and BACKUP_S3_BUCKET in /srv/footbag/env.
# After the first scheduled runs emit BackupAgeMinutes, flip the terraform
# enable_backup_alarm variable to true so the staleness alarm goes live.
# =============================================================================

[Unit]
Description=Footbag SQLite backup producer
Documentation=https://github.com/davidleberknight/footbag-platform
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/srv/footbag
EnvironmentFile=/srv/footbag/env
ExecStart=/usr/bin/env bash scripts/backup-db.sh

# Sandboxing. Unlike the stack unit, this one runs a real workload rather than
# a client for a daemon, so it can be confined properly: it reads one database,
# writes two small state files beside it, and uploads a snapshot.
#
# The whole file system is read-only apart from the database directory. That
# directory has to be writable, not merely readable: the backup checkpoints the
# write-ahead log into the main database file before snapshotting it, and it
# records the last-success timestamp and the consecutive-failure count there.
# The path is written out literally rather than following the environment
# variable the script accepts, so the sandbox and the script cannot drift apart
# silently; if that variable is ever repointed, this line moves with it.
ProtectSystem=strict
ReadWritePaths=/srv/footbag/db

# The snapshot and its compressed copy are built in a temporary directory, and
# a private one keeps the intermediate database copy out of the host's shared
# temp space where any other process could read it.
PrivateTmp=yes

# Home directories are readable but not writable: the AWS credential chain
# lives under root's home and has to be read to assume the upload role. The one
# exception is the credential cache the AWS client writes when it assumes that
# role; without it the run fails on an unwritable cache rather than anything to
# do with the backup itself. The leading dash tolerates its absence on a host
# where the client has not cached anything yet.
ProtectHome=read-only
ReadWritePaths=-/root/.aws/cli

NoNewPrivileges=yes
