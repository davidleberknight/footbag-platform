# NON-SECRET per-environment host config for the production host (Lightsail
# medium_3_0, 4GB): container sizing, and the adapter selectors that are a
# constant of this environment rather than an operational choice. The deploy
# reconciles these into /srv/footbag/env on every run, keyed on FOOTBAG_ENV;
# this committed file is the source of truth, so none of it depends on an
# operator remembering to set it and a hand edit on the host does not survive
# the next deploy.
#
# What belongs here and what does not. A value belongs here when it is never an
# operational choice: it changes only when the code changes, so it is reviewed
# with the code. A value an operator could legitimately want the other way
# without a code change is an arming switch, owned by Terraform and synced from
# Parameter Store. An identifier naming a resource Terraform creates is also a
# Terraform-published parameter, not a line here.
#
# Secrets (session, origin-verify, internal-event, API/webhook keys) live in
# /srv/footbag/env (operator-managed) and AWS SSM, NEVER here. Never add a
# secret, API key, identity, hostname, or URL to this file.
#
# Production sets the x264 preset rather than taking the libx264 default of
# medium. Both hosts have two vCPUs, so production is no faster at encoding than
# staging, and at medium the encoder cannot finish a file at the accepted size
# limit inside its time budget: measured on 720p material at two threads, medium
# runs 3.6x realtime against faster's 7.0x, which on this host is the difference
# between roughly 68 MB and roughly 134 MB of accepted video. Running medium
# here would leave the advertised limit failing at the top of its own range.
#
# 'faster' rather than staging's 'veryfast' keeps more compression efficiency
# while still clearing the limit with margin. Raising the accepted size beyond
# the current default means revisiting this preset, the ffmpeg time budget and
# the caller deadline together, not any one of them alone.

NGINX_MEMORY_LIMIT=128M
WEB_MEMORY_LIMIT=512M
WORKER_MEMORY_LIMIT=384M
IMAGE_MEMORY_LIMIT=896M
IMAGE_MAX_CONCURRENT=2
VIDEO_X264_PRESET=faster

# Adapter selectors that are constants of a deployed environment.
#
# Media storage is object storage on any host; the local filesystem backend is
# a development affordance. The secrets resolver is live on any host, because
# every third-party secret is read from Parameter Store there. The JWT signer
# is KMS on any host; the local keypair is a development affordance and the
# runtime refuses anything else on production.
MEDIA_STORAGE_ADAPTER=s3
SECRETS_ADAPTER=live
JWT_SIGNER=kms

# The live captcha is production-only. The runtime refuses to boot a production
# process on the stub, so this line and that refusal agree; the line is what
# makes the value visible to an operator reading the host env file, and what
# puts it back if someone edits it.
CAPTCHA_ADAPTER=live

# The widget's PUBLIC site key, which the live adapter requires at boot and
# which the browser receives in the page markup on every captcha-bearing form.
# It belongs here rather than in Parameter Store precisely because it is not a
# secret: it is published to every visitor by design, and the secret half of the
# pair (turnstile_secret_key, which verifies a solved challenge server-side) is
# the one that lives in SSM. Until now nothing wrote this at all — Terraform
# publishes only the secret half, no deploy step synced it, and the value
# reached the host by hand, which is the drift this file exists to end. A
# production boot with it unset fails, so an unowned value was one hand-edit
# away from a host that could not start.
TURNSTILE_SITE_KEY=0x4AAAAAAECeQ7Z3w4goyHNl
