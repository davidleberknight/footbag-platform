{
  "name": "footbag-platform",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "IFPA Footbag Platform — current deployed public baseline and long-term community platform",
  "engines": {
    "node": "22.22.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:image": "IMAGE_PORT=4001 tsx watch src/imageWorker.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:all": "bash scripts/dev.sh",
    "compose:dev": "bash scripts/compose-dev.sh",
    "build": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "eslint src",
    "audit": "audit-ci --moderate",
    "verify:seed-urls": "tsx scripts/verify-seed-urls.ts",
    "start": "node dist/server.js",
    "test": "vitest run --exclude 'tests/smoke/**' --exclude 'tests/e2e/**' --exclude 'tests/dev/**'",
    "test:watch": "vitest --exclude 'tests/smoke/**' --exclude 'tests/e2e/**' --exclude 'tests/dev/**'",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:persona-crawl": "RUN_PERSONA_CRAWL=1 vitest run tests/dev/",
    "test:smoke": "scripts/test-smoke.sh",
    "test:strong-hash": "FOOTBAG_CHEAP_PASSWORD_HASH=0 vitest run tests/unit/passwordHash.test.ts tests/integration/security.login-timing.test.ts",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:e2e:smoke": "playwright test -c tests/playwright.config.ts --grep @smoke",
    "test:e2e:a11y": "playwright test -c tests/playwright.config.ts --grep @a11y",
    "test:deployed": "bash scripts/test-deployed.sh",
    "test:pentest:heavy": "bash scripts/pentest/run-heavy.sh",
    "test:coverage": "vitest run --exclude 'tests/smoke/**' --exclude 'tests/e2e/**' --exclude 'tests/dev/**' --coverage",
    "test:quick": "./run_all_tests.sh --quick",
    "test:all": "npm run build && npm run typecheck:tests && npm run lint && bash scripts/ci/assert_conventions.sh && npm test && npm run test:e2e",
    "prepare": "test ! -f scripts/install-git-hooks.sh || bash scripts/install-git-hooks.sh"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1031.0",
    "@aws-sdk/client-s3": "3.1031.0",
    "@aws-sdk/client-ses": "3.1031.0",
    "@aws-sdk/client-sqs": "3.1031.0",
    "@aws-sdk/client-ssm": "3.1031.0",
    "@aws-sdk/client-sts": "3.1031.0",
    "@aws-sdk/s3-request-presigner": "3.1031.0",
    "argon2": "0.44.0",
    "better-sqlite3": "12.6.2",
    "busboy": "1.6.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "4.22.2",
    "express-handlebars": "8.0.6",
    "helmet": "8.1.0",
    "marked": "14.1.4",
    "sharp": "0.35.4",
    "sns-validator": "0.3.5",
    "stripe": "22.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "1.58.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/busboy": "1.5.4",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "4.17.25",
    "@types/node": "20.19.37",
    "@types/sns-validator": "0.3.3",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "audit-ci": "7.1.0",
    "eslint": "10.4.1",
    "happy-dom": "20.9.0",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.1",
    "vitest": "4.1.11",
    "yaml": "2.8.3"
  },
  "overrides": {
    "qs": "6.16.0",
    "brace-expansion": "5.0.12",
    "postcss": "8.5.26"
  }
}
