{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.mutation.config.ts",
    "related": false
  },
  "coverageAnalysis": "perTest",
  "ignorePatterns": [
    "legacy_data/legacy_mirror",
    "legacy_data/footbag_venv",
    "legacy_data/out",
    "legacy_data/inputs",
    "legacy_data/member_data_scripts",
    "legacy_data/event_results",
    "legacy_data/**/__pycache__",
    "footbag_legacy_repo",
    "footbag_private_repo",
    "footbag_legacy_mirror",
    "database/*.db",
    "database/*.db-wal",
    "database/*.db-shm",
    "coverage",
    "dist",
    "reports",
    ".claude/worktrees",
    "src/public/media-store",
    "scripts/.venv",
    "terraform"
  ],
  "mutate": [
    "src/services/tierPredicates.ts",
    "src/middleware/requireTier.ts",
    "src/middleware/requireAdmin.ts"
  ],
  "incremental": true,
  "incrementalFile": "../footbag-mutation/stryker-incremental.json",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "../footbag-mutation/mutation.html"
  },
  "tempDirName": "../footbag-mutation/sandbox",
  "dryRunTimeoutMinutes": 25,
  "timeoutMS": 120000,
  "timeoutFactor": 2,
  "concurrency": 2,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
