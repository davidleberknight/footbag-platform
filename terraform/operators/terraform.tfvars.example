# Reference copy of this tree's variable values. A real terraform.tfvars is
# never created here: it lives in the maintainers' private operations checkout
# and is reached from this directory by a gitignored symlink, because the values
# name people. To add or change a value, edit the private file the symlink
# points at. Without that checkout you cannot apply this tree at all.
#
# THIS IS THE FILE A HIRING OR A FIRING EDITS. A joiner is a new entry in
# `operators`; a leaver is a deleted one. Then:
#
#   bash scripts/terraform-apply.sh --target operators
#
# run as yourself. It needs no privileged sign-in, deliberately: revoking
# somebody's access must never be the slower half.

aws_region     = "us-east-1"
aws_account_id = "TODO-123456789012"

# Neither permission set's ARN is set here. Both are read from the identity
# tree's own state, so there is nothing to copy and nothing to go stale. Each
# entry below names which of the two it wants, by role.

# The roster. The key is the Identity Center user name, deliberately the same
# lower-case firstname_lastname spelling as that operator's named account on the
# hosts, so a trail entry and an ssh alias do not need translating between two
# names for one person.
#
# Everyone listed receives the permission set their job needs: no new role and
# no new policy unless their job is genuinely a third one.
#
# `role` is which of the two that is. `super_admin` reaches both environments,
# this roster, and the production host; `dev_tester` reaches staging only and is
# denied the one call that opens a shell on a host. It is the field that decides
# whether somebody can touch production, so it is set deliberately per person and
# never carried over from the entry above it.
#
# The address is where Identity Center sends the invitation that sets the
# operator's password and registers their second factor, so it has to be one
# that person reads.
operators = {
  firstname_lastname = {
    given_name  = "TODO-Firstname"
    family_name = "TODO-Lastname"
    role        = "super_admin"
    email       = "TODO-operator@example.invalid"
  }

  othername_lastname = {
    given_name  = "TODO-Othername"
    family_name = "TODO-Lastname"
    role        = "dev_tester"
    email       = "TODO-tester@example.invalid"
  }
}
