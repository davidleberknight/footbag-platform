# =============================================================================
# terraform.tfvars.example — production
# Reference copy of this environment's variable values. A real terraform.tfvars
# is never created in this tree: it lives in the maintainers' private operations
# checkout and is reached from this directory by a gitignored symlink, because
# the values carry operator CIDR ranges. To add or change a value, edit the
# private file the symlink points at. Without that checkout you cannot apply
# this environment at all.
# =============================================================================

environment    = "production"
aws_region     = "us-east-1"                  # SES sender identity and the CloudFront ACM cert are region-bound here; DR replicates to us-west-2
aws_account_id = "TODO-12-digit-account-id"

domain_name = "footbag.org"                   # TODO: Confirm apex domain

# There is no hosted zone id to set. Terraform creates the zone and every record
# reads its id from there. The four nameservers to hand the registrar come from
# the route53_name_servers output, not from the console.

lightsail_bundle_id    = "medium_3_0"         # ~$24/mo dualstack, 2 vCPU / 4 GB RAM
lightsail_blueprint_id = "amazon_linux_2023"

ssh_public_key = "ssh-ed25519 AAAAC3Nza... TODO-your-production-deploy-key"

# alarm_email is declared sensitive, so it is set nowhere in any repository:
# its value is vault-governed and lives in the gitignored secrets.auto.tfvars
# beside the values file, which Terraform auto-loads.

# Operator-supplied; verification happens via the SES email loop after apply.
# Real verified address (e.g. noreply@footbag.org). The TODO- prefix is
# rejected by ses_sender_identity's variable validation in ses.tf.
ses_sender_identity = "noreply@footbag.org"

# Aggregate-report mailbox for DMARC reports. Receives daily XML summaries
# of SPF/DKIM pass/fail rates, one per reporting provider. Required: the
# DMARC record carries this address, and its precondition fails the apply
# when the value is empty. Keep it on this domain, so no external-destination
# authorisation record is needed at the receiving side.
ses_dmarc_rua_email = "dmarc-reports@footbag.org"

# Every apex TXT string other than the SPF record ses.tf builds. Route 53
# stores one TXT record set per name, so anything left out of this list is
# destroyed when the apex TXT record applies, and a provider's domain
# verification token is exactly the kind of string that lives there: destroying
# it withdraws the proof of ownership that provider's own account recovery
# rests on. Read the live zone before the apex records go in and list what is
# already there, for example:
#   apex_txt_records = ["google-site-verification=<token>"]
# The empty list below is a placeholder and fails the apply on purpose.
apex_txt_records = []

# ── Legacy answers carried through the transition ────────────────────────────
# The zone moves to Route 53 well before anything switches, so Terraform has to
# serve the previous host's answers faithfully from the moment delegation lands.
# Each record that changes later declares both states and picks between them on
# a flag, which is what makes every switch a planned Terraform change instead of
# a console edit racing an apply.
#
# Read all three values from the fresh zone snapshot, not from memory. Turn the
# flag on at the zone move and leave it on until the legacy records are removed
# at post-cutover cleanup: the MX and apex TXT count on it too, so clearing it
# while legacy mail is still a rollback target turns a mail-flag revert into a
# deletion of those records rather than a restore.
enable_legacy_mirror_records = false
legacy_apex_ipv4             = ""
legacy_apex_spf              = ""
legacy_mx_records            = []

# The legacy names that are CNAMEs onto the apex or www, as name => target, taken
# from the fresh zone capture. They are mirrored with the rest of the zone and
# removed in the same apply that flips the alias, because each one follows the
# name it points at to the distribution, which refuses a hostname its certificate
# does not cover. The transfer found five; confirm the set and the targets
# against the capture rather than trusting this list.
legacy_apex_cname_records = {
  # fi                 = "footbag.org"
  # ftp                = "footbag.org"
  # v                  = "www.footbag.org"
  # worlds             = "www.footbag.org"
  # worldchampionships = "www.footbag.org"
}

# The rest of the legacy zone. The design requires the move to mirror every
# existing record faithfully, so that changing which servers answer changes
# nothing about what they answer. A name left out of these maps is not carried
# through the move at all: it stops resolving the moment delegation lands, with
# no error anywhere. Take every value from the zone capture and diff the maps
# against a fresh transfer immediately before the delegation change.
#
# The mail and TXT maps are the dangerous ones. A name omitted from the mail map
# silently stops inbound mail for every address at it, and an empty TXT list
# withdraws every string that name publishes, including any domain-verification
# token a provider's account recovery rests on. Both resources reject an empty
# list rather than letting that reach an apply.
legacy_mirror_a_records = {
  # rimu3 = "203.0.113.10"   # the host the apex mail records name; omitting it
  #                          # leaves the apex advertising an unresolvable
  #                          # mail destination
}

legacy_mirror_cname_records = {
  # www2 = "some.host.example."
}

legacy_mirror_mx_records = {
  # my = ["10 ASPMX.L.GOOGLE.COM."]   # the Workspace's own domain, served from
  #                                   # this zone rather than delegated; omitting
  #                                   # it stops every mailbox and group on it
}

legacy_mirror_txt_records = {
  # my = ["v=spf1 ... ~all"]
}

# Workspace DKIM public key for the google selector, generated in the Workspace
# admin console. The key cannot be generated until Gmail has served the domain
# for a day or more, so this stays empty when the MX first moves and is filled
# in afterwards. A 2048-bit key exceeds the single-string TXT limit, so supply
# it pre-split in quoted segments.
google_dkim_txt = ""

# CIDR ranges permitted to SSH into the production Lightsail instance.
operator_cidrs = ["TODO-your-public-ip/32"]

# Resolvable DNS hostname used as the CloudFront custom origin.
# For production: a real A record pointing to the Lightsail static IP
# (e.g. origin.footbag.org). Do NOT use nip.io in production.
lightsail_origin_dns = "TODO-origin.footbag.org"

# ── Cutover gates ─────────────────────────────────────────────────────────────
# The four switches that decide what the public sees, listed here because they
# default to false in the variable declarations and are otherwise invisible to
# an operator working from this file.
#
# enable_cloudfront is the master gate for the distribution, its ACM certificate
# and the certificate's DNS validation records. False for the first apply; true
# on the second, once the registrar has delegated the domain to the zone this
# configuration creates and lightsail_origin_dns resolves.
#
# enable_preview_record creates the preview.<domain> alias records for the
# pre-cutover exercises. The name already rides the certificate from its first
# issuance and already sits in the distribution's alias list, so this flag alone
# decides whether it resolves. On any time after the zone move, once the name is
# re-verified absent from the zone snapshot; removed at cutover.
#
# enable_apex_alias_records moves the apex and www off the mirrored legacy values
# and onto the distribution. Stays false through the zone move, so those names
# keep answering with the legacy host's values, and flips at the write-freeze.
#
# enable_planned_maintenance serves the maintenance page for every request. It
# flips true paired with the apex alias flip, so the distribution serves the
# migration page from that moment; going live is this one turning false again,
# not a DNS change.
enable_cloudfront             = false
enable_platform_custom_domain = false
enable_preview_record         = false
enable_apex_alias_records     = false
enable_planned_maintenance    = false

# ── Phased-apply feature gates ────────────────────────────────────────────────
# Pass 1 (first apply): both false. Pass 2: enable_cwagent_alarms = true
# AFTER scripts/install-cwagent-remote.sh has run and CWAgent is confirmed
# emitting metrics. Pass 3: enable_backup_alarm = true AFTER the snapshot
# job emits BackupAgeMinutes. ses_enable_domain_auth: keep false until the
# registrar has delegated the domain to this zone (the previous mail
# host answers for it until the zone move), else its records
# will not resolve; flip to true at the zone move, ahead of live sending,
# since it retires the single-address sender identity. ses_enable_mail_records
# publishes the apex SPF, DMARC, and MAIL FROM records and belongs to the day
# inbound mail moves to the new provider, because it replaces the apex SPF the
# previous host published. enable_cutover_login_alarm: true for the cutover
# monitoring window only, back to false after.
enable_cwagent_alarms      = false
enable_backup_alarm        = false
ses_enable_domain_auth     = false
ses_enable_mail_records    = false
enable_cutover_login_alarm = false

# ── Legacy archive (archive.footbag.org) ──────────────────────────────────────
# Independent of enable_cloudfront and of the apex alias flip: archive.footbag.org
# is a new name, so the stack can be applied, proved and loaded well ahead of the
# cutover. enable_archive needs only the public key below and serves the archive
# on the distribution's own cloudfront.net name; enable_archive_custom_domain
# adds the certificate, the aliases and the DNS records, and additionally needs
# the domain delegated to this zone, since the certificate validates through a
# record in it. Turn the second flag on once that delegation has landed.
#
# Generate the signing keypair in the ~/AWS/ operator folder (the project home
# for durable operator workstation files), never in Terraform and never inside
# a repo checkout:
#   openssl genrsa -out ~/AWS/archive-signing-key.pem 2048
#   openssl rsa -pubout -in ~/AWS/archive-signing-key.pem -out ~/AWS/archive-signing-key.pub
# Paste the .pub contents here; keep the private .pem off this file and put it
# into SSM after apply:
#   aws ssm put-parameter \
#     --name "/footbag/production/secrets/archive_signing_private_key" \
#     --value "file://$HOME/AWS/archive-signing-key.pem" --type SecureString \
#     --key-id alias/footbag-production --overwrite
enable_archive               = false
enable_archive_custom_domain = false

# Where the archive sends signed-out visitors and its gate pages link back to.
# Leave unset in production: it derives https://<domain_name>.
# archive_platform_url = ""

# archive_signing_public_key = <<-EOT
#   -----BEGIN PUBLIC KEY-----
#   TODO-paste-archive-signing-key.pub
#   -----END PUBLIC KEY-----
# EOT

# ── Arming switches ───────────────────────────────────────────────────────────
# Production starts dark on both sides (the variable defaults): stub adapters,
# staging-like, no real mail and no real money. Arm a side by setting its
# switch to "armed" here, then terraform apply and deploy; the deploy derives
# the adapter (armed -> live, dark -> stub) on the host. Sequence arming
# before real members arrive, per the go-live runbook.
# payments_armed   = "armed"
# email_send_armed = "armed"
