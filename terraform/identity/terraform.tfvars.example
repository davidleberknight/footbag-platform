# Reference copy of this tree's variable values. A real terraform.tfvars is
# never created here: it lives in the maintainers' private operations checkout
# and is reached from this directory by a gitignored symlink. To add or change a
# value, edit the private file the symlink points at. Without that checkout you
# cannot apply this tree at all.
#
# This tree declares what a human operator MAY DO. Who the operators are is not
# declared in Terraform at all: onboarding mints an access key, and a secret
# Terraform creates is a secret held in its state, so the named users are
# created and retired by scripts/manage-human-operator.sh instead.
#
# It is applied by the directly authenticated identity, never by the job role it
# declares: that role is denied every write to its own definition, so it cannot
# apply the tree that defines it.

aws_region     = "us-east-1"
aws_account_id = "TODO-123456789012"
