<div class="hero hero-sm">
  <div>
    <h1>{{hero.heading}}</h1>
    {{#if hero.subheading}}<p class="hero-subtitle">{{hero.subheading}}</p>{{/if}}
    {{> outcome-notice text=page.notice tone=page.noticeTone}}
  </div>
</div>

<div class="wrapper">

  {{! The band under the hero: the newest news items as compact dated items,
      ending in a link to the news page. }}
  <section id="home-news">
    <div class="section-heading">
      <h2>Footbag News</h2>
    </div>
    {{#if newsBand.news.length}}
      <div class="dated-list">
        {{#each newsBand.news}}{{> dated-item this compact=true}}{{/each}}
      </div>
    {{else}}
      <p class="empty-state">No news yet.</p>
    {{/if}}
    <p class="mt-4"><a class="action-link" href="{{siteHref newsBand.newsHref}}">More News</a></p>
  </section>

  <section>
    <div class="section-heading">
      <h2>Explore the World of Footbag</h2>
    </div>
    <div class="card-grid card-grid-2col">
      {{#each primaryLinks}}
        <div class="card">
          <div class="card-title">{{label}}</div>
          <p class="card-description">{{description}}</p>
          <a href="{{href}}" class="btn {{#if (eq variant 'primary')}}btn-primary{{else}}btn-outline{{/if}} card-link">{{label}}</a>
        </div>
      {{/each}}
    </div>
  </section>


</div>
