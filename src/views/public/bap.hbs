<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
    {{> outcome-notice text=page.notice tone=page.noticeTone}}
  </div>
</div>

<div class="wrapper">

  {{#each content.sections}}
    <section class="content-section">
      <div class="section-heading"><h2>{{this.heading}}</h2></div>
      {{#each this.paragraphs}}
        <p>{{#each this}}{{#if href}}{{{externalLink href label=text noIcon=true}}}{{else}}{{text}}{{/if}}{{/each}}</p>
      {{/each}}
    </section>
  {{/each}}

  {{#if content.externalLink}}
    <p class="mt-4 mb-8">
      <a href="{{content.externalLink.href}}" class="btn btn-outline" target="_blank" rel="noopener noreferrer">{{content.externalLink.label}}</a>
    </p>
  {{/if}}

</div>
