<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p class="hero-subtitle">Create a provenance source for the freestyle trick dictionary, so a new source can be cited when linking it to a trick. This is the dictionary provenance registry (who or what asserted a trick's existence, ADD, or notation), not the separate media-source registry. {{content.totalCount}} source(s).</p>
  </div>
</div>

<div class="wrapper">
  <section>
    <h2 class="section-heading">New Source</h2>

    {{#if content.error}}
    <div class="form-error-banner" role="alert">
      <p>{{content.error}}</p>
    </div>
    {{/if}}

    <form method="POST" action="/admin/freestyle/sources" class="form-block">
      <div class="form-field">
        <label for="source-id">Source ID</label>
        <input type="text" id="source-id" name="id" value="{{content.submitted.id}}" placeholder="e.g. anz-trikz-2026" aria-describedby="source-id-hint" />
        <small class="form-hint" id="source-id-hint">Lowercase letters, digits, hyphens, and underscores; must begin and end with a letter or digit. This becomes a permanent referenced identifier and cannot be renamed through this surface.</small>
      </div>
      <div class="form-field">
        <label for="source-type">Source type</label>
        <select id="source-type" name="sourceType">
          <option value="">Choose a type</option>
          {{#each content.typeOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="form-field">
        <label for="source-label">Source label</label>
        <input type="text" id="source-label" name="sourceLabel" value="{{content.submitted.sourceLabel}}" placeholder="Human-readable description" />
      </div>
      <div class="form-field">
        <label for="source-retrievedAt">Retrieved at</label>
        <input type="text" id="source-retrievedAt" name="retrievedAt" value="{{content.retrievedAtValue}}" aria-describedby="source-retrievedAt-hint" />
        <small class="form-hint" id="source-retrievedAt-hint">ISO-8601 UTC, e.g. 2026-04-20T00:00:00.000Z. Prefilled with now; change it if the source was retrieved earlier.</small>
      </div>
      <div class="form-field">
        <label for="source-url">Source URL (optional)</label>
        <input type="text" id="source-url" name="sourceUrl" value="{{content.submitted.sourceUrl}}" />
      </div>
      <div class="form-field">
        <label for="source-notes">Notes (optional)</label>
        <textarea id="source-notes" name="notes" rows="2">{{content.submitted.notes}}</textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Create Source</button>
      </div>
    </form>

    <h2 class="section-heading mt-6">Existing Sources</h2>
    {{#if content.hasRows}}
      <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="Existing sources">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Type</th>
            <th>Label</th>
            <th>URL</th>
            <th>Retrieved at</th>
            <th>Notes</th>
          </tr>
        </thead>
        <tbody>
          {{#each content.rows}}
            <tr>
              <td><code>{{this.id}}</code></td>
              <td>{{this.sourceType}}</td>
              <td>{{this.sourceLabel}}</td>
              <td>{{this.sourceUrl}}</td>
              <td>{{this.retrievedAt}}</td>
              <td>{{this.notes}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      </div>
    {{else}}
      <div class="empty-state"><p>No sources yet.</p></div>
    {{/if}}
  </section>
</div>
