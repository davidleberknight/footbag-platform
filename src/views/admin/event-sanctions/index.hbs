<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  {{#if content.notice}}
    {{> outcome-notice text=content.notice.text tone=content.notice.tone}}
  {{/if}}
  {{#if content.errorMessage}}
    {{> outcome-notice text=content.errorMessage tone='no'}}
  {{/if}}

  <section>
    <div class="section-heading">
      <h2>Draft Events</h2>
      <span class="section-count">{{content.events.length}}</span>
    </div>
    {{#unless content.hasEvents}}
      <p>{{content.emptyMessage}}</p>
    {{/unless}}
    {{#each content.events}}
      <div class="card">
        <div class="card-title">{{title}}</div>
        <p class="card-meta">{{dates}} &middot; {{location}}</p>
        <form method="POST" action="{{action}}" class="form-block">
          <div class="form-field">
            <label for="citation_{{eventId}}">Board decision</label>
            <textarea id="citation_{{eventId}}" name="citation" rows="2" maxlength="500" required></textarea>
          </div>
          <button type="submit" class="btn btn-outline btn-sm">Record Board-awarded Sanction</button>
        </form>
      </div>
    {{/each}}
  </section>
</div>
