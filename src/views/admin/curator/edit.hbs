<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{#if content.notFound}}
    {{#> outcome-notice tone='no'}}
      No curator media item with id <code>{{content.mediaId}}</code> exists.
    {{/outcome-notice}}
    <p><a href="{{content.cancelHref}}">Back to list</a></p>
  {{else}}
    {{> outcome-notice text=content.errorMessage tone='no'}}

    {{#if content.media.thumbnailUrl}}
      <img src="{{content.media.thumbnailUrl}}" alt="" class="curator-thumb" width="200">
    {{/if}}

    <p>
      Type: <strong>{{content.media.mediaType}}</strong>
      {{#if content.media.isSidecarBacked}}
        ({{content.media.videoPlatform}} URL reference{{#if content.sidecarWritesEnabled}}, sidecar-backed{{/if}})
      {{/if}}
      &middot;
      Media id: <code>{{content.media.mediaId}}</code>
    </p>
    <p class="fs-sm">
      The <code>#curated</code> tag is auto-applied and not editable here.
      {{#if content.media.isSidecarBacked}}
        {{#if content.sidecarWritesEnabled}}
        Edits write through to the sidecar JSON under <code>/curated/</code>;
        the platform DB updates inline. Run the curator seeder to fully resync.
        {{/if}}
      {{else}}
        File replacement is not supported in-place; delete and re-upload to change the file.
      {{/if}}
    </p>

    <form action="{{content.formAction}}" method="POST" class="form-block">
      <div class="form-field">
        <label for="curator-edit-caption">Caption</label>
        <input type="text" id="curator-edit-caption" name="caption" maxlength="500" value="{{content.media.caption}}">
        <small class="form-hint">Up to 500 characters.{{#if content.media.isSidecarBacked}} Writes to the sidecar's title.{{/if}}</small>
      </div>

      <div class="form-field">
        <label for="curator-edit-tags">Tags</label>
        <input type="text" id="curator-edit-tags" name="tags" value="{{content.media.tagsString}}">
        <small class="form-hint">Space-separated, lowercase, each starting with <code>#</code>. A clip that names a trick carries exactly one of <code>#tutorial</code>, <code>#demo</code> or <code>#record</code>, which is what says what the clip is for.</small>
      </div>

      <div class="form-field">
        <label for="curator-edit-external-url">External URL</label>
        <input type="url" id="curator-edit-external-url" name="externalUrl" value="{{content.media.externalUrl}}" placeholder="https://example.com/article">
        <small class="form-hint">Link to the source page or creator. Optional.</small>
      </div>

      {{#if content.media.isSidecarBacked}}
        <fieldset class="form-fieldset">
          <legend>URL reference fields</legend>
          <p class="fs-sm">
            Read-only:
            <code>videoUrl</code> = <code>{{content.media.videoUrl}}</code>,
            <code>videoPlatform</code> = <code>{{content.media.videoPlatform}}</code>.
            Changing them implies a filename rename; not supported here, delete and re-upload.
          </p>
          <div class="form-field">
            <label for="curator-edit-source-id">Source id</label>
            <input type="text" id="curator-edit-source-id" name="sourceId" value="{{content.media.sourceId}}">
            <small class="form-hint">Must exist in <code>media_sources.source_id</code>.</small>
          </div>
          <div class="form-field">
            <label for="curator-edit-start-seconds">Start (seconds)</label>
            <input type="number" id="curator-edit-start-seconds" name="startSeconds" min="0" value="{{content.media.startSeconds}}">
          </div>
          <div class="form-field">
            <label for="curator-edit-end-seconds">End (seconds)</label>
            <input type="number" id="curator-edit-end-seconds" name="endSeconds" min="0" value="{{content.media.endSeconds}}">
          </div>
          {{#if content.media.showThumbnailField}}
            <div class="form-field">
              <label for="curator-edit-thumbnail-url">Thumbnail URL</label>
              <input type="url" id="curator-edit-thumbnail-url" name="thumbnailUrl" value="{{content.media.thumbnailUrl}}">
              <small class="form-hint">Vimeo only, and must be <code>https://</code>.</small>
            </div>
          {{/if}}
        </fieldset>
      {{/if}}

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="{{content.cancelHref}}" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  {{/if}}
</div>
