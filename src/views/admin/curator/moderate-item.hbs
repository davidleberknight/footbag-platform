<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  {{> outcome-notice text=content.outcome.text tone=content.outcome.tone}}
  {{> outcome-notice text=content.errorMessage tone='no'}}

  <section>
    <div class="section-heading">
      <h2>Caption</h2>
    </div>
    <p class="card-meta">Uploaded by {{content.uploaderDisplayName}} &middot; <a href="{{content.itemHref}}">View the item</a></p>
    {{#if content.hasCaption}}
      <p>{{content.caption}}</p>
      <form method="POST" action="{{content.formAction}}" class="form-block">
        <div class="form-field">
          <label for="caption_reason">Reason (required)</label>
          <input type="text" id="caption_reason" name="reason" value="{{content.reason}}" maxlength="500" required />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Clear the Caption</button>
        </div>
      </form>
    {{else}}
      <p class="text-muted">This item has no caption.</p>
    {{/if}}
  </section>
</div>
