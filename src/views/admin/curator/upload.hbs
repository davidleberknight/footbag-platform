{{!--
  The curator's Share Media form: the member's form (partial
  share-media-form) with the curator's differences, credited to Footbag Hacky.
  A submit lands back here with its report. Photo and link uploads work
  without JavaScript; where storage is S3 a video file needs it, and the
  noscript banner says so.
--}}
<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}

  <p>{{content.intro}}</p>

  {{> share-notices notices=content.curator.notices}}
  {{> outcome-notice text=content.notice}}
  {{> outcome-notice text=content.errorMessage tone='no'}}

  {{#if content.curator.asyncEnabled}}
    <noscript>
      <div class="notice-card notice-card--warn">
        JavaScript is required to upload videos in this environment.
        Photo and video link uploads work without it.
      </div>
    </noscript>
  {{/if}}

  {{> share-media-form c=content}}
</div>
