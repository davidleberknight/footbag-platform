<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  <section>
    {{#if content.hasRows}}
      <div class="records-table-wrap" tabindex="0" role="region" aria-label="Freestyle families">
      <table class="data-table">
        <thead>
          <tr>
            <th>Slug</th>
            <th>Name</th>
            <th>Tier</th>
            <th>Parent</th>
            <th>Order</th>
          </tr>
        </thead>
        <tbody>
          {{#each content.rows}}
            <tr>
              <td><a href="{{this.editHref}}"><code>{{this.slug}}</code></a></td>
              <td>{{this.name}}</td>
              <td>{{this.tierLabel}}</td>
              <td>{{this.parentName}}</td>
              <td>{{this.sortOrder}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      </div>
    {{else}}
      <div class="empty-state"><p>No families yet.</p></div>
    {{/if}}
  </section>
</div>
