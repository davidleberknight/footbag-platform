<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  {{> outcome-notice text=content.club.errorMessage tone='no'}}
  {{> outcome-notice text=content.club.notice.text tone=content.club.notice.tone}}

  <section>
    {{#if content.club.needsLeader}}<p class="badge">No co-leader yet</p>{{/if}}

    <div class="section-heading">
      <h2>Current Leadership ({{content.club.leadershipCount}}/5)</h2>
    </div>
    {{#unless content.club.leaders.length}}
      <p>No leadership rows.</p>
    {{/unless}}
    {{#each content.club.leaders}}
      <div class="card">
        <div class="card-title">{{displayName}} <span class="badge">{{roleLabel}}</span></div>
        <form method="POST" action="/admin/clubs/{{../content.club.clubId}}/leadership/demote" class="form-block">
          <input type="hidden" name="member_id" value="{{memberId}}" />
          <div class="form-field">
            <label for="demote_reason_{{memberId}}">Reason (required)</label>
            <input id="demote_reason_{{memberId}}" name="reason" required maxlength="500" />
          </div>
          <div class="form-field">
            <label for="demote_mode_{{memberId}}">Action</label>
            <select id="demote_mode_{{memberId}}" name="mode">
              <option value="to_member">Demote to ordinary member</option>
              <option value="remove_affiliation">Remove affiliation entirely</option>
            </select>
          </div>
          <button type="submit" class="btn btn-outline btn-sm">Apply</button>
        </form>
      </div>
    {{/each}}
  </section>

  <section>
    <div class="section-heading"><h2>Assign a Co-leader</h2></div>
    <form method="POST" action="{{content.club.assignHref}}" id="{{content.club.assignFormId}}" class="form-block">
      {{> member-picker content.club.leaderPicker}}
      <div class="form-field">
        <label for="assign_reason">Reason (required)</label>
        <input id="assign_reason" name="reason" value="{{content.club.reasonValue}}" required maxlength="500" />
      </div>
      <button type="submit" class="btn btn-primary">Assign</button>
    </form>
    <script src="{{{asset 'js/member-picker-enter.js'}}}" defer></script>

    {{! The club's own members are the likeliest co-leaders, so each is a ready
        choice for the assign form's picker; anyone else is found by searching. }}
    {{#if content.club.affiliatedMembers.length}}
      <p class="mt-4 fs-sm">Members of this club who are not co-leaders. Any member can be assigned, not only these.</p>
      {{#each content.club.affiliatedMembers}}
        <div class="card">
          <div class="card-title">{{displayName}} <span class="text-muted fs-sm">{{memberId}}</span></div>
          <p class="m-0 mt-1 text-muted fs-sm">{{slug}}</p>
          <p class="m-0 mt-1"><a href="{{recordHref}}">Open their member record</a></p>
          <button type="submit" form="{{../content.club.assignFormId}}" name="pick" value="{{chooseValue}}" formaction="{{../content.club.leaderPicker.intentAction}}" formnovalidate aria-label="{{chooseAriaLabel}}" class="btn btn-outline btn-sm">Choose</button>
        </div>
      {{/each}}
    {{else}}
      <p class="mt-4 fs-sm">No member of this club is available to assign. Any member can be assigned, not only members of the club.</p>
    {{/if}}
  </section>

  <p class="mt-4"><a href="/admin/club-cleanup">Back to the club cleanup queue</a></p>
</div>
