<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p>{{content.totalItems}} item(s) requiring attention.</p>
  </div>
</div>

<div class="wrapper">
  <section>
    {{> outcome-notice text=page.notice tone=page.noticeTone}}
    <form method="GET" action="/admin/club-cleanup" class="cleanup-filter-form">
      <label>Category <select name="category" class="cleanup-action-select">
        <option value="">All categories</option>
        {{#each content.filters.categoryOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select></label>
      <label>Region or country <input type="text" name="region" class="cleanup-reason-input" value="{{content.filters.region}}" /></label>
      <label>Sort order <select name="sort" class="cleanup-action-select">
        <option value="">Default order</option>
        {{#each content.filters.sortOptions}}
          <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select></label>
      <button type="submit" class="btn btn-outline btn-sm">Filter</button>
      {{#if content.filters.isFiltered}}
        <a href="/admin/club-cleanup" class="fs-sm">Clear</a>
      {{/if}}
    </form>
  </section>

  <section class="mt-4">
    {{#if content.ruleDemotionCount}}
      <details class="cleanup-group">
        <summary>Demotions the Rules Would Make ({{content.ruleDemotionCount}})</summary>
        <p class="mt-2">Each club here has nothing on its record saying it exists. Applying the rules demotes these clubs to inactive, where they stay listed and come back the moment someone joins or leads them, and retires their unconfirmed legacy affiliations.</p>
        <form method="POST" action="/admin/club-cleanup/apply-rules" class="cleanup-action-form mt-2">
          <button type="submit" class="btn btn-primary btn-sm">Apply the Rules</button>
        </form>
        <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="Demotions the rules would make">
        <table class="cleanup-queue-table">
          <thead>
            <tr>
              <th>Club</th>
              <th>Location</th>
            </tr>
          </thead>
          <tbody>
            {{#each content.ruleDemotions}}
              <tr>
                <td class="fw-600">{{this.clubName}}</td>
                <td class="text-muted">{{this.clubCity}}{{#if this.clubCountry}}, {{this.clubCountry}}{{/if}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table></div>
      </details>
    {{/if}}
    {{#if content.itemGroups.length}}
      {{#each content.itemGroups}}
        <details class="cleanup-group">
          <summary>{{this.label}} ({{this.count}})</summary>
          {{#if this.isOpportunity}}
            <p class="fs-sm mt-2">These clubs could use a leader. Leaderless is a tolerated state, not a problem: nothing here needs remediation, and a club leaves this list by itself the moment anyone becomes a co-leader. Demotion is driven only by member-reported inactivity signals, never by this list.</p>
          {{/if}}
          <form method="POST" action="/admin/club-cleanup/bulk-resolve" class="cleanup-action-form mt-2">
            <input type="hidden" name="group" value="{{this.predicate}}" />
            <label>Action <select name="action" class="cleanup-action-select">
              <option value="park">Park All</option>
            </select></label>
            <label>Shared reason <input type="text" name="reasonText" class="cleanup-reason-input" /></label>
            <button type="submit" class="btn btn-outline btn-sm">Park Group</button>
          </form>
          <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="{{this.label}}">
          <table class="cleanup-queue-table">
            <thead>
              <tr>
                <th>Club</th>
                <th>Location</th>
                <th>Status</th>
                <th>Detail</th>
                <th>Recommendation</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              {{#each this.items}}
                <tr>
                  <td class="fw-600">{{this.clubName}}
                    {{#if this.claimLabel}}<br /><span class="text-muted fs-sm">{{this.claimLabel}}</span>{{else}}
                    <form method="POST" action="/admin/club-cleanup/claim" class="cleanup-action-form mt-1">
                      <input type="hidden" name="itemType" value="club" />
                      <input type="hidden" name="itemId" value="{{this.clubId}}" />
                      <button type="submit" class="btn btn-outline btn-sm">Claim</button>
                    </form>
                    {{/if}}
                  </td>
                  <td class="text-muted">{{this.clubCity}}{{#if this.clubCountry}}, {{this.clubCountry}}{{/if}}</td>
                  <td><span class="badge">{{this.clubStatus}}</span></td>
                  <td class="text-muted fs-sm">{{this.detail}}
                    {{#each this.insightNotes}}
                      <p class="mt-1 mb-0">&ldquo;{{this.text}}&rdquo; <span class="text-muted">{{this.authorDisplayName}}, {{this.at}}</span></p>
                    {{/each}}
                  </td>
                  <td class="fs-sm">{{this.recommendedAction}}</td>
                  <td>
                    {{#if this.showLeaderlessControls}}
                    <a href="/admin/clubs/{{this.clubId}}/leadership" class="btn btn-primary btn-sm">Add a Co-leader</a>
                    <form method="POST" action="/admin/club-cleanup/{{this.clubId}}/contact-members" class="cleanup-action-form mt-1">
                      <button type="submit" class="btn btn-outline btn-sm">Contact Members</button>
                    </form>
                    {{/if}}
                    <form method="POST" action="/admin/club-cleanup/{{this.clubId}}/resolve" class="cleanup-action-form">
                      <input type="hidden" name="predicate" value="{{this.predicate}}" />
                      <label>Action <select name="action" class="cleanup-action-select">
                        {{#unless this.isOpportunity}}
                        <option value="demote_inactive">Demote</option>
                        <option value="dismiss">Dismiss</option>
                        {{/unless}}
                        <option value="archive">Archive</option>
                        <option value="park">Park</option>
                      </select></label>
                      <label>Reason <input type="text" name="reasonText" class="cleanup-reason-input" /></label>
                      <button type="submit" class="btn btn-outline btn-sm">Apply to Club</button>
                    </form>
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table></div>
        </details>
      {{/each}}
    {{else}}
      <p>No clubs require attention. Signals are collected during member onboarding.</p>
    {{/if}}
  </section>

  {{#if content.candidateFlags.length}}
  <section class="mt-8">
    <details class="cleanup-group">
    <summary>Wizard Flags by Candidate ({{content.candidateFlags.length}})</summary>
    <p class="fs-sm">Activity answers members left about club candidates that have no live club row yet, so the viability gates cannot evaluate them. One vote per member; a member's latest answer wins. Dismiss is terminal; parked flags wait without a deadline and stay listed with who parked them. Promoting the candidate moves its votes to the live club's viability evaluation.</p>
    <form method="POST" action="/admin/club-cleanup/bulk-resolve" class="cleanup-action-form mt-2">
      <input type="hidden" name="group" value="candidate_flag" />
      <label>Action <select name="action" class="cleanup-action-select">
        <option value="park">Park All</option>
      </select></label>
      <label>Shared reason <input type="text" name="reasonText" class="cleanup-reason-input" /></label>
      <button type="submit" class="btn btn-outline btn-sm">Park Group</button>
    </form>
    <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="Wizard flags by candidate">
    <table class="cleanup-queue-table">
      <thead>
        <tr>
          <th>Candidate</th>
          <th>Location</th>
          <th>Classification</th>
          <th>Signals</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each content.candidateFlags}}
          <tr>
            <td class="fw-600">{{this.displayName}}{{#if this.parkAnnotation}}<br /><span class="text-muted fs-sm">{{this.parkAnnotation}}</span>{{/if}}
              {{#if this.claimLabel}}<br /><span class="text-muted fs-sm">{{this.claimLabel}}</span>{{else}}
              <form method="POST" action="/admin/club-cleanup/claim" class="cleanup-action-form mt-1">
                <input type="hidden" name="itemType" value="candidate" />
                <input type="hidden" name="itemId" value="{{this.candidateId}}" />
                <button type="submit" class="btn btn-outline btn-sm">Claim</button>
              </form>
              {{/if}}
            </td>
            <td class="text-muted">{{this.city}}{{#if this.country}}, {{this.country}}{{/if}}</td>
            <td><span class="badge">{{this.classificationLabel}}</span></td>
            <td class="text-muted fs-sm">{{this.detail}}
              {{#each this.insightNotes}}
                <p class="mt-1 mb-0">&ldquo;{{this.text}}&rdquo; <span class="text-muted">{{this.authorDisplayName}}, {{this.at}}</span></p>
              {{/each}}
            </td>
            <td>
              <form method="POST" action="/admin/club-cleanup/candidates/{{this.candidateId}}/resolve" class="cleanup-action-form">
                <input type="hidden" name="predicate" value="candidate_flags" />
                <label>Action <select name="action" class="cleanup-action-select">
                  <option value="dismiss">Dismiss</option>
                  <option value="park">Park</option>
                </select></label>
                <label>Reason <input type="text" name="reasonText" class="cleanup-reason-input" /></label>
                <button type="submit" class="btn btn-outline btn-sm">Apply to Candidate</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table></div>
    </details>
  </section>
  {{/if}}

  {{#if content.residue.length}}
  <section class="mt-8">
    <details class="cleanup-group">
    <summary>Unconfirmed legacy residue ({{content.residue.length}})</summary>
    <p class="fs-sm">Live clubs still showing legacy affiliations that no one has confirmed in onboarding. De-listing marks them as former-only so they stop rendering as possible members. The oldest-age column is an advisory grace signal; nothing is retired automatically.</p>
    <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="Unconfirmed legacy residue">
    <table class="cleanup-queue-table">
      <thead>
        <tr>
          <th>Club</th>
          <th>Location</th>
          <th>Status</th>
          <th>Unconfirmed</th>
          <th>Oldest</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each content.residue}}
          <tr>
            <td class="fw-600">{{this.clubName}}
              {{#if this.claimLabel}}<br /><span class="text-muted fs-sm">{{this.claimLabel}}</span>{{else}}
              <form method="POST" action="/admin/club-cleanup/claim" class="cleanup-action-form mt-1">
                <input type="hidden" name="itemType" value="club" />
                <input type="hidden" name="itemId" value="{{this.clubId}}" />
                <button type="submit" class="btn btn-outline btn-sm">Claim</button>
              </form>
              {{/if}}
            </td>
            <td class="text-muted">{{this.clubCity}}{{#if this.clubCountry}}, {{this.clubCountry}}{{/if}}</td>
            <td><span class="badge">{{this.clubStatus}}</span></td>
            <td>{{this.pendingCount}}</td>
            <td class="text-muted fs-sm">{{this.oldestPendingAgeLabel}}</td>
            <td>
              <form method="POST" action="/admin/club-cleanup/{{this.clubId}}/delist-residue" class="cleanup-action-form">
                <label>Reason <input type="text" name="reasonText" class="cleanup-reason-input" /></label>
                <button type="submit" class="btn btn-outline btn-sm">De-list Unconfirmed</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table></div>
    </details>
  </section>
  {{/if}}

  {{#if content.candidates.length}}
  <section class="mt-8">
    <details class="cleanup-group">
    <summary>Promotable Candidates ({{content.candidates.length}})</summary>
    <p class="fs-sm">Legacy club candidates with no live club row yet. Promoting creates the live club and carries its unconfirmed legacy affiliations forward; members can also trigger promotion by confirming these clubs in onboarding. Demote moves an onboarding-visible candidate to dormant; archive is terminal.</p>
    <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="Promotable candidates">
    <table class="cleanup-queue-table">
      <thead>
        <tr>
          <th>Candidate</th>
          <th>Location</th>
          <th>Classification</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each content.candidates}}
          <tr>
            <td class="fw-600">{{this.displayName}}{{#if this.parkAnnotation}}<br /><span class="text-muted fs-sm">{{this.parkAnnotation}}</span>{{/if}}
              {{#if this.claimLabel}}<br /><span class="text-muted fs-sm">{{this.claimLabel}}</span>{{else}}
              <form method="POST" action="/admin/club-cleanup/claim" class="cleanup-action-form mt-1">
                <input type="hidden" name="itemType" value="candidate" />
                <input type="hidden" name="itemId" value="{{this.candidateId}}" />
                <button type="submit" class="btn btn-outline btn-sm">Claim</button>
              </form>
              {{/if}}
            </td>
            <td class="text-muted">{{this.city}}{{#if this.country}}, {{this.country}}{{/if}}</td>
            <td><span class="badge">{{this.classificationLabel}}</span></td>
            <td>
              <form method="POST" action="/admin/club-cleanup/candidates/{{this.candidateId}}/promote" class="cleanup-action-form">
                {{#if this.needsRegion}}
                  <label>Region <select name="region" class="cleanup-action-select">
                    <option value="">State or province</option>
                    {{#each this.regionOptions}}
                      <option value="{{this.value}}">{{this.label}}</option>
                    {{/each}}
                  </select></label>
                {{/if}}
                <label>Reason <input type="text" name="reasonText" class="cleanup-reason-input" /></label>
                <button type="submit" class="btn btn-outline btn-sm">Promote to Live Club</button>
              </form>
              <form method="POST" action="/admin/club-cleanup/candidates/{{this.candidateId}}/resolve" class="cleanup-action-form mt-1">
                <label>Action <select name="action" class="cleanup-action-select">
                  <option value="demote">Demote to dormant</option>
                  <option value="archive">Archive</option>
                  <option value="park">Park</option>
                </select></label>
                <label>Reason <input type="text" name="reasonText" class="cleanup-reason-input" /></label>
                <button type="submit" class="btn btn-outline btn-sm">Apply to Candidate</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table></div>
    </details>
  </section>
  {{/if}}

  {{#if content.junkCandidates.length}}
  <section class="mt-8">
    <details class="cleanup-group">
    <summary>Junk-flagged Candidates ({{content.junkCandidates.length}})</summary>
    <p class="fs-sm">Candidates the classifier marked junk. Junk never renders on any public surface. Confirm the verdict (terminal), or promote to dormant to return the candidate to normal evaluation.</p>
    <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="Junk-flagged candidates">
    <table class="cleanup-queue-table">
      <thead>
        <tr>
          <th>Candidate</th>
          <th>Location</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        {{#each content.junkCandidates}}
          <tr>
            <td class="fw-600">{{this.displayName}}
              {{#if this.claimLabel}}<br /><span class="text-muted fs-sm">{{this.claimLabel}}</span>{{else}}
              <form method="POST" action="/admin/club-cleanup/claim" class="cleanup-action-form mt-1">
                <input type="hidden" name="itemType" value="candidate" />
                <input type="hidden" name="itemId" value="{{this.candidateId}}" />
                <button type="submit" class="btn btn-outline btn-sm">Claim</button>
              </form>
              {{/if}}
            </td>
            <td class="text-muted">{{this.city}}{{#if this.country}}, {{this.country}}{{/if}}</td>
            <td>
              <form method="POST" action="/admin/club-cleanup/candidates/{{this.candidateId}}/resolve" class="cleanup-action-form">
                <label>Action <select name="action" class="cleanup-action-select">
                  <option value="confirm_junk">Confirm junk</option>
                  <option value="promote_dormant">Promote to dormant</option>
                </select></label>
                <label>Reason <input type="text" name="reasonText" class="cleanup-reason-input" /></label>
                <button type="submit" class="btn btn-outline btn-sm">Apply to Candidate</button>
              </form>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table></div>
    </details>
  </section>
  {{/if}}

  {{#if content.areaInsights.length}}
  <section class="mt-8">
    <details>
      <summary class="section-heading">What members told us about their area ({{content.areaInsights.length}})</summary>
      <p class="fs-sm">Notes members left during onboarding about clubs near them, rather
        than about one club we asked about. They belong to no queue row, so read them when a decision
        above is close.</p>
      <ul class="mt-4">
        {{#each content.areaInsights}}
          <li class="mb-2">&ldquo;{{this.text}}&rdquo;
            <span class="text-muted fs-sm">{{this.authorDisplayName}}{{#if this.authorLocation}}, {{this.authorLocation}}{{/if}}, {{this.at}}</span>
          </li>
        {{/each}}
      </ul>
    </details>
  </section>
  {{/if}}

  {{#if content.parkedCount}}
  <section>
    <details>
      <summary class="section-heading">Parked ({{content.parkedCount}})</summary>
      <p class="fs-sm">Parked items wait without a deadline. Any club whose members
        answer a card or leave a note after it was parked returns to the queue above on its own.</p>
      <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="Parked">
      <table class="cleanup-queue-table">
        <thead>
          <tr><th>Club or candidate</th><th>Location</th><th>Category</th><th>Parked</th><th>Reason</th></tr>
        </thead>
        <tbody>
          {{#each content.parked}}
            <tr>
              <td>{{this.clubName}}</td>
              <td>{{this.clubCity}}{{#if this.clubCountry}}, {{this.clubCountry}}{{/if}}</td>
              <td>{{this.predicateLabel}}</td>
              <td>by {{this.parkedByLabel}} on {{this.parkedAt}}</td>
              <td>{{#if this.reasonText}}{{this.reasonText}}{{else}}<span class="text-muted">none given</span>{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table></div>
    </details>
  </section>
  {{/if}}

  <section>
    <p class="mt-6"><a href="/admin">&larr; Admin Dashboard</a></p>
  </section>
</div>
