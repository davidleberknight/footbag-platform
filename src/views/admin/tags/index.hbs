<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> outcome-notice text=page.notice tone=page.noticeTone}}
  {{#if content.errorMessage}}
    <div class="form-error-banner" role="alert">{{content.errorMessage}}</div>
  {{/if}}

  <section>
    <div class="section-heading"><h2>Find a Hashtag</h2></div>
    <p class="text-muted fs-sm">Members invent their own hashtags and the platform imposes no vocabulary on them. This surface is for taking an abusive one out of circulation, not for tidying the words members chose.</p>
    <div class="search-box-section">
      <form method="GET" action="/admin/tags" class="search-box-form">
        <input type="text" name="q" maxlength="200"
               placeholder="The hashtag, with or without the #"
               value="{{content.query}}"
               aria-label="Find a hashtag by its exact text"
               class="search-box-input" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    </div>

    {{#if content.resultSummary}}
      <p class="text-muted">{{content.resultSummary}}</p>
    {{/if}}
  </section>

  {{#if content.tag}}
    <section>
      <div class="section-heading"><h2>What This Hashtag Carries</h2></div>
      <div class="event-meta-row">
        <span>{{content.tag.display}}</span>
      </div>
      <dl class="trick-structural-facts-list">
        {{#each content.tag.facts}}
          <dt>{{label}}</dt><dd>{{value}}</dd>
        {{/each}}
      </dl>

      {{#if content.tag.canRetire}}
        <details class="admin-action-disclosure">
          <summary>Retire This Hashtag</summary>
          <p class="text-muted fs-sm">Retiring takes the hashtag off every photo, video and gallery that names it, and stops anybody applying it again. The items themselves are untouched, and so is everything their owners wrote about them. Nothing on the site can undo this.</p>
          <form method="POST" action="{{content.retireAction}}" class="form-block">
            <input type="hidden" name="tag" value="{{content.tag.normalized}}" />
            <div class="form-field">
              <label for="retire_reason">Reason (required)</label>
              <input type="text" id="retire_reason" name="reason" maxlength="500" required />
            </div>
            <button type="submit" class="btn btn-primary">Review the Retirement</button>
          </form>
        </details>
      {{else}}
        <p class="form-notice" role="status">{{content.tag.barMessage}}</p>
      {{/if}}
    </section>
  {{/if}}

  <p class="mt-4"><a href="/admin">Back to the admin dashboard</a></p>
</div>
