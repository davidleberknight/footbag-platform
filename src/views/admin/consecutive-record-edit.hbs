<div class="hero hero-sm">
  <div>
    {{#if content.isNew}}
    <h1>New Consecutive-kicks Record</h1>
    <p class="hero-subtitle">Add a consecutive-kicks record.</p>
    {{else}}
    <h1>Edit Consecutive-kicks Record</h1>
    <p class="hero-subtitle">Editing record <code>{{content.id}}</code>.</p>
    {{/if}}
  </div>
</div>

<div class="wrapper">
  <section>
    {{#if content.saved}}
    <p class="form-success-banner" role="status">Saved.</p>
    {{/if}}
    {{#if content.hasErrors}}
    <div class="form-error-banner" role="alert">
      {{#each content.errorList}}<p>{{this}}</p>{{/each}}
    </div>
    {{/if}}

    <form method="POST" action="{{content.formAction}}" class="form-block">
      <fieldset class="form-fieldset">
        <div class="form-field">
          <label for="consecutive-sortOrder">Display position</label>
          <input type="text" id="consecutive-sortOrder" name="sortOrder" value="{{content.fields.sortOrder}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-section">Section</label>
          <input type="text" id="consecutive-section" name="section" value="{{content.fields.section}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-subsection">Subsection</label>
          <input type="text" id="consecutive-subsection" name="subsection" value="{{content.fields.subsection}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-division">Division</label>
          <input type="text" id="consecutive-division" name="division" value="{{content.fields.division}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-year">Year</label>
          <input type="text" id="consecutive-year" name="year" value="{{content.fields.year}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-rank">Rank</label>
          <input type="text" id="consecutive-rank" name="rank" value="{{content.fields.rank}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-player1">Player 1</label>
          <input type="text" id="consecutive-player1" name="player1" value="{{content.fields.player1}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-player2">Player 2</label>
          <input type="text" id="consecutive-player2" name="player2" value="{{content.fields.player2}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-score">Score</label>
          <input type="text" id="consecutive-score" name="score" value="{{content.fields.score}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-note">Note</label>
          <textarea id="consecutive-note" name="note" rows="2">{{content.fields.note}}</textarea>
        </div>
        <div class="form-field">
          <label for="consecutive-eventDate">Event date</label>
          <input type="text" id="consecutive-eventDate" name="eventDate" value="{{content.fields.eventDate}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-eventName">Event name</label>
          <input type="text" id="consecutive-eventName" name="eventName" value="{{content.fields.eventName}}" />
        </div>
        <div class="form-field">
          <label for="consecutive-location">Location</label>
          <input type="text" id="consecutive-location" name="location" value="{{content.fields.location}}" />
        </div>
      </fieldset>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Save</button>
      </div>
    </form>

    {{#unless content.isNew}}
    <p><a href="{{content.deleteHref}}" class="btn btn-outline btn-sm">Delete Record</a></p>
    {{/unless}}

    <p><a href="{{content.backHref}}" class="btn btn-outline btn-sm">Back to Consecutive-kicks Records</a></p>
  </section>
</div>
