<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p>Reference {{content.id}}</p>
  </div>
</div>

<div class="wrapper">
  <section>
    <table class="data-table">
      <tbody>
        <tr><th>Date</th><td>{{content.dateDisplay}}</td></tr>
        <tr><th>Type</th><td>{{content.typeLabel}}</td></tr>
        <tr><th>Item</th><td>{{content.descriptor}}</td></tr>
        <tr>
          <th>Amount</th>
          <td>
            {{content.amountDisplay}}
            {{#if content.hasProviderModeBadge}}
              <span class="badge">{{content.providerModeLabel}}</span>
            {{/if}}
          </td>
        </tr>
        <tr><th>Status</th><td>{{content.statusLabel}}</td></tr>
        <tr>
          <th>Member</th>
          <td>
            {{#if content.memberHref}}
              <a href="{{content.memberHref}}">{{content.memberSlug}}</a>
            {{else}}
              <span class="text-muted">none</span>
            {{/if}}
          </td>
        </tr>
        {{#if content.hasEvent}}
          <tr>
            <th>Event</th>
            <td><a href="{{content.eventHref}}">{{content.eventTitle}}</a></td>
          </tr>
        {{/if}}
        <tr><th>Payment Intent</th><td>{{content.stripePaymentIntentId}}</td></tr>
        <tr><th>Checkout session</th><td>{{content.stripeCheckoutSessionId}}</td></tr>
        <tr><th>Subscription</th><td>{{content.stripeSubscriptionId}}</td></tr>
      </tbody>
    </table>

    {{#if content.hasMoneyHistory}}
      <h2 class="section-heading mt-8">Money Returned or Contested</h2>
      {{#if content.amountIsNotNet}}
        <p class="form-notice" role="status">
          The amount above is what was originally charged. Some of it came back or is being
          contested, so it is not what the organization kept.
        </p>
      {{/if}}
      <table class="data-table">
        <thead>
          <tr>
            <th>When</th>
            <th>What happened</th>
            <th>Amount</th>
          </tr>
        </thead>
        <tbody>
          {{#each content.moneyHistory}}
            <tr>
              <td>{{this.whenDisplay}}</td>
              <td>
                {{this.label}}
                {{#if this.detail}}<br><span class="text-muted fs-sm">{{this.detail}}</span>{{/if}}
              </td>
              <td>{{#if this.amountDisplay}}{{this.amountDisplay}}{{else}}<span class="text-muted">--</span>{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      <p class="text-muted fs-sm">
        A partial refund, a dispute and a rejected payout never change the payment record itself,
        because its status only ever moves forward and only a full refund is an end state. This is
        where that history lives.
      </p>
    {{/if}}

    {{#if content.hasDonationNote}}
      <h2 class="section-heading mt-8">Donor Note</h2>
      <p class="card">{{content.donationNote}}</p>
      <p class="text-muted fs-sm">
        Shown so a discrepancy can be investigated with the donor's own words in view. It is a
        record of what they wrote and is not editable from any admin screen.
      </p>
    {{/if}}

    <p class="mt-6">
      <a href="{{content.backHref}}" class="btn btn-outline">Back to All Payments</a>
    </p>
  </section>
</div>
