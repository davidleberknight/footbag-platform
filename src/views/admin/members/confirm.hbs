<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  <section>
    {{#if content.caution}}
      <p class="notice notice-warn" role="alert">{{content.caution}}</p>
    {{/if}}
    <div class="card mb-6">
      <p class="m-0 fw-500">{{content.displayName}} &middot; {{content.slugLabel}} &middot; {{content.memberId}}</p>
      {{#if content.previewImage}}
        <span class="avatar-preview-frame mt-1">
          <img class="avatar-edit-thumb" src="{{content.previewImage.src}}" alt="{{content.previewImage.alt}}" width="80" height="80" />
        </span>
      {{/if}}
      {{#if content.hasChanges}}
        <dl class="trick-structural-facts-list mt-1">
          {{#each content.changes}}
            <dt>{{label}}</dt><dd>{{before}} &rarr; {{after}}</dd>
          {{/each}}
        </dl>
      {{else}}
        <p class="m-0 mt-1">{{content.noChangeMessage}}</p>
      {{/if}}
      {{#if content.reason}}
        <p class="m-0 mt-1 text-muted">Reason: {{content.reason}}</p>
      {{/if}}
    </div>

    <p>{{content.summary}}</p>

    <form method="POST" action="{{content.confirmAction}}">
      {{#each content.hiddenFields}}
        <input type="hidden" name="{{name}}" value="{{value}}" />
      {{/each}}
      <button type="submit" class="btn btn-primary">{{content.confirmLabel}}</button>
    </form>

    <p class="mt-4"><a href="{{content.cancelHref}}">Cancel</a></p>
  </section>
</div>
