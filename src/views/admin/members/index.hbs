<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  {{> outcome-notice text=content.errorMessage tone='no'}}

  <section>
    <div class="section-heading"><h2>Find a Member</h2></div>
    <div class="search-box-section">
      <form method="GET" action="/admin/members" class="search-box-form" role="search">
        <input type="text" name="q" maxlength="200"
               placeholder="Name or login email"
               value="{{content.query}}"
               aria-label="Find a member by name or login email"
               class="search-box-input" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    </div>

    {{#if content.hasQuery}}
      <div id="member-accounts">
        <h3>Member Accounts</h3>
        <p>{{content.resultSummary}}</p>
        {{#if content.hasResults}}
          <div class="search-box-results">
            {{#each content.results}}
              <div class="search-box-result">
                <a href="{{recordHref}}">{{displayName}}</a>
                {{#each facts}}<span class="text-muted">{{this}}</span>{{/each}}
                {{#each badges}}<span class="badge badge-tier">{{this}}</span>{{/each}}
              </div>
            {{/each}}
          </div>
        {{/if}}
      </div>

      {{#with content.legacyAccounts}}
      <div id="old-accounts" class="mt-6">
        <h3>Old Footbag.org Accounts</h3>
        <p>{{summary}}</p>
        {{#if hasResults}}
          <div class="search-box-results">
            {{#each results}}
              <div class="search-box-result">
                <span class="fw-600">{{name}}</span>
                {{#each facts}}<span class="text-muted">{{this}}</span>{{/each}}
                {{#if holderName}}
                  <span>Held by {{#if holderHref}}<a href="{{siteHref holderHref}}">{{holderName}}</a>{{else}}{{holderName}}{{/if}}</span>
                {{else}}
                  <span class="badge">Not claimed</span>
                {{/if}}
              </div>
            {{/each}}
          </div>
        {{/if}}
      </div>
      {{/with}}

      {{#with content.historicalRecords}}
      <div id="historical-records" class="mt-6">
        <h3>Historical Records</h3>
        <p>{{summary}}</p>
        {{#if hasResults}}
          <div class="search-box-results">
            {{#each results}}
              <div class="search-box-result">
                <a href="{{siteHref recordHref}}">{{name}}</a>
                {{#each facts}}<span class="text-muted">{{this}}</span>{{/each}}
                {{#if isDeceased}}<span class="badge">Deceased</span>{{/if}}
                {{#if holderName}}
                  <span>Held by {{#if holderHref}}<a href="{{siteHref holderHref}}">{{holderName}}</a>{{else}}{{holderName}}{{/if}}</span>
                {{/if}}
                <a href="{{siteHref publicHref}}">Public Page</a>
              </div>
            {{/each}}
          </div>
        {{/if}}
      </div>
      {{/with}}
    {{else}}
      <p>{{content.resultSummary}}</p>
    {{/if}}
  </section>

  <p class="mt-4"><a href="/admin">Back to the admin dashboard</a></p>
</div>
