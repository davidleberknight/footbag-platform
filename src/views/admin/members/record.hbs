<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  {{> outcome-notice text=page.notice tone=page.noticeTone}}
  {{> outcome-notice text=content.errorMessage tone='no'}}

  <div class="event-meta-row">
    {{#each content.identifyingFacts}}<span>{{this}}</span>{{/each}}
    {{#each content.stateLabels}}<span class="badge badge-tier">{{this}}</span>{{/each}}
  </div>

  {{#if content.isSystemAccount}}
    <p class="fs-sm">This is the platform's own account. Its display name is the uploader attribution shown on curated media, and it is the one account allowed to carry a reserved site word in its name.</p>
  {{/if}}

  {{#if content.profileHref}}
    <p><a href="{{content.profileHref}}">View the public profile</a></p>
  {{/if}}

  <section>
    <div class="section-heading"><h2>Identity</h2></div>
    <dl class="trick-structural-facts-list">
      {{#each content.identity}}
        <dt>{{label}}</dt><dd>{{value}}</dd>
      {{/each}}
    </dl>
  </section>

  <section>
    <div class="section-heading"><h2>Membership Standing</h2></div>
    <dl class="trick-structural-facts-list">
      {{#each content.standing}}
        <dt>{{label}}</dt><dd>{{value}}</dd>
      {{/each}}
    </dl>
  </section>

  <section>
    <div class="section-heading"><h2>Account State</h2></div>
    <dl class="trick-structural-facts-list">
      {{#each content.accountState}}
        <dt>{{label}}</dt><dd>{{value}}</dd>
      {{/each}}
    </dl>
  </section>

  <section>
    <div class="section-heading"><h2>Contact Details</h2></div>
    <p class="fs-sm">These fields are private to the member and to administrators. Members edit them themselves.</p>
    <dl class="trick-structural-facts-list">
      {{#each content.contact}}
        <dt>{{label}}</dt><dd>{{value}}</dd>
      {{/each}}
    </dl>
  </section>

  {{#if content.hasIdentityLinks}}
    <section>
      <div class="section-heading"><h2>Identity Links</h2></div>
      <dl class="trick-structural-facts-list">
        {{#each content.identityLinks}}
          <dt>{{label}}</dt><dd>{{value}}</dd>
        {{/each}}
      </dl>
    </section>
  {{/if}}

  <section>
    <div class="section-heading"><h2>Corrections</h2></div>

    <details class="admin-action-disclosure" {{#if content.openForm.name}}open{{/if}}>
      <summary>Correct the Name</summary>
      <p class="fs-sm">A corrected name is held to every rule a name is held to at registration. The profile URL is left alone, because correcting one is a separate action.</p>
      <form method="POST" action="{{content.nameAction}}" class="form-block">
        <div class="form-field">
          <label for="given_names">Given names</label>
          <input type="text" id="given_names" name="given_names" value="{{content.form.givenNames}}" maxlength="35" />
          {{#if content.fieldErrors.name.given_names}}<p class="form-field-error" role="alert">{{content.fieldErrors.name.given_names}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="family_name">Family name</label>
          <input type="text" id="family_name" name="family_name" value="{{content.form.familyName}}" maxlength="35" required />
          {{#if content.fieldErrors.name.family_name}}<p class="form-field-error" role="alert">{{content.fieldErrors.name.family_name}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="display_name">Display name</label>
          <input type="text" id="display_name" name="display_name" value="{{content.form.displayName}}" maxlength="70" />
          {{#if content.fieldErrors.name.display_name}}<p class="form-field-error" role="alert">{{content.fieldErrors.name.display_name}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="name_reason">Reason (required)</label>
          <input type="text" id="name_reason" name="reason" value="{{content.reasons.name}}" maxlength="500" required />
          {{#if content.fieldErrors.name.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.name.reason}}</p>{{/if}}
        </div>
        <button type="submit" class="btn btn-primary">Review the Name Correction</button>
      </form>
    </details>

    <details class="admin-action-disclosure" {{#if content.openForm.slug}}open{{/if}}>
      <summary>Correct the Profile URL</summary>
      <p class="fs-sm">The member's uploader hashtag moves with them, so their media and galleries keep resolving. The old URL stops working and nothing redirects from it, so any link they have already shared will lead nowhere.</p>
      <form method="POST" action="{{content.slugAction}}" class="form-block">
        <div class="form-field">
          <label for="slug">Profile URL</label>
          <input type="text" id="slug" name="slug" value="{{content.form.slug}}" maxlength="70" required />
          {{#if content.fieldErrors.slug.slug}}<p class="form-field-error" role="alert">{{content.fieldErrors.slug.slug}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="slug_reason">Reason (required)</label>
          <input type="text" id="slug_reason" name="reason" value="{{content.reasons.slug}}" maxlength="500" required />
          {{#if content.fieldErrors.slug.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.slug.reason}}</p>{{/if}}
        </div>
        <button type="submit" class="btn btn-primary">Review the Profile URL Correction</button>
      </form>
    </details>

    <details class="admin-action-disclosure" {{#if content.openForm.tier}}open{{/if}}>
      <summary>Change the Membership Tier</summary>
      <p class="fs-sm">The member is emailed when their membership status changes. Active Player standing is managed separately, and director standing is set on the honour and board page, because it carries a badge and a record of the tier the member returns to.</p>
      <form method="POST" action="{{content.tierAction}}" class="form-block">
        <div class="form-field">
          <label for="tier">Membership tier</label>
          <select id="tier" name="tier" required>
            {{#each content.form.tierOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          {{#if content.fieldErrors.tier.tier}}<p class="form-field-error" role="alert">{{content.fieldErrors.tier.tier}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="tier_reason">Reason (required)</label>
          <input type="text" id="tier_reason" name="reason" value="{{content.reasons.tier}}" maxlength="500" required />
          {{#if content.fieldErrors.tier.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.tier.reason}}</p>{{/if}}
        </div>
        <button type="submit" class="btn btn-primary">Review the Tier Change</button>
      </form>
    </details>

    <details class="admin-action-disclosure" {{#if content.openForm.activePlayer}}open{{/if}}>
      <summary>Correct the Active Player Expiry</summary>
      <p class="fs-sm">Active Player is a Tier 0 standing. Leave the date blank to end the standing, which is how one granted in error is taken back. The member is emailed that their standing was corrected, and told the reason you give.</p>
      <form method="POST" action="{{content.activePlayerAction}}" class="form-block">
        <div class="form-field">
          <label for="expires_on">Runs to the end of this date</label>
          <input type="date" id="expires_on" name="expires_on" value="{{content.form.activePlayerExpiryDate}}" />
          {{#if content.fieldErrors.activePlayer.expires_on}}<p class="form-field-error" role="alert">{{content.fieldErrors.activePlayer.expires_on}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="ap_reason">Reason (required)</label>
          <input type="text" id="ap_reason" name="reason" value="{{content.reasons.activePlayer}}" maxlength="500" required />
          {{#if content.fieldErrors.activePlayer.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.activePlayer.reason}}</p>{{/if}}
        </div>
        <button type="submit" class="btn btn-primary">Review the Expiry Correction</button>
      </form>
    </details>

    {{#if content.canCorrectProfile}}
    <details class="admin-action-disclosure" {{#if content.openForm.profile}}open{{/if}}>
      <summary>Correct the Profile Details</summary>
      <p class="fs-sm">The member's own profile is the ordinary path for these fields. Use this when they cannot: a data bug, a member who has died, or an account whose holder can no longer reach it. Every value passes the same rules their own form applies, and the whole set is written, so leave a field as it stands unless you mean to change it. Their written biography is not shown here, because it is their words.</p>
      <form method="POST" action="{{content.profileAction}}" class="form-block">
        <div class="form-field">
          <label for="p_city">City</label>
          <input type="text" id="p_city" name="city" value="{{content.profileForm.city}}" maxlength="64" />
          {{#if content.fieldErrors.profile.city}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.city}}</p>{{/if}}
        </div>
        {{#> region-picker id="p_region" pickers=content.profileForm placeholder="No state or province" error=content.fieldErrors.profile.region}}
          <label for="p_region">State or province <span class="text-muted">(USA, Canada and Australia only)</span></label>
        {{/region-picker}}
        <div class="form-field">
          <label for="p_country">Country</label>
          <input type="text" id="p_country" name="country" value="{{content.profileForm.country}}" maxlength="64" data-country-picker />
          {{#if content.fieldErrors.profile.country}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.country}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_birth_day">Date of birth: day</label>
          <input type="text" id="p_birth_day" name="birthDay" value="{{content.profileForm.birthDay}}" maxlength="2" inputmode="numeric" />
          {{#if content.fieldErrors.profile.birthDay}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.birthDay}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_birth_month">Date of birth: month</label>
          <input type="text" id="p_birth_month" name="birthMonth" value="{{content.profileForm.birthMonth}}" maxlength="2" inputmode="numeric" />
          {{#if content.fieldErrors.profile.birthMonth}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.birthMonth}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_birth_year">Date of birth: year</label>
          <input type="text" id="p_birth_year" name="birthYear" value="{{content.profileForm.birthYear}}" maxlength="4" inputmode="numeric" />
          {{#if content.fieldErrors.profile.birthYear}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.birthYear}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_gender">Gender</label>
          <select id="p_gender" name="gender">
            {{#each content.profileForm.genderOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          {{#if content.fieldErrors.profile.gender}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.gender}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_phone">Phone</label>
          <input type="text" id="p_phone" name="phone" value="{{content.profileForm.phone}}" maxlength="40" />
          {{#if content.fieldErrors.profile.phone}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.phone}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_whatsapp">WhatsApp</label>
          <input type="text" id="p_whatsapp" name="whatsapp" value="{{content.profileForm.whatsapp}}" maxlength="40" />
          {{#if content.fieldErrors.profile.whatsapp}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.whatsapp}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_first_year">First competition year</label>
          <input type="text" id="p_first_year" name="firstCompetitionYear" value="{{content.profileForm.firstCompetitionYear}}" maxlength="4" inputmode="numeric" />
          {{#if content.fieldErrors.profile.firstCompetitionYear}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.firstCompetitionYear}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_email_vis">Who can see the contact email</label>
          <select id="p_email_vis" name="emailVisibility">
            {{#each content.profileForm.emailVisibilityOptions}}
              <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
            {{/each}}
          </select>
          {{#if content.fieldErrors.profile.emailVisibility}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.emailVisibility}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_phone_vis">Show the phone to members</label>
          <input type="checkbox" id="p_phone_vis" name="phoneVisible" value="1" {{#if content.profileForm.phoneVisible}}checked{{/if}} />
          {{#if content.fieldErrors.profile.phoneVisible}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.phoneVisible}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_whatsapp_vis">Show WhatsApp to members</label>
          <input type="checkbox" id="p_whatsapp_vis" name="whatsappVisible" value="1" {{#if content.profileForm.whatsappVisible}}checked{{/if}} />
          {{#if content.fieldErrors.profile.whatsappVisible}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.whatsappVisible}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_searchable">List in member search</label>
          <input type="checkbox" id="p_searchable" name="searchable" value="1" {{#if content.profileForm.searchable}}checked{{/if}} />
          {{#if content.fieldErrors.profile.searchable}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.searchable}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_show_results">Show competition results</label>
          <input type="checkbox" id="p_show_results" name="showCompetitiveResults" value="1" {{#if content.profileForm.showCompetitiveResults}}checked{{/if}} />
          {{#if content.fieldErrors.profile.showCompetitiveResults}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.showCompetitiveResults}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_show_year">Show the first competition year</label>
          <input type="checkbox" id="p_show_year" name="showFirstCompetitionYear" value="1" {{#if content.profileForm.showFirstCompetitionYear}}checked{{/if}} />
          {{#if content.fieldErrors.profile.showFirstCompetitionYear}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.showFirstCompetitionYear}}</p>{{/if}}
        </div>
        <div class="form-field">
          <label for="p_show_gender">Show gender to members</label>
          <input type="checkbox" id="p_show_gender" name="showGender" value="1" {{#if content.profileForm.showGender}}checked{{/if}} />
          {{#if content.fieldErrors.profile.showGender}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.showGender}}</p>{{/if}}
        </div>
        {{#each content.profileForm.links}}
          <div class="form-field">
            <label for="p_link_label_{{@index}}">Link {{slot}}: what it is called</label>
            <input type="text" id="p_link_label_{{@index}}" name="link_label" value="{{label}}" maxlength="60" />
          </div>
          <div class="form-field">
            <label for="p_link_url_{{@index}}">Link {{slot}}: address</label>
            <input type="text" id="p_link_url_{{@index}}" name="link_url" value="{{url}}" maxlength="300" />
          </div>
        {{/each}}
        <div class="form-field">
          <label for="p_reason">Reason (required)</label>
          <input type="text" id="p_reason" name="reason" value="{{content.reasons.profile}}" maxlength="500" required />
          {{#if content.fieldErrors.profile.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.profile.reason}}</p>{{/if}}
        </div>
        <button type="submit" class="btn btn-primary">Review the Profile Correction</button>
      </form>
    </details>
    {{/if}}

    {{#if content.hasAvatar}}
      <details class="admin-action-disclosure" {{#if content.openForm.avatar}}open{{/if}}>
        <summary>Remove the Profile Picture</summary>
        <p class="fs-sm">The picture comes off the profile and its stored files are deleted. The account, the membership and everything else on the record are untouched, and the member is emailed the reason you give. They can upload another.</p>
        <form method="POST" action="{{content.avatarRemoveAction}}" class="form-block">
          <div class="form-field">
            <label for="avatar_reason">Reason, naming the Community Standard it broke (required)</label>
            <input type="text" id="avatar_reason" name="reason" value="{{content.reasons.avatar}}" maxlength="500" required />
            {{#if content.fieldErrors.avatar.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.avatar.reason}}</p>{{/if}}
          </div>
          <button type="submit" class="btn btn-outline">Review Removing the Picture</button>
        </form>
      </details>
    {{/if}}

    {{#if content.canClearBio}}
      <details class="admin-action-disclosure" {{#if content.openForm.bio}}open{{/if}}>
        <summary>Clear the Biography</summary>
        <p class="fs-sm">The biography is the member's own words, so it is cleared, never rewritten. The text is kept in the audit log, and the member is emailed the reason you give. They can write a new one.</p>
        <form method="POST" action="{{content.bioClearAction}}" class="form-block">
          <div class="form-field">
            <label for="bio_reason">Reason (required)</label>
            <input type="text" id="bio_reason" name="reason" value="{{content.reasons.bio}}" maxlength="500" required />
            {{#if content.fieldErrors.bio.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.bio.reason}}</p>{{/if}}
          </div>
          <button type="submit" class="btn btn-outline">Review Clearing the Biography</button>
        </form>
      </details>
    {{/if}}

    {{#if content.isDeceasedMarked}}
      <details class="admin-action-disclosure">
        <summary>Remove the Deceased Marking</summary>
        <p class="fs-sm">{{content.deceasedGraceNote}}</p>
        <form method="POST" action="{{content.deceasedRevertAction}}" class="form-block">
          <button type="submit" class="btn btn-outline">Review Removing the Marking</button>
        </form>
      </details>
    {{else}}
      <details class="admin-action-disclosure">
        <summary>Mark the Member Deceased</summary>
        <p class="fs-sm">Honours, uploaded media, competition results and club history are all preserved. A linked historical record is marked to match, the member is withdrawn from events that have not happened yet, and the platform sends them nothing.</p>
        <p class="fs-sm">The next screen names the member and asks you to confirm.</p>
        <form method="POST" action="{{content.deceasedMarkAction}}" class="form-block">
          <button type="submit" class="btn btn-outline">Review Marking as Deceased</button>
        </form>
      </details>
    {{/if}}

    {{#if content.canDeleteAccount}}
      <details class="admin-action-disclosure" {{#if content.openForm.delete}}open{{/if}}>
        <summary>Delete the Account</summary>
        <p class="fs-sm">For a registration that breaks the rules, such as a fake name or a bogus location. The member's photos, videos and galleries are deleted at once, they are withdrawn from upcoming events, any recurring donation is cancelled, and they can no longer sign in. The member is emailed the reason you give. Deletion cannot be undone.</p>
        <form method="POST" action="{{content.deleteAccountAction}}" class="form-block">
          <div class="form-field">
            <label for="delete_reason">Reason (required)</label>
            <input type="text" id="delete_reason" name="reason" value="{{content.reasons.delete}}" maxlength="500" required />
            {{#if content.fieldErrors.delete.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.delete.reason}}</p>{{/if}}
          </div>
          <button type="submit" class="btn btn-outline">Review Deleting the Account</button>
        </form>
      </details>
    {{/if}}
  </section>

  <section>
    <div class="section-heading"><h2>Restriction and Board Decisions</h2></div>
    <p class="fs-sm">A restriction stops an abusive member at once while the IFPA board decides under Article X of the bylaws. The board's decision is recorded here once it is made; the board gives the notice and the hearing.</p>

    {{#if content.liftBlockedNote}}<p class="fs-sm">{{content.liftBlockedNote}}</p>{{/if}}

    {{#if content.canRestrict}}
      <details class="admin-action-disclosure" {{#if content.openForm.restrict}}open{{/if}}>
        <summary>Restrict the Account</summary>
        <p class="fs-sm">The member is signed out at once and cannot sign in. Their membership, tier, profile, media and results stay as they are. The member is emailed the reason you give.</p>
        <form method="POST" action="{{content.restrictAction}}" class="form-block">
          <div class="form-field">
            <label for="restrict_reason">Reason (required)</label>
            <input type="text" id="restrict_reason" name="reason" value="{{content.reasons.restrict}}" maxlength="500" required />
            {{#if content.fieldErrors.restrict.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.restrict.reason}}</p>{{/if}}
          </div>
          <button type="submit" class="btn btn-outline">Review Restricting the Account</button>
        </form>
      </details>
    {{/if}}

    {{#if content.canLift}}
      <details class="admin-action-disclosure" {{#if content.openForm.lift}}open{{/if}}>
        <summary>Lift the Restriction</summary>
        <p class="fs-sm">The member can sign in again at once, and is emailed the reason you give.</p>
        <form method="POST" action="{{content.liftAction}}" class="form-block">
          <div class="form-field">
            <label for="lift_reason">Reason (required)</label>
            <input type="text" id="lift_reason" name="reason" value="{{content.reasons.lift}}" maxlength="500" required />
            {{#if content.fieldErrors.lift.reason}}<p class="form-field-error" role="alert">{{content.fieldErrors.lift.reason}}</p>{{/if}}
          </div>
          <button type="submit" class="btn btn-outline">Review Lifting the Restriction</button>
        </form>
      </details>
    {{/if}}

    {{#if content.canRecordDiscipline}}
      <details class="admin-action-disclosure" {{#if content.openForm.discipline}}open{{/if}}>
        <summary>Record the Board's Decision</summary>
        <p class="fs-sm">Only a decision the IFPA board, or a committee or person it authorized, has already made. A suspension or expulsion needs at least 15 days between the notice and the decision, and an expulsion at least 5 days between the hearing and the decision.</p>
        <form method="POST" action="{{content.disciplineAction}}" class="form-block">
          <div class="form-field">
            <label for="d_outcome">Outcome</label>
            <select id="d_outcome" name="outcome" required>
              <option value="">Choose the outcome</option>
              {{#each content.disciplineForm.outcomeOptions}}
                <option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>
              {{/each}}
            </select>
          </div>
          <div class="form-field">
            <label for="d_suspended_until">Suspension ends (suspensions only)</label>
            <input type="date" id="d_suspended_until" name="suspended_until" value="{{content.disciplineForm.suspendedUntil}}" />
          </div>
          <div class="form-field">
            <label for="d_decided_by">Who decided (required)</label>
            <input type="text" id="d_decided_by" name="decided_by" value="{{content.disciplineForm.decidedBy}}" maxlength="200" required />
          </div>
          <div class="form-field">
            <label for="d_notice_date">Date notice was given</label>
            <input type="date" id="d_notice_date" name="notice_date" value="{{content.disciplineForm.noticeDate}}" required />
          </div>
          <div class="form-field">
            <label for="d_hearing_date">Date of the opportunity to be heard</label>
            <input type="date" id="d_hearing_date" name="hearing_date" value="{{content.disciplineForm.hearingDate}}" required />
          </div>
          <div class="form-field">
            <label for="d_decision_date">Decision date</label>
            <input type="date" id="d_decision_date" name="decision_date" value="{{content.disciplineForm.decisionDate}}" required />
          </div>
          <div class="form-field">
            <label for="d_reason">The board's reason (required)</label>
            <input type="text" id="d_reason" name="reason" value="{{content.reasons.discipline}}" maxlength="500" required />
          </div>
          <button type="submit" class="btn btn-outline">Review the Decision</button>
        </form>
      </details>
    {{/if}}

    {{#if content.hasDecisions}}
      {{#each content.decisions}}
        <h3>{{heading}}</h3>
        <dl class="trick-structural-facts-list">
          {{#each facts}}
            <dt>{{label}}</dt><dd>{{value}}</dd>
          {{/each}}
        </dl>
      {{/each}}
    {{else}}
      <p class="fs-sm">No board decision is recorded for this member.</p>
    {{/if}}
  </section>

  <section>
    <div class="section-heading"><h2>Related Administrator Pages</h2></div>
    {{#each content.elsewhereLinks}}
