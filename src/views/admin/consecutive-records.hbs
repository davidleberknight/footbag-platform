<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p class="hero-subtitle">Browse the consecutive-kicks records, grouped by section and division. {{content.totalCount}} row(s).</p>
  </div>
</div>

<div class="wrapper">
  <section>
    <p><a href="/admin/freestyle/consecutive-records/new" class="btn btn-primary btn-sm">New Record</a></p>

    {{#if content.hasRows}}
      {{#each content.sections}}
        <h2 class="section-heading">{{this.section}}</h2>
        {{#each this.divisions}}
          <h3>{{this.division}}</h3>
          <div class="records-table-wrap" tabindex="0" role="region" aria-label="{{this.division}}">
          <table class="data-table">
            <thead>
              <tr><th>Pos</th><th>Players</th><th>Score</th><th></th></tr>
            </thead>
            <tbody>
              {{#each this.rows}}
                <tr>
                  <td>{{this.sortOrder}}</td>
                  <td>{{this.players}}</td>
                  <td>{{this.score}}</td>
                  <td><a href="{{this.editHref}}" class="btn btn-outline btn-sm">Edit</a></td>
                </tr>
              {{/each}}
            </tbody>
          </table>
          </div>
        {{/each}}
      {{/each}}
    {{else}}
      <div class="empty-state"><p>No consecutive-kicks records.</p></div>
    {{/if}}
  </section>
</div>
