<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p class="hero-subtitle">Browse the freestyle world records, including superseded and low-confidence rows the public page hides. {{content.totalCount}} row(s).</p>
  </div>
</div>

<div class="wrapper">
  <section>
    <p><a href="/admin/freestyle/records/new" class="btn btn-primary btn-sm">New Record</a></p>

    <form method="GET" action="/admin/freestyle/records" class="filter-bar">
      <label>
        Search
        <input type="text" name="q" placeholder="Search holder or trick" value="{{content.filters.query}}" />
      </label>
      <label>
        Record type
        <select name="recordType">
          {{#each content.filters.recordTypeOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
      </label>
      <button type="submit" class="btn btn-outline btn-sm">Search</button>
      {{#if content.filters.isFiltered}}
        <a href="/admin/freestyle/records" class="btn btn-outline btn-sm">Clear</a>
      {{/if}}
    </form>

    {{#if content.hasRows}}
      <div class="records-table-wrap mt-2" tabindex="0" role="region" aria-label="Freestyle records">
      <table class="data-table">
        <thead>
          <tr>
            <th>Holder</th>
            <th>Trick</th>
            <th>Value</th>
            <th>Type</th>
            <th>Confidence</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {{#each content.rows}}
            <tr>
              <td>{{this.holderName}}</td>
              <td>{{this.trickName}}</td>
              <td>{{this.value}}</td>
              <td>{{this.recordType}}</td>
              <td>{{this.confidence}}</td>
              <td>{{this.statusLabel}}</td>
              <td><a href="{{this.editHref}}" class="btn btn-outline btn-sm">Edit</a></td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      </div>
    {{else}}
      <div class="empty-state"><p>No freestyle records match your search.</p></div>
    {{/if}}
  </section>
</div>
