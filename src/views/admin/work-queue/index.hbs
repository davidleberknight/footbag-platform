<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  <nav class="filter-bar" aria-label="Show one kind of work">
    {{#each content.kindLinks}}
      <a class="tag-chip" href="{{siteHref href}}"{{#if isActive}} aria-current="page"{{/if}}>{{label}}</a>
    {{/each}}
  </nav>
  <nav class="filter-bar" aria-label="Narrow by area or claim">
    {{#each content.areaLinks}}
      <a class="tag-chip" href="{{siteHref href}}"{{#if isActive}} aria-current="page"{{/if}}>{{label}}</a>
    {{/each}}
    <a class="tag-chip" href="{{siteHref content.unclaimedLink.href}}"{{#if content.unclaimedLink.isActive}} aria-current="page"{{/if}}>{{content.unclaimedLink.label}}</a>
  </nav>
  {{> work-queue-outcomes content}}

  <section>
    <div class="section-heading">
      <h2>{{content.kindLabel}}</h2>
    </div>
    <p>{{content.kindWhat}} {{content.kindWhy}}</p>
    <p class="card-meta">{{content.countLine}}</p>
    {{#each content.rows}}
      <div class="admin-queue-row">
        <span class="admin-queue-row-label">{{taskTypeLabel}}</span>
        <span class="badge badge-muted">{{areaLabel}}</span>
        <span class="admin-queue-row-meta">{{waitingLabel}} &middot; {{claimLabel}}</span>
        {{#if canClaim}}
          <form method="POST" action="{{claimAction}}">
            <input type="hidden" name="kind" value="{{@root.content.state.kind}}" /><input type="hidden" name="topic" value="{{@root.content.state.topic}}" /><input type="hidden" name="unclaimed" value="{{@root.content.state.unclaimed}}" /><input type="hidden" name="page" value="{{@root.content.state.page}}" /><input type="hidden" name="from" value="list" />
            <button type="submit" class="btn btn-outline btn-sm">Claim</button>
          </form>
        {{/if}}
        <a href="{{siteHref openHref}}">Open</a>
      </div>
    {{/each}}
    {{#if content.isEmpty}}
      <p class="text-muted">Nothing open.</p>
    {{/if}}
    {{> _pager pagination=content.pagination}}
  </section>

  <section>
    <p><a class="action-link" href="{{siteHref content.parkedHref}}">Parked Items</a></p>
    <p><a class="action-link" href="{{siteHref content.areasHref}}">Area Owners</a></p>
  </section>
</div>
