<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  {{> work-queue-outcomes content}}

  <dl class="club-detail-meta">
    {{#each content.facts}}
      <dt>{{label}}</dt>
      <dd>{{value}}</dd>
    {{/each}}
  </dl>

  {{#with content.item}}
  <div class="work-queue-item">
  <section>
    {{#if @root.content.brief}}
      <p>{{@root.content.brief.what}}</p>
      <p>{{@root.content.brief.why}}</p>
      <p>{{@root.content.brief.todo}}</p>
    {{/if}}
    {{#if entityDisplayName}}
      <p class="card-meta">
        Concerns {{#if entityHref}}<a href="{{entityHref}}">{{entityDisplayName}}</a>{{else}}{{entityDisplayName}}{{/if}}
        {{#if memberRecordHref}}
          &middot; <a href="{{memberRecordHref}}">Member record</a>
        {{/if}}
      </p>
    {{/if}}
    {{#if entityReference}}
      {{#if entityReference.href}}
        <p class="card-meta">{{entityReference.label}} <a href="{{entityReference.href}}">{{entityReference.id}}</a></p>
      {{else}}
        <p class="card-meta">{{entityReference.label}} {{entityReference.id}}</p>
      {{/if}}
    {{/if}}
  </section>

  <section>
    {{#if evidence.reasonText}}
      <p>{{evidence.reasonText}}</p>
    {{/if}}
    {{#if evidence.detailText}}
      <p class="text-secondary">{{evidence.detailText}}</p>
    {{/if}}

    {{! A held announcement is shown exactly as the member wrote it, as plain
        text: the administrator approves those words or sends them back. }}
    {{#if evidence.isAnnouncement}}
      <h3>{{evidence.announcement.subject}}</h3>
      {{#each evidence.announcement.bodyParagraphs}}
        <p>{{this}}</p>
      {{/each}}
    {{/if}}

    {{! A sanction request, every answer the organizer gave and the
        divisions the event offers, so the decision is made here. }}
    {{#if evidence.isSanctionRequest}}
      {{#with evidence.sanctionRequest}}
        <h3>{{eventTitle}}</h3>
        {{#if divisionFlag}}<p class="badge">{{divisionFlag}}</p>{{/if}}
        <dl class="club-detail-meta">
          {{#each facts}}
            <dt>{{label}}</dt>
            <dd>{{value}}</dd>
          {{/each}}
        </dl>
        <h3>Where It Differs From the Official Rules</h3>
        {{#if deviations}}<p>{{deviations}}</p>{{else}}<p>The organizer says it uses the official formats and judging systems.</p>{{/if}}
        <h3>Competitions</h3>
        {{#if hasDivisions}}
          <ul>
            {{#each divisions}}
              <li>{{name}}{{#if prizeLabel}} <span class="badge">{{prizeLabel}}</span>{{/if}}<br><span class="card-meta">{{parts}}</span></li>
            {{/each}}
          </ul>
        {{else}}
          <p>The event has no competitions yet.</p>
        {{/if}}
        <h3>Organizers</h3>
        <ul>
          {{#each organizers}}
            <li><a href="{{siteHref profileHref}}">{{name}}</a>{{#if email}} &middot; {{email}}{{/if}}
              {{#if history.length}}
                <ul>
                  {{#each history}}
                    <li>{{title}}, {{dates}} <span class="badge">{{statusLabel}}</span>{{#if sanctionedLabel}} <span class="badge">{{sanctionedLabel}}</span>{{/if}}</li>
                  {{/each}}
                </ul>
              {{else}}
                <br><span class="card-meta">No other events organized on footbag.org.</span>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{/with}}
    {{/if}}

    {{! The evidence the decision is actually made on. Without it an
        administrator adjudicates on what the member typed and nothing
        else, then types an identifier found somewhere off this page. }}
    {{#if evidence.isLinkHelp}}
      {{#if evidence.linkHelp}}
        {{#if evidence.linkHelp.isDispute}}<p class="badge">Conflict dispute</p>{{/if}}
        <p>{{evidence.linkHelp.statement}}</p>
      {{/if}}
      {{#if evidence.claimEvidence.attempts.length}}
        <h3>What This Member Has Already Tried</h3>
        {{#if evidence.claimEvidence.memberBirthDate}}
          <p class="card-meta claim-evidence-revealed">Date of birth on this account: <strong>{{evidence.claimEvidence.memberBirthDate}}</strong></p>
        {{/if}}
        <ul class="claim-evidence-list">
          {{#each evidence.claimEvidence.attempts}}
            <li class="claim-evidence-item">
              <p class="claim-evidence-outcome">
                {{this.outcomeLabel}}{{#if this.targetLabel}}: {{this.targetLabel}}{{/if}}{{#if this.dataOriginLabel}} <span class="badge">{{this.dataOriginLabel}}</span>{{/if}}
              </p>
              <p class="card-meta">{{this.whenDisplay}}</p>
              <p class="fs-sm{{#if this.isContradicted}} claim-evidence-contradicted{{/if}}">{{this.comparisonLabel}}</p>
              {{#if this.recordBirthDate}}
                <p class="card-meta claim-evidence-revealed">Date on that record: <strong>{{this.recordBirthDate}}</strong></p>
              {{/if}}
              {{#if this.evidenceLabel}}
                <p class="fs-sm">{{this.evidenceLabel}}</p>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="fs-sm">This member has not attempted a claim, so there is no evidence on file yet.</p>
      {{/if}}

      {{! What the platform can already see for this member, so the
          administrator judges the request on the records the matching reaches
          before choosing one on the approve form. }}
      <h3>What the Platform Can See for Them</h3>
      {{#if evidence.candidates.hasLegacyAccounts}}
        <p class="fs-sm">Old accounts their evidence reaches:</p>
        <ul class="claim-evidence-list">
          {{#each evidence.candidates.legacyAccounts}}
            <li class="claim-evidence-item">
              <p class="claim-evidence-outcome">{{this.displayName}}</p>
              <p class="card-meta">{{#each this.facts}}{{this}} &middot; {{/each}}</p>
              {{#if this.birthDate}}
                <p class="card-meta claim-evidence-revealed">Date of birth on that account: <strong>{{this.birthDate}}</strong></p>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{/if}}
      {{#if evidence.candidates.hasHistoricalPersons}}
        <p class="fs-sm">Competition records with no old account behind them that their evidence reaches:</p>
        <ul>
          {{#each evidence.candidates.historicalPersons}}
            <li>{{this.personName}} ({{this.personId}}){{#if this.matchNote}} &middot; {{this.matchNote}}{{/if}}</li>
          {{/each}}
        </ul>
      {{/if}}
      {{#each evidence.candidates.ambiguousNotes}}
        <p class="fs-sm">{{this}}</p>
      {{/each}}
      {{#unless evidence.candidates.hasAny}}
        <p class="fs-sm">Nothing on file reaches an old account or a competition record for this member.</p>
      {{/unless}}
      {{#if evidence.linkHelp.isDispute}}
        {{#if evidence.linkHelp.hasDisputedRecords}}
          <p class="fs-sm">Records this dispute named when it was filed:</p>
          <ul>
            {{#each evidence.linkHelp.disputedRecords}}
              <li>{{this.label}}</li>
            {{/each}}
          </ul>
        {{else}}
          <p class="fs-sm">This dispute named no records, so no revert can be applied to it.</p>
        {{/if}}
      {{/if}}
    {{/if}}

    {{#if canAskMember}}
      {{#each memberQuestions}}
        <div class="queue-member-question">
          <p class="card-meta">
            Asked {{this.sentAtDisplay}}: <strong>{{this.subject}}</strong> ({{this.answerKindLabel}})
          </p>
          {{! The question itself. Without it an administrator reads an
              answer without being able to see what was asked, which is
              unusable once more than a day has passed or the colleague who
              asked is not the one reading. }}
          {{#if this.body}}<p class="queue-question-body">{{this.body}}</p>{{/if}}
          {{#if this.isAnswered}}
            <p class="card-meta">Answered {{this.answeredAtDisplay}}: <strong>{{this.outcomeLabel}}</strong></p>
            {{#if this.note}}<p>{{this.note}}</p>{{/if}}
          {{/if}}
        </div>
      {{/each}}
    {{/if}}
  </section>

  <section>
    <p class="card-meta">Held by: {{@root.content.heldBy}}</p>
    {{#if @root.content.parked}}
      <p>Parked {{@root.content.parked.parkedAtDisplay}}{{#if @root.content.parked.parkedByName}} by {{@root.content.parked.parkedByName}}{{/if}}{{#if @root.content.parked.parkReason}}: {{@root.content.parked.parkReason}}{{/if}}</p>
      <form method="POST" action="{{@root.content.parked.returnAction}}" class="form-block">
        <input type="hidden" name="kind" value="{{@root.content.state.kind}}" /><input type="hidden" name="topic" value="{{@root.content.state.topic}}" /><input type="hidden" name="unclaimed" value="{{@root.content.state.unclaimed}}" /><input type="hidden" name="page" value="{{@root.content.state.page}}" /><input type="hidden" name="from" value="item" />
        <button type="submit" class="btn btn-outline">Return to the Queue</button>
      </form>
    {{else}}
      {{#unless isClaimed}}
        <form method="POST" action="/admin/work-queue/{{id}}/claim" class="form-block">
          <input type="hidden" name="kind" value="{{@root.content.state.kind}}" /><input type="hidden" name="topic" value="{{@root.content.state.topic}}" /><input type="hidden" name="unclaimed" value="{{@root.content.state.unclaimed}}" /><input type="hidden" name="page" value="{{@root.content.state.page}}" /><input type="hidden" name="from" value="item" />
          <button type="submit" class="btn btn-outline">Claim</button>
        </form>
      {{/unless}}

      {{#if askBlockedReason}}
        <p class="fs-sm">{{askBlockedReason}}</p>
      {{/if}}
      {{#if canAskMember}}
        {{#if awaitingMemberSince}}
          <p class="fs-sm">Waiting on the member since {{awaitingMemberSince}}. Nothing to do here until they answer.</p>
        {{else}}
          <details class="queue-ask-member" {{#if askOpen}}open{{/if}}>
            <summary>Ask the member</summary>
            <form method="POST" action="/admin/work-queue/{{id}}/ask-member" class="form-block">
              <input type="hidden" name="kind" value="{{@root.content.state.kind}}" /><input type="hidden" name="topic" value="{{@root.content.state.topic}}" /><input type="hidden" name="unclaimed" value="{{@root.content.state.unclaimed}}" /><input type="hidden" name="page" value="{{@root.content.state.page}}" /><input type="hidden" name="from" value="item" />
              <div class="form-field">
                <label for="ask_kind_{{id}}">What do you need back?</label>
                <select id="ask_kind_{{id}}" name="expectedAnswerKind" required>
                  {{#each @root.content.answerKindOptions}}
                    <option value="{{this.value}}" {{#if (eq this.value ../askPrefill.answerKind)}}selected{{/if}}>{{this.label}}</option>
                  {{/each}}
                </select>
              </div>
              <div class="form-field">
                <label for="ask_subject_{{id}}">Subject</label>
                <input type="text" id="ask_subject_{{id}}" name="subject" maxlength="200" required value="{{askPrefill.subject}}" />
              </div>
              <div class="form-field">
                <label for="ask_body_{{id}}">Your question</label>
                <textarea id="ask_body_{{id}}" name="body" rows="4" maxlength="2000" required>{{askPrefill.body}}</textarea>
                <small class="form-hint">The member reads this after signing in. It is never sent by email, so it may refer to private details. They get a message telling them to log in and nothing more.</small>
              </div>
              <button type="submit" class="btn btn-outline">Send Question</button>
            </form>
          </details>
        {{/if}}
      {{/if}}

      {{! One loop over what this type declares an administrator may do, so
          every item page reads and behaves the same way. }}
      {{#each actions}}
        {{#if this.isLink}}
          <p><a href="{{this.href}}" class="{{this.buttonClass}}">{{this.label}}</a></p>
        {{else}}
          <form method="POST" action="{{this.actionPath}}" id="{{this.formId}}" class="form-block">
            <input type="hidden" name="kind" value="{{@root.content.state.kind}}" /><input type="hidden" name="topic" value="{{@root.content.state.topic}}" /><input type="hidden" name="unclaimed" value="{{@root.content.state.unclaimed}}" /><input type="hidden" name="page" value="{{@root.content.state.page}}" /><input type="hidden" name="from" value="item" />
            {{#if this.targetPickers}}
              {{> member-picker this.targetPickers.accountPicker}}
              {{> member-picker this.targetPickers.recordPicker}}
            {{/if}}
            {{#if this.disputeChoices}}
              <fieldset class="form-fieldset">
                <legend>Disputed record</legend>
                {{#each this.disputeChoices}}
                  <div class="form-field"><label><input type="radio" id="{{this.inputId}}" name="disputed_record" value="{{this.value}}" required /> {{this.label}}</label></div>
                {{/each}}
              </fieldset>
            {{/if}}
            {{#if this.hasDecisions}}
              <div class="form-field">
                <label for="{{this.decisionInputId}}">Decision</label>
                <select id="{{this.decisionInputId}}" name="decision_label" required>
                  <option value="" disabled selected>Choose a decision&hellip;</option>
                  {{#each this.decisions}}
                    <option value="{{this.value}}">{{this.label}}</option>
                  {{/each}}
                </select>
              </div>
            {{/if}}
            {{#each this.fields}}
              <div class="form-field">
                {{#if this.isCheckbox}}
                  <input type="hidden" name="{{this.name}}" value="0" />
                  <label><input type="checkbox" id="{{this.inputId}}" name="{{this.name}}" value="1" /> {{this.label}}</label>
                {{else}}
                  <label for="{{this.inputId}}">{{this.label}}</label>
                  {{#if this.isTextarea}}
                    <textarea id="{{this.inputId}}" name="{{this.name}}" rows="2" maxlength="{{this.maxLength}}" {{#if this.required}}required{{/if}}></textarea>
                  {{else}}
                    <input type="text" id="{{this.inputId}}" name="{{this.name}}" maxlength="{{this.maxLength}}" {{#if this.required}}required{{/if}} />
                  {{/if}}
                {{/if}}
              </div>
            {{/each}}
            {{#if this.note}}
              <div class="form-field">
                <label for="{{this.note.inputId}}">{{this.note.label}}</label>
                <textarea id="{{this.note.inputId}}" name="{{this.note.name}}" rows="2" maxlength="{{this.note.maxLength}}" {{#if this.note.required}}required{{/if}} placeholder="{{this.note.placeholder}}"></textarea>
              </div>
            {{/if}}
            {{#if this.hint}}<p class="fs-sm">{{this.hint}}</p>{{/if}}
            <button type="submit" class="{{this.buttonClass}}">{{this.label}}</button>
          </form>
        {{/if}}
      {{/each}}
    {{/if}}
  </section>
  </div>
  {{/with}}
  <script src="{{{asset 'js/member-picker-enter.js'}}}" defer></script>

  {{> back-link}}
</div>
