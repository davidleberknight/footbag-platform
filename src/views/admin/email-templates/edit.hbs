<div class="hero hero-sm">
  <div>
    <h1>Edit Email Template</h1>
    <p class="text-muted">Editing <code>{{content.templateKey}}</code>. Plain text only; merge fields are filled at send time.</p>
  </div>
</div>

<div class="wrapper">
  <section>
    {{#if content.saved}}
    <p class="form-success-banner" role="status">Saved. The next send of this email uses the new wording.</p>
    {{/if}}
    {{#if content.hasErrors}}
    <div class="form-error-banner" role="alert">
      {{#each content.errorList}}<p>{{this}}</p>{{/each}}
    </div>
    {{/if}}

    {{#if content.hasMergeFields}}
    <p class="text-muted">Merge fields this template must use: {{#each content.mergeFieldList}}<code>{{this}}</code> {{/each}}</p>
    {{else}}
    <p class="text-muted">This template has no merge fields; the message is fixed text.</p>
    {{/if}}

    <form method="POST" action="{{content.formAction}}" class="form-block">
      <fieldset class="form-fieldset">
        <div class="form-field">
          <label for="template-subject">Subject</label>
          <input type="text" id="template-subject" name="subjectTemplate" value="{{content.fields.subjectTemplate}}" />
        </div>
        <div class="form-field">
          <label for="template-body">Body</label>
          <textarea id="template-body" name="bodyTemplate" rows="14">{{content.fields.bodyTemplate}}</textarea>
        </div>
        <div class="form-field">
          <label for="template-classification">Classification</label>
          <select id="template-classification" name="piiClassification">
            {{#each content.classificationOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-field">
          <label><input type="checkbox" name="isEnabled" value="1" {{#if content.fields.isEnabled}}checked{{/if}} /> Enabled</label>
          {{#if content.isRestricted}}
          <p class="form-field-warning">This template carries a one-time credential link. Disabling it stops the platform from sending it at all, which breaks the account flow that depends on it.</p>
          {{else}}
          <small class="form-hint">Disabling suppresses this email type entirely; the triggering action still completes.</small>
          {{/if}}
        </div>
      </fieldset>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>

    <p><a href="{{content.backHref}}" class="btn btn-outline">Back to Templates</a></p>
  </section>
</div>
