<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  {{> outcome-notice text=content.errorMessage tone='no'}}

  <section>
    <div class="section-heading"><h2>Find a Club</h2></div>
    <div class="search-box-section">
      <form method="GET" action="/admin/clubs" class="search-box-form" role="search">
        <input type="text" name="q" maxlength="200"
               placeholder="Club id, hashtag, or part of a name or city"
               value="{{content.query}}"
               aria-label="Find a club by id, hashtag, name, or city"
               class="search-box-input" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    </div>

    {{#if content.hasQuery}}
      <p>{{content.resultSummary}}</p>
      {{#if content.hasResults}}
        <div class="search-box-results">
          {{#each content.results}}
            <div class="search-box-result">
              <a href="{{recordHref}}">{{name}}</a>
              {{#each facts}}<span class="text-muted">{{this}}</span>{{/each}}
              {{#each badges}}<span class="badge badge-tier">{{this}}</span>{{/each}}
            </div>
          {{/each}}
        </div>
      {{/if}}
    {{else}}
      <p>{{content.resultSummary}}</p>
    {{/if}}
  </section>

  <p class="mt-4"><a href="/admin">Back to the admin dashboard</a></p>
</div>
