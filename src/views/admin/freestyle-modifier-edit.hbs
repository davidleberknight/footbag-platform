{{! /admin/freestyle/modifiers/:slug/edit: one modifier's fields; a change to its ADD goes
    through the confirm step before it saves }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  <section>
    {{> outcome-notice text=content.error tone='no'}}

    <form method="POST" action="{{content.formAction}}" class="form-block">
      <div class="form-field">
        <label for="modifier-name">Name</label>
        <input type="text" id="modifier-name" name="modifierName" value="{{content.submitted.modifierName}}" />
        {{#if content.fieldErrors.modifierName}}<p class="form-field-error" role="alert">{{content.fieldErrors.modifierName}}</p>{{/if}}
      </div>
      <div class="form-field">
        <label for="modifier-add">ADD</label>
        <input type="text" id="modifier-add" name="addBonus" inputmode="numeric" value="{{content.submitted.addBonus}}" />
        {{#if content.fieldErrors.addBonus}}<p class="form-field-error" role="alert">{{content.fieldErrors.addBonus}}</p>{{/if}}
      </div>
      <div class="form-field">
        <label for="modifier-type">Type</label>
        <select id="modifier-type" name="modifierType">
          {{#each content.typeOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{#if content.fieldErrors.modifierType}}<p class="form-field-error" role="alert">{{content.fieldErrors.modifierType}}</p>{{/if}}
      </div>
      <div class="form-field">
        <label for="modifier-notes">Notes (optional)</label>
        <textarea id="modifier-notes" name="notes" rows="3">{{content.submitted.notes}}</textarea>
        {{#if content.fieldErrors.notes}}<p class="form-field-error" role="alert">{{content.fieldErrors.notes}}</p>{{/if}}
      </div>
      <div class="form-field">
        <label for="modifier-beginnerNote">Beginner note (optional)</label>
        <input type="text" id="modifier-beginnerNote" name="beginnerNote" value="{{content.submitted.beginnerNote}}" aria-describedby="modifier-beginnerNote-hint" />
        {{#if content.fieldErrors.beginnerNote}}<p class="form-field-error" role="alert">{{content.fieldErrors.beginnerNote}}</p>{{/if}}
        <small class="form-hint" id="modifier-beginnerNote-hint">One plain sentence, shown beside this modifier on every trick page that uses it.</small>
      </div>
      <div class="form-field">
        <label for="modifier-browseGroup">Browse group</label>
        <select id="modifier-browseGroup" name="browseGroup" aria-describedby="modifier-browseGroup-hint">
          {{#each content.browseGroupOptions}}
            <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        <small class="form-hint" id="modifier-browseGroup-hint">Where the trick dictionary's browse-by-modifier view lists this modifier. A modifier in the set and uptime group is listed in the set view instead.</small>
      </div>
      <div class="form-field">
        <label for="modifier-browseOrder">Browse position (optional)</label>
        <input type="text" id="modifier-browseOrder" name="browseOrder" inputmode="numeric" value="{{content.submitted.browseOrder}}" aria-describedby="modifier-browseOrder-hint" />
        <small class="form-hint" id="modifier-browseOrder-hint">A whole number; lower comes first within its group. Leave it empty to list the modifier after the positioned ones.</small>
      </div>
      <div class="form-field">
        <label><input type="checkbox" name="browseFullSection" value="1" {{#if content.browseFullSectionChecked}}checked{{/if}} /> Give it a full browse section of its own</label>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Save Modifier</button>
        <a href="{{content.cancelHref}}" class="btn btn-outline btn-sm">Cancel</a>
      </div>
    </form>
  </section>
</div>
