<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> outcome-notice text=content.notice.text tone=content.notice.tone}}
  {{> outcome-notice text=content.errorMessage tone='no'}}

  <section>
    <div class="section-heading"><h2>Find a Historical Record</h2></div>
    <p class="fs-sm">A historical record is a competitor from the archive who has no member account. Here you can correct the record's name, country and competition years, and record that the person is recognized as deceased, which stops the platform offering their record for direct claiming. Recording a death leaves their results, honours and name published.</p>
    <div class="search-box-section">
      <form method="GET" action="/admin/historical-records" class="search-box-form" role="search">
        <input type="text" name="q" maxlength="200"
               placeholder="Name, or the exact record id"
               value="{{content.query}}"
               aria-label="Find a historical record by name or record id"
               class="search-box-input" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    </div>

    <p>{{content.resultSummary}}</p>

    {{#each content.results}}
      <div class="card">
        <div class="card-title">{{personName}}
          {{#if isDeceased}}<span class="badge badge-tier">Recorded as deceased</span>{{/if}}
        </div>
        <p class="m-0 text-muted fs-sm">{{#each facts}}{{this}} &middot; {{/each}}</p>
        {{#if isClaimed}}
          <p class="m-0 mt-1 fs-sm">{{claimedNote}}</p>
          <p class="m-0 mt-1"><a href="{{claimedHref}}">Open that member record</a></p>
        {{else}}
          <div class="card-actions">
            <a href="{{correctHref}}" class="btn btn-outline btn-sm">Correct the Record</a>
            {{#if isDeceased}}
              <form method="POST" action="{{revertAction}}">
                <button type="submit" class="btn btn-outline btn-sm">Review Removing the Record</button>
              </form>
            {{else}}
              <form method="POST" action="{{markAction}}">
                <button type="submit" class="btn btn-outline btn-sm">Review Recording as Deceased</button>
              </form>
            {{/if}}
          </div>
        {{/if}}
      </div>
    {{/each}}
  </section>

  <p class="mt-4"><a href="/admin">Back to the admin dashboard</a></p>
</div>
