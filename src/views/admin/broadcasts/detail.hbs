<div class="hero hero-sm">
  <div>
    <h1>{{content.subject}}</h1>
    <p class="text-muted">{{content.audienceLabel}} &middot; {{content.recipientCount}} copies queued &middot; {{content.sentAtDisplay}}</p>
  </div>
</div>

<div class="wrapper">
  <section>
    <div class="section-heading"><h2>The Send</h2></div>
    <table class="data-table">
      <tbody>
        <tr><th>From address</th><td>{{content.fromIdentityDisplay}}</td></tr>
        <tr><th>Audience</th><td>{{content.audienceLabel}}</td></tr>
        <tr><th>Copies queued</th><td>{{content.recipientCount}}</td></tr>
        <tr><th>Sent</th><td>{{content.sentAtDisplay}}</td></tr>
      </tbody>
    </table>
  </section>

  <section>
    <div class="section-heading"><h2>The Message</h2></div>
    <pre class="broadcast-body">{{content.bodyText}}</pre>
  </section>

  <p class="mt-4"><a href="{{content.backHref}}" class="btn btn-outline">Back to Broadcasts</a></p>
</div>
