<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  {{#if content.hasRows}}
  <p class="text-muted">{{content.resultSummary}}</p>

  <table class="data-table">
    <thead>
      <tr>
        <th>Subject</th>
        <th>Audience</th>
        <th>Copies queued</th>
        <th>Sent</th>
      </tr>
    </thead>
    <tbody>
      {{#each content.rows}}
      <tr>
        <td><a href="{{detailHref}}">{{subject}}</a></td>
        <td class="fs-sm">{{audienceLabel}}</td>
        <td>{{recipientCount}}</td>
        <td class="fs-sm">{{sentAtDisplay}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  <p>
    {{#if content.prevPageHref}}<a href="{{content.prevPageHref}}" class="btn btn-outline">Previous</a>{{/if}}
    {{#if content.nextPageHref}}<a href="{{content.nextPageHref}}" class="btn btn-outline">Next</a>{{/if}}
  </p>
  {{else}}
  <p>Nothing has been sent yet. A message composed to a mailing list is recorded here.</p>
  {{/if}}
</div>
