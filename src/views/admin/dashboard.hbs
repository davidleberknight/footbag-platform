<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p>What is waiting on an administrator, then everywhere else you can go.</p>
  </div>
</div>

<div class="wrapper admin-dashboard">
  {{#if content.hasNeedsYouNow}}
  <section>
    <div class="section-heading">
      <h2>Needs You Now</h2>
    </div>
    {{#each content.needsYouNow}}
    <a class="admin-queue-row" href="{{this.href}}">
      <span class="admin-queue-row-label">{{this.label}}</span>
      <span class="badge badge-warn">{{this.countLabel}}</span>
      {{#if this.metaLabel}}<span class="admin-queue-row-meta">{{this.metaLabel}}</span>{{/if}}
    </a>
    {{/each}}
  </section>
  {{/if}}

  <section>
    <div class="admin-tile-grid">
      <div class="admin-tile">
        <div class="section-heading">
          <h2>Work Waiting</h2>
        </div>
        {{#each content.workWaiting}}
        <a class="admin-queue-row" href="{{this.href}}">
          <span class="admin-queue-row-label">{{this.label}}</span>
          <span class="badge{{#if this.isZero}} badge-muted{{/if}}">{{this.countLabel}}</span>
          {{#if this.metaLabel}}<span class="admin-queue-row-meta">{{this.metaLabel}}</span>{{/if}}
        </a>
        {{/each}}
      </div>

      <div class="admin-tile">
        <div class="section-heading">
          <h2>Claimed by You</h2>
        </div>
        <a class="admin-queue-row" href="{{content.ownWork.href}}">
          <span class="admin-queue-row-label">Yours</span>
          <span class="badge{{#if content.ownWork.isZero}} badge-muted{{/if}}">{{content.ownWork.countLabel}}</span>
        </a>
        <p class="admin-tile-note">{{content.ownWork.detail}}</p>
      </div>

      <div class="admin-tile">
        <div class="section-heading">
          <h2>System Health</h2>
          <span class="badge{{#if content.systemStatus.isOk}} badge-muted{{else}} badge-warn{{/if}}">{{content.systemStatus.statusLabel}}</span>
        </div>
        {{#each content.systemStatus.notes}}
        <p class="admin-tile-note">{{this}}</p>
        {{/each}}
        {{#if content.systemStatus.hasFacts}}
        <div class="event-meta-row">
          {{#each content.systemStatus.facts}}
          <span><strong>{{this.label}}:</strong> {{this.value}}</span>
          {{/each}}
        </div>
        {{/if}}
        <p class="card-meta">
          {{#each content.systemStatus.links}}
          <a href="{{this.href}}">{{this.label}}</a>
          {{/each}}
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="section-heading">
      <h2>Admin Tools</h2>
    </div>
    <div class="admin-goto-grid">
      {{#each content.toolGroups}}
      <div class="admin-goto-group">
        <h3>{{this.title}}</h3>
        <ul>
          {{#each this.links}}
          <li><a href="{{this.href}}">{{this.label}}</a></li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </section>
</div>
