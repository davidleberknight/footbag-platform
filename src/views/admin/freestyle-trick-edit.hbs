<div class="hero hero-sm">
  <div>
    <h1>{{content.fields.canonicalName}}</h1>
    <p class="hero-subtitle">Editing freestyle trick <code>{{content.slug}}</code>.</p>
  </div>
</div>

<div class="wrapper">
  {{> admin-instructions}}
  <section>
    {{#if content.published}}
    {{> outcome-notice text="Trick published." tone='ok'}}
    {{/if}}
    {{> outcome-notice text=content.outcome.text tone=content.outcome.tone}}
    {{#if content.saved}}
    {{> outcome-notice text="Saved." tone='ok'}}
    {{/if}}
    {{> outcome-notice lines=content.errorList tone='no'}}
    {{#if content.hasBlockingReferences}}
    {{#> outcome-notice tone='no'}}
      <p>{{content.deactivationRefusal}}</p>
      <ul>
        {{#each content.blockingReferences}}
        <li>
          {{#if this.resolveHref}}<a href="{{siteHref this.resolveHref}}">{{this.label}}</a>{{else}}{{this.label}}{{/if}}{{#if this.tricks.length}}:{{/if}}
          {{#each this.tricks}}<a href="{{siteHref this.editHref}}">{{this.name}}</a>{{#unless @last}}, {{/unless}}{{/each}}
        </li>
        {{/each}}
      </ul>
    {{/outcome-notice}}
    {{/if}}

    <form method="POST" action="/admin/freestyle/tricks/{{content.slug}}/edit" class="form-block">
      <fieldset class="form-fieldset">
        <div class="form-field">
          <label for="trick-canonicalName">Canonical name</label>
          <input type="text" id="trick-canonicalName" name="canonicalName" value="{{content.fields.canonicalName}}" />
        </div>
        <div class="form-field">
          <label for="trick-adds">ADD</label>
          <input type="text" id="trick-adds" name="adds" value="{{content.fields.adds}}" />
        </div>
        <div class="form-field">
          <label for="trick-movementNotation">Movement notation</label>
          <textarea id="trick-movementNotation" name="movementNotation" rows="2">{{content.fields.movementNotation}}</textarea>
        </div>
        <div class="form-field">
          <label for="trick-executionNotation">Execution notation</label>
          <textarea id="trick-executionNotation" name="executionNotation" rows="2">{{content.fields.executionNotation}}</textarea>
        </div>
        <div class="form-field">
          <label for="trick-family">Trick family</label>
          <input type="text" id="trick-family" name="family" value="{{content.fields.family}}" />
        </div>
        <div class="form-field">
          <label for="trick-baseTrick">Base trick</label>
          <input type="text" id="trick-baseTrick" name="baseTrick" value="{{content.fields.baseTrick}}" />
        </div>
        <div class="form-field">
          <label for="trick-category">Category</label>
          <select id="trick-category" name="category">
            {{#each content.categoryOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-field">
          <label><input type="checkbox" name="isActive" {{#if content.fields.isActive}}checked{{/if}} /> Active</label>
        </div>
        <div class="form-field">
          <label for="trick-sortOrder">Sort position</label>
          <input type="text" id="trick-sortOrder" name="sortOrder" value="{{content.fields.sortOrder}}" />
        </div>
        <div class="form-field">
          <label for="trick-reviewStatus">Review status</label>
          <select id="trick-reviewStatus" name="reviewStatus">
            {{#each content.reviewStatusOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-field">
          <label for="trick-description">Description</label>
          <textarea id="trick-description" name="description" rows="3">{{content.fields.description}}</textarea>
        </div>
        <div class="form-field">
          <label for="trick-shortDescription">Short description</label>
          <textarea id="trick-shortDescription" name="shortDescription" rows="2">{{content.fields.shortDescription}}</textarea>
        </div>
        <div class="form-field">
          <label for="trick-executionSummary">Execution summary</label>
          <textarea id="trick-executionSummary" name="executionSummary" rows="3">{{content.fields.executionSummary}}</textarea>
        </div>
        <div class="form-field">
          <label for="trick-learningNotes">Learning notes</label>
          <textarea id="trick-learningNotes" name="learningNotes" rows="3">{{content.fields.learningNotes}}</textarea>
        </div>
        <div class="form-field">
          <label for="trick-prerequisiteNotes">Prerequisite notes</label>
          <textarea id="trick-prerequisiteNotes" name="prerequisiteNotes" rows="2">{{content.fields.prerequisiteNotes}}</textarea>
        </div>
        <div class="form-field">
          <label for="trick-pronunciation">Pronunciation</label>
          <input type="text" id="trick-pronunciation" name="pronunciation" value="{{content.fields.pronunciation}}" />
        </div>
        <div class="form-field">
          <label for="trick-operationalNotationSource">Execution-notation source</label>
          <textarea id="trick-operationalNotationSource" name="operationalNotationSource" rows="2">{{content.fields.operationalNotationSource}}</textarea>
        </div>
        <div class="form-field">
          <label for="trick-aboutDerivatives">Derivatives note</label>
          <textarea id="trick-aboutDerivatives" name="aboutDerivatives" rows="2" aria-describedby="trick-aboutDerivatives-hint">{{content.fields.aboutDerivatives}}</textarea>
          <small id="trick-aboutDerivatives-hint" class="form-hint">One line naming the trick's major higher-ADD derivatives, shown in the page's opening.</small>
        </div>
        <div class="form-field">
          <label for="trick-aboutNamingNote">Naming note</label>
          <textarea id="trick-aboutNamingNote" name="aboutNamingNote" rows="2" aria-describedby="trick-aboutNamingNote-hint">{{content.fields.aboutNamingNote}}</textarea>
          <small id="trick-aboutNamingNote-hint" class="form-hint">Why a community name is kept out of the alias line, shown in the page's opening.</small>
        </div>
        <div class="form-field">
          <label for="trick-reversePairBase">Reverse of</label>
          <input type="text" id="trick-reversePairBase" name="reversePairBase" value="{{content.fields.reversePairBase}}" aria-describedby="trick-reversePairBase-hint" />
          <small id="trick-reversePairBase-hint" class="form-hint">The slug of the trick this one reverses. The page then shows the rev(0) formula. Leave empty for none.</small>
        </div>
        <div class="form-field">
          <label for="trick-familyOverride">Public family</label>
          <input type="text" id="trick-familyOverride" name="familyOverride" value="{{content.fields.familyOverride}}" aria-describedby="trick-familyOverride-hint" />
          <small id="trick-familyOverride-hint" class="form-hint">The public family slug the browse and the trick page file this trick under, when it differs from the trick family. Leave empty to use the trick family.</small>
        </div>
        <div class="form-field">
          <label for="trick-trickKind">Kind</label>
          <select id="trick-trickKind" name="trickKind" aria-describedby="trick-trickKind-hint">
            {{#each content.trickKindOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
          <small id="trick-trickKind-hint" class="form-hint">Only a trick is listed in the trick browse.</small>
        </div>
        <div class="form-field">
          <label for="trick-terminalCohort">Lands in</label>
          <input type="text" id="trick-terminalCohort" name="terminalCohort" value="{{content.fields.terminalCohort}}" aria-describedby="trick-terminalCohort-hint" />
          <small id="trick-terminalCohort-hint" class="form-hint">The slug of the terminal trick whose "Tricks that land here" list names this trick. Leave empty for none.</small>
        </div>
        <div class="form-field">
          <label for="trick-terminalCohortPosition">Position in that list</label>
          <input type="text" id="trick-terminalCohortPosition" name="terminalCohortPosition" value="{{content.fields.terminalCohortPosition}}" aria-describedby="trick-terminalCohortPosition-hint" />
          <small id="trick-terminalCohortPosition-hint" class="form-hint">A whole number from 1, set together with the terminal trick.</small>
        </div>
        <div class="form-field">
          <label for="trick-addDerivation">Difficulty breakdown</label>
          <input type="text" id="trick-addDerivation" name="addDerivation" value="{{content.fields.addDerivation}}" aria-describedby="trick-addDerivation-hint" />
          <small id="trick-addDerivation-hint" class="form-hint">The ADD worked out operator by operator, such as quantum(+1) + guay(2). The total shown beside it is the ADD above. Leave empty for none.</small>
        </div>
        <div class="form-field">
          <label for="trick-formulaOperator">Fallback operators</label>
          <input type="text" id="trick-formulaOperator" name="formulaOperator" value="{{content.fields.formulaOperator}}" aria-describedby="trick-formulaOperator-hint" />
          <small id="trick-formulaOperator-hint" class="form-hint">The operators joined by +, such as pixie + symposium. Used only when the trick has no modifier links; names that are not registered modifiers are ignored.</small>
        </div>
        <div class="form-field">
          <label for="trick-expandedNotation">Expanded notation</label>
          <input type="text" id="trick-expandedNotation" name="expandedNotation" value="{{content.fields.expandedNotation}}" aria-describedby="trick-expandedNotation-hint" />
          <small id="trick-expandedNotation-hint" class="form-hint">The execution notation written out in full, shown under it when the execution notation uses a shorthand. Leave empty for none.</small>
        </div>
        <div class="form-field">
          <label for="trick-movementNotationSubtitle">Movement-notation subtitle</label>
          <input type="text" id="trick-movementNotationSubtitle" name="movementNotationSubtitle" value="{{content.fields.movementNotationSubtitle}}" aria-describedby="trick-movementNotationSubtitle-hint" />
          <small id="trick-movementNotationSubtitle-hint" class="form-hint">One line under the movement notation heading. Leave empty for none.</small>
        </div>
        <div class="form-field">
          <label for="trick-executionNotationSubtitle">Execution-notation subtitle</label>
          <input type="text" id="trick-executionNotationSubtitle" name="executionNotationSubtitle" value="{{content.fields.executionNotationSubtitle}}" aria-describedby="trick-executionNotationSubtitle-hint" />
          <small id="trick-executionNotationSubtitle-hint" class="form-hint">One line under the execution notation heading. Leave empty for none.</small>
        </div>
      </fieldset>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Save</button>
      </div>
    </form>

    <h2 class="section-heading" id="trick-aliases">Aliases</h2>
    {{#if content.hasAliasError}}
    {{> outcome-notice text=content.aliasError tone='no'}}
    {{/if}}
    {{#if content.hasAliases}}
    <ul class="freestyle-edit-list">
      {{#each content.aliases}}
      <li>
        <code>{{this.slug}}</code> {{this.text}} <span class="badge">{{this.displayLabel}}</span>
        <form method="POST" action="{{this.updateHref}}" class="form-block">
          <div class="form-field">
            <label for="alias-{{this.slug}}-type">Type</label>
            <select id="alias-{{this.slug}}-type" name="aliasType">
              {{#each this.typeOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
            </select>
          </div>
          <div class="form-field">
            <label><input type="checkbox" name="aliasDisplay" {{#if this.isDisplayed}}checked{{/if}} /> Show beside the trick name</label>
          </div>
          {{! The reason is required only when the two disagree, but the field is
              always rendered: revealing it with script would make the rule
              invisible without JavaScript, and the page must work without it. }}
          <div class="form-field">
            <label for="alias-{{this.slug}}-reason">{{#if this.divergesFromClass}}Why this differs from the class (required){{else}}Why, if you set this against the class{{/if}}</label>
            <textarea id="alias-{{this.slug}}-reason" name="divergenceReason" rows="2" maxlength="500">{{this.divergenceReason}}</textarea>
          </div>
          {{! Provenance is a separate fact from the publication judgement above:
              where the alias came from, not whether a reader should see it. The
              two shared one field until an edit to either erased the other. }}
          <div class="form-field">
            <label for="alias-{{this.slug}}-source">Where this alias comes from</label>
            <select id="alias-{{this.slug}}-source" name="sourceId">
              {{#each this.sourceOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
            </select>
          </div>
          <div class="form-field">
            <label for="alias-{{this.slug}}-provenance">What that source says it is</label>
            <textarea id="alias-{{this.slug}}-provenance" name="provenanceNote" rows="2" maxlength="500">{{this.provenanceNote}}</textarea>
          </div>
          {{#unless this.isCuratorOwned}}<p class="text-muted">{{this.ownerLabel}}</p>{{/unless}}
          <div class="form-actions">
            <button type="submit" class="btn btn-outline btn-sm">Save Alias</button>
          </div>
        </form>
        <form method="POST" action="{{this.deleteHref}}" class="inline-form">
          <button type="submit" class="btn btn-outline btn-sm">Remove</button>
        </form>
      </li>
      {{/each}}
    </ul>
    {{else}}<div class="empty-state"><p>No aliases.</p></div>{{/if}}

    <form method="POST" action="{{content.addAliasHref}}" class="form-block">
      <fieldset class="form-fieldset">
        <div class="form-field">
          <label for="add-alias-text">Add alias</label>
          <input type="text" id="add-alias-text" name="aliasText" value="{{content.aliasFormText}}" placeholder="Alias name" />
        </div>
        <div class="form-field">
          <label for="add-alias-type">Type</label>
          <select id="add-alias-type" name="aliasType">
            {{#each content.aliasTypeOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        {{! A new alias is maintained here whatever source it cites, so the source
            is asked for on its own terms rather than standing in for ownership. }}
        <div class="form-field">
          <label for="add-alias-source">Where it comes from</label>
          <select id="add-alias-source" name="sourceId">
            {{#each content.aliasSourceOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-field">
          <label for="add-alias-provenance">What that source says it is</label>
          <textarea id="add-alias-provenance" name="provenanceNote" rows="2" maxlength="500"></textarea>
        </div>
      </fieldset>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Add Alias</button>
      </div>
    </form>

    <h2 class="section-heading">Sources</h2>
    {{#if content.hasSourceError}}
    {{> outcome-notice text=content.sourceError tone='no'}}
    {{/if}}
    {{#if content.hasSources}}
    <ul class="freestyle-edit-list">
      {{#each content.sources}}
      <li>
        {{this.label}} <span class="badge">{{this.type}}</span>{{#if this.assertedAdds}} (asserts ADD {{this.assertedAdds}}){{/if}}
        <form method="POST" action="{{this.detachHref}}" class="inline-form">
          <button type="submit" class="btn btn-outline btn-sm">Detach</button>
        </form>
      </li>
      {{/each}}
    </ul>
    {{else}}<div class="empty-state"><p>No sources.</p></div>{{/if}}

    {{#if content.hasUnlinkedSources}}
    <form method="POST" action="{{content.attachSourceHref}}" class="form-block">
      <fieldset class="form-fieldset">
        <div class="form-field">
          <label for="attach-source-id">Attach source</label>
          <select id="attach-source-id" name="sourceId">
            <option value="">Choose a source</option>
            {{#each content.sourceOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-field">
          <label for="attach-source-url">External URL (optional)</label>
          <input type="text" id="attach-source-url" name="externalUrl" value="{{content.sourceFormExternalUrl}}" />
        </div>
        <div class="form-field">
          <label for="attach-source-adds">Asserted ADD (optional)</label>
          <input type="text" id="attach-source-adds" name="assertedAdds" value="{{content.sourceFormAssertedAdds}}" />
        </div>
      </fieldset>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Attach Source</button>
      </div>
    </form>
    {{else}}<p>All registry sources are linked.</p>{{/if}}

    <h2 class="section-heading" id="trick-modifier-links">Modifier Links</h2>
    {{#if content.hasModifierError}}
    {{> outcome-notice text=content.modifierError tone='no'}}
    {{/if}}
    {{#if content.hasModifierLinks}}
    <ul class="freestyle-edit-list">
      {{#each content.modifierLinks}}
      <li>
        {{this.name}} <code>{{this.slug}}</code> <span class="badge">{{this.type}}</span> (+{{this.addBonus}}, order {{this.applyOrder}})
        <form method="POST" action="{{this.detachHref}}" class="inline-form">
          <button type="submit" class="btn btn-outline btn-sm">Detach</button>
        </form>
      </li>
      {{/each}}
    </ul>
    {{else}}<div class="empty-state"><p>No modifier links.</p></div>{{/if}}

    <form method="POST" action="{{content.attachModifierHref}}" class="form-block">
      <fieldset class="form-fieldset">
        <div class="form-field">
          <label for="attach-modifier-slug">Attach modifier</label>
          <select id="attach-modifier-slug" name="modifierSlug">
            <option value="">Choose a modifier</option>
            {{#each content.modifierOptions}}<option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>{{/each}}
          </select>
        </div>
        <div class="form-field">
          <label for="attach-modifier-order">Apply order</label>
          <input type="text" id="attach-modifier-order" name="applyOrder" value="{{content.modifierFormApplyOrder}}" placeholder="1" />
        </div>
      </fieldset>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary btn-sm">Attach Modifier</button>
      </div>
    </form>

    <p><a href="{{content.backHref}}" class="btn btn-outline btn-sm">Back to Freestyle Content</a></p>
  </section>
</div>
