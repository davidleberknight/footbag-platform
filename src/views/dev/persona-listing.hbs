<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p class="hero-subtitle">
      Permanent persona harness, development and staging only. Pick a persona and
      click Switch to act as them.
    </p>
  </div>
</div>

<div class="wrapper">
  <p class="fs-sm mb-4">
    Each persona below is a member you can act as, grouped by what it tests. Its Verify line
    names the page to open, what to do and what you should see. A persona marked blocked waits
    on a feature that is not built and is not seeded. Every seeded persona's starting state is
    checked by the catalog test, every one that can sign in is switched in and its own pages
    loaded by the persona crawl, and each meets the admin and owner checks of the authorization
    matrix. Loaded from the canonical catalog: {{personaCount}} personas, {{seededCount}} seeded.
  </p>

  <section class="card card-static mb-8">
    <div class="card-title">Switch to a Real Member</div>
    <p class="card-description mb-2">
      <label for="dev-build-claim-as">Enter a real migrated legacy record's member id to build and act as its claimed account.</label>
    </p>
    <form method="get" action="/dev/build-claim" class="search-box-form">
      <input type="text" id="dev-build-claim-as" name="as" required
             pattern="[A-Za-z0-9_-]{1,64}" autocomplete="off"
             placeholder="Legacy member ID"
             class="search-box-input" />
      <button type="submit" class="btn btn-primary">Switch</button>
    </form>
  </section>

  <form method="post" action="/dev/personas/refresh" class="mb-8">
    <button type="submit" class="btn btn-outline">Refresh All Personas to Initial State</button>
  </form>

  {{#each groups}}
    <section class="mb-8">
      <h2 class="section-heading">{{dimension}}</h2>
      <div class="card-grid">
        {{#each personas}}
          <div class="card">
            <div class="card-title">{{displayName}}</div>
            <div class="card-meta">
              <code class="font-mono">{{slug}}</code>
              <span>{{tierLabel}}</span>
              {{#each roles}}<span class="badge">{{this}}</span>{{/each}}
              {{#each statusBadges}}<span class="badge{{#if muted}} badge-muted{{/if}}">{{text}}</span>{{/each}}
            </div>

            <p class="card-description">{{purpose}}</p>
            <p class="fs-sm"><strong>Verify:</strong> {{testingUsage}}</p>

            {{#if coverage.length}}
              <ul class="dev-persona-coverage">
                {{#each coverage}}<li>{{this}}</li>{{/each}}
              </ul>
            {{/if}}

            {{#if signInNote}}<p class="fs-sm">{{signInNote}}</p>{{/if}}

            {{#unless backed}}
              <p class="fs-sm">
                {{#if blockedBy}}Blocked: {{blockedBy}}{{#if userStory}} ({{userStory}}){{/if}}{{else}}No seed data{{/if}}
              </p>
            {{/unless}}

            <div class="card-actions">
              {{#if switchable}}
                <a class="btn btn-primary" href="{{switchHref}}">Switch</a>
              {{else}}
                {{#if loginHref}}
                  <a class="btn btn-outline" href="{{loginHref}}">Log In</a>
                {{else}}
                  <span class="badge badge-muted">Not Seeded</span>
                {{/if}}
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </section>
  {{/each}}

  {{#unless groups}}
    <div class="empty-state">No personas loaded.</div>
  {{/unless}}
</div>
