{{! Events landing page: upcoming events first, then the current year's
    completed events, with the archive years in a side list. Every event is the
    shared dated item, the same as on a year page and a member's profile. }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">

  {{! ── Featured promo hero ─────────────────────────────────────── }}
  {{#if content.featuredPromo}}
    <section class="event-hero">
      {{#if content.featuredPromo.imageUrl}}
        <a href="{{content.featuredPromo.href}}" {{#if content.featuredPromo.external}}target="_blank" rel="noopener noreferrer"{{/if}} class="event-hero-art-link">
          <img src="{{content.featuredPromo.imageUrl}}" alt="{{#if content.featuredPromo.imageAlt}}{{content.featuredPromo.imageAlt}}{{else}}{{content.featuredPromo.title}}{{/if}}" class="event-hero-art-img" />
        </a>
      {{/if}}
      <div class="event-hero-panel">
        <div class="event-hero-eyebrow">Featured Event</div>
        <h2 class="event-hero-title">
          <a href="{{content.featuredPromo.href}}" {{#if content.featuredPromo.external}}target="_blank" rel="noopener noreferrer"{{/if}}>
            {{content.featuredPromo.title}}
          </a>
        </h2>
        <div class="event-hero-meta">
          <span>{{formatDate content.featuredPromo.startDate}} – {{formatDate content.featuredPromo.endDate}}</span>
          <span>{{formatLocation content.featuredPromo.city content.featuredPromo.region content.featuredPromo.country}}</span>
        </div>
        {{#if content.featuredPromo.description}}
          <p class="event-hero-description">{{content.featuredPromo.description}}</p>
        {{/if}}
        <a href="{{content.featuredPromo.href}}" {{#if content.featuredPromo.external}}target="_blank" rel="noopener noreferrer"{{/if}} class="btn btn-inverse">{{content.featuredPromo.ctaLabel}}</a>
      </div>
    </section>
  {{/if}}

  <div class="side-list-layout">
    <div>
      {{! ── Upcoming events ─────────────────────────────────────── }}
      <section id="upcoming-events">
        <div class="section-heading">
          <h2>Upcoming Events</h2>
        </div>
        <p>Organizing an event? Create it on footbag.org. To have it sanctioned by IFPA, see the <a href="{{siteHref content.organizerLinks.guidelinesHref}}">sanctioning guidelines</a>.</p>
        {{#if content.upcomingEvents.length}}
          <div class="card-grid">
            {{#each content.upcomingEvents}}{{> dated-item this}}{{/each}}
          </div>
        {{else}}
          <p>No upcoming events are listed yet.</p>
        {{/if}}
      </section>

      {{! ── This year's completed events ────────────────────────── }}
      {{#if content.currentYearEvents.length}}
        <section id="current-year-events">
          <div class="section-heading">
            <h2>Completed Events From {{content.currentYear}}</h2>
          </div>
          <div class="dated-list">
            {{#each content.currentYearEvents}}{{> dated-item this compact=true}}{{/each}}
          </div>
        </section>
      {{/if}}
    </div>

    {{! ── Past events by year ─────────────────────────────────────── }}
    {{#if content.archiveYears.length}}
      <aside class="side-list" id="past-events" aria-labelledby="past-events-heading">
        <div class="section-heading">
          <h2 id="past-events-heading">Past Events</h2>
        </div>
        <p>Browse completed events and results by year.</p>
        <ul>
          {{#each content.archiveYears}}
            <li><a href="/events/year/{{this}}">{{this}}</a></li>
          {{/each}}
        </ul>
        <p class="fs-sm">Results data before 1997 is incomplete.</p>
      </aside>
    {{/if}}
  </div>

</div>
