{{! An event's participant list, for its organizers only }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">
  {{#if content.notice}}
    {{#if content.noticeEditHref}}
      {{#> outcome-notice tone=content.notice.tone}}<p>{{content.notice.text}} <a href="{{siteHref content.noticeEditHref}}">Edit Entry</a></p>{{/outcome-notice}}
    {{else}}
      {{> outcome-notice text=content.notice.text tone=content.notice.tone}}
    {{/if}}
  {{/if}}

  <section>
    <p><span class="fw-600">{{content.confirmedCount}}</span> confirmed{{#if content.pendingCount}}, <span class="fw-600">{{content.pendingCount}}</span> awaiting payment{{/if}}.</p>
    <div class="form-actions">
      {{#if content.addEntrantHref}}<a href="{{siteHref content.addEntrantHref}}" class="btn btn-primary">Add Entrant</a>{{/if}}
      <a href="{{siteHref content.csvHref}}" class="btn btn-outline">Download Participants (CSV)</a>
      <a href="{{siteHref content.checkInByNameHref}}" class="btn btn-outline">Download Check-in Sheet (PDF)</a>
      <a href="{{siteHref content.checkInByTypeHref}}" class="btn btn-outline">Check-in Sheet by Type (PDF)</a>
      <a href="{{siteHref content.summaryHref}}" class="btn btn-outline">Registration Summary</a>
      <a href="{{siteHref content.emailHref}}" class="btn btn-outline">Email Participants</a>
    </div>
  </section>

  <section>
    <div class="section-heading"><h2>Competitions</h2></div>
    {{#if content.hasDivisionGroups}}
      {{#each content.divisionGroups}}
        <h3>{{this.name}}: {{this.confirmedCount}} Confirmed</h3>
        <div class="records-table-wrap" tabindex="0" role="region" aria-label="{{this.name}}">
        <table class="data-table">
          <thead>
            <tr>
              <th scope="col">Entrant</th>
              {{#if this.isDoubles}}<th scope="col">Partner</th>{{/if}}
              <th scope="col">Payment</th>
              <th scope="col">Actions</th>
            </tr>
          </thead>
          <tbody>
            {{#each this.rows}}
              <tr data-registration-id="{{this.registrationId}}">
                <td><a href="{{siteHref this.entrantHref}}">{{this.entrantName}}</a></td>
                {{#if ../isDoubles}}<td>{{#if this.noPartner}}<span class="badge" data-no-partner>No partner</span>{{else}}{{this.partnerName}}{{#if this.pairingFlag}} <span class="badge" data-pairing-flag="{{this.pairingKind}}">{{this.pairingFlag}}</span>{{/if}}{{/if}}</td>{{/if}}
                <td>{{this.paymentLabel}}</td>
                <td>{{#if this.editHref}}<a href="{{siteHref this.editHref}}" class="btn btn-outline btn-sm">Edit Entry</a>{{/if}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
        </div>
        {{#if this.isDoubles}}
          <p data-doubles-pairing-help>A doubles entry is a pair once both partners have registered and named each other. Fix a flagged entry with Edit Entry before uploading results.</p>
        {{/if}}
      {{/each}}
    {{else}}
      <p class="empty-state">Nobody is registered yet.</p>
    {{/if}}
  </section>

  <section>
    <div class="section-heading"><h2>Registered</h2></div>
    {{#if content.hasRows}}
      <p>
        {{#each content.sortLinks}}
          {{#if this.isActive}}<span class="badge">{{this.label}}</span>{{else}}<a href="{{siteHref this.href}}" class="tag-chip">{{this.label}}</a>{{/if}}
        {{/each}}
      </p>
      <div class="records-table-wrap" tabindex="0" role="region" aria-label="Participants">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Registration</th>
            <th scope="col">Competitions</th>
            <th scope="col">Member</th>
            <th scope="col">Location</th>
            <th scope="col">Email</th>
            {{#if content.showPayment}}<th scope="col">Payment</th>{{/if}}
            {{#if content.showTshirt}}<th scope="col">T-shirt</th>{{/if}}
            <th scope="col">Attendance and Actions</th>
          </tr>
        </thead>
        <tbody>
          {{#each content.rows}}
            <tr>
              <td><a href="{{this.profileHref}}">{{this.name}}</a></td>
              <td>{{this.typeLabel}}<br><span class="text-muted fs-sm">{{this.statusLabel}}, {{formatDate this.registeredOn}}</span></td>
              <td>
                {{#each this.entries}}
                  <div>{{this.divisionName}}{{#if this.partner}} with {{this.partner}}{{/if}}{{#if this.amateurLabel}} <span class="badge">{{this.amateurLabel}}</span>{{/if}}</div>
                {{/each}}
              </td>
              <td>{{this.tierLabel}}{{#if this.activePlayerLabel}}<br><span class="fs-sm">{{this.activePlayerLabel}}</span>{{/if}}</td>
              <td>{{this.location}}</td>
              <td>{{#if this.email}}{{this.email}}{{else}}<span class="text-muted fs-sm">Not shared</span>{{/if}}</td>
              {{#if ../content.showPayment}}<td>{{this.paymentLabel}}</td>{{/if}}
              {{#if ../content.showTshirt}}<td>{{this.tshirtSize}}</td>{{/if}}
              <td>
                {{#if this.attendedLabel}}<span class="badge">{{this.attendedLabel}}</span>{{/if}}
                {{#if this.canMarkAttended}}
                  <label>
                    <input type="checkbox" name="registration" value="{{this.registrationId}}" form="attendance-form" />
                    Attended
                  </label>
                {{/if}}
                {{#if this.cancelAction}}
                  <form method="POST" action="{{this.cancelAction}}" class="inline-form">
                    <button type="submit" class="btn btn-outline btn-sm">Cancel Registration</button>
                  </form>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      </div>
      {{#if content.attendanceAction}}
        <form method="POST" action="{{content.attendanceAction}}" id="attendance-form" class="form-block mt-2">
          <p>Tick everyone who took part, then mark them attended. Attendance gives a Registered Member (Tier 0) Active Player status.</p>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Mark Attended</button>
          </div>
        </form>
      {{/if}}
    {{else}}
      <p class="empty-state">Nobody is registered yet.</p>
    {{/if}}
  </section>

  {{> back-link}}
</div>
