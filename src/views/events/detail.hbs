{{! Canonical single event page — details and/or results }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  {{#if content.notice}}
    {{> outcome-notice text=content.notice.text tone=content.notice.tone}}
  {{/if}}
  {{#if content.coverPhoto}}
    <img id="event-cover-photo" class="cover-photo" src="{{content.coverPhoto.url}}" alt="{{content.coverPhoto.alt}}"{{#if content.coverPhoto.widthPx}} width="{{content.coverPhoto.widthPx}}" height="{{content.coverPhoto.heightPx}}"{{/if}}>
  {{/if}}
  <section>
    <div class="event-detail">

      {{! ── Event header ──────────────────────────────────────── }}
      <div class="event-header">
        <div class="event-meta-row">
          <span><span aria-hidden="true">&#128197;</span><span class="visually-hidden">Date:</span> {{content.dateRange}}</span>
          <span><span aria-hidden="true">&#128205;</span><span class="visually-hidden">Location:</span> {{formatLocation content.event.city content.event.region content.event.country}}</span>
          {{#if content.event.hostClub}}
            <span><span aria-hidden="true">&#127968;</span><span class="visually-hidden">Host club:</span> {{content.event.hostClub}}</span>
          {{/if}}
          <span class="badge {{content.event.statusCssClass}}">{{content.event.statusLabel}}</span>
          {{#if content.event.isSanctioned}}<span class="badge">IFPA-sanctioned</span>{{/if}}
        </div>

        {{#if content.event.externalUrl}}
          {{{externalLink content.event.externalUrl label="Event Website" class="btn btn-outline event-external-link"}}}
        {{/if}}
      </div>

      {{> media-line id="event-media" display=content.hashtag.display galleryHref=content.hashtag.galleryHref galleryLabel=content.media.buttonLabel}}

      {{! ── Description ───────────────────────────────────────── }}
      {{#if content.event.description}}
        <p>{{content.event.description}}</p>
      {{/if}}

      {{! ── Organizers ────────────────────────────────────────── }}
      {{#if content.organizers.length}}
        <div>
          <div class="section-heading"><h2>Organizers</h2></div>
          <ul>
            {{#each content.organizers}}
              <li>{{this.name}}{{#if this.contactEmail}}, <a href="mailto:{{this.contactEmail}}">{{this.contactEmail}}</a>{{/if}}</li>
            {{/each}}
          </ul>
        </div>
      {{/if}}

      {{! ── Competition categories ────────────────────────────── }}
      {{#if content.disciplines.length}}
        <div id="competition-categories">
          <div class="section-heading"><h2>Competitions</h2></div>
          {{#each content.disciplineGroups}}
            {{#if label}}<h3>{{label}}</h3>{{/if}}
            <ul class="disciplines-list">
              {{#each disciplines}}
                <li class="discipline-tag">{{name}}{{#if teamTypeLabel}} ({{teamTypeLabel}}){{/if}}{{#if registeredLabel}} <span class="text-muted">{{registeredLabel}}</span>{{/if}}</li>
              {{/each}}
            </ul>
          {{/each}}
        </div>
      {{/if}}

      {{! ── Registration, for a signed-in member ──────────────── }}
      {{#if content.registration}}
        {{#with content.registration}}
          {{#if mine}}
            <div id="your-registration">
              <div class="section-heading"><h2>Your Registration</h2></div>
              <p>{{mine.typeLabel}}{{#if mine.statusLabel}} <span class="badge">{{mine.statusLabel}}</span>{{/if}}</p>
              {{#if mine.entries.length}}
                <ul>
                  {{#each mine.entries}}
                    <li>{{divisionName}}{{#if partnerName}}, with {{partnerName}}{{/if}}{{#if isAmateur}}, as an Amateur{{/if}}</li>
                  {{/each}}
                </ul>
              {{/if}}
              {{#if mine.tshirtSize}}<p>T-shirt size: {{mine.tshirtSize}}</p>{{/if}}
              {{#if mine.completePaymentHref}}
                <p><a href="{{siteHref mine.completePaymentHref}}" class="btn btn-primary">Complete Payment</a></p>
              {{/if}}
              {{#if mine.withdrawAction}}
                <form method="POST" action="{{mine.withdrawAction}}" class="inline-form">
                  <button type="submit" class="btn btn-outline">Withdraw Registration</button>
                </form>
              {{else}}
                <p>Registration has closed. To withdraw now, contact an organizer.</p>
              {{/if}}
            </div>
          {{/if}}
          {{#if registerHref}}
            <p><a href="{{siteHref registerHref}}" class="btn btn-primary">Register for This Event</a></p>
          {{/if}}
          {{#if closedNote}}<p>{{closedNote}}</p>{{/if}}
          {{#if registrants.length}}
            <div>
              <div class="section-heading"><h2>{{registrantsHeading}}</h2></div>
              <ul>
                {{#each registrants}}
                  <li>
                    <a href="{{siteHref profileHref}}">{{name}}</a>, {{typeLabel}}{{#if entries.length}}:
                      {{#each entries}}{{#unless @first}}; {{/unless}}{{divisionName}}{{#if partnerName}} with {{#if partnerHref}}<a href="{{siteHref partnerHref}}">{{partnerName}}</a>{{else}}{{partnerName}}{{/if}}{{/if}}{{/each}}
                    {{/if}}
                  </li>
                {{/each}}
              </ul>
            </div>
          {{/if}}
        {{/with}}
      {{/if}}

      {{! ── Results, once the event has taken place ────────────── }}
      {{#if content.showResults}}
      <div id="results">
        <div class="section-heading"><h2>Results</h2></div>
        {{#if content.hasResults}}
          {{#if content.isSparse}}
            <div class="no-results-notice">
              Historical results are incomplete, so some results from this event may be missing.
            </div>
          {{/if}}
          <div>
            {{#each content.resultSections}}
              {{> result-section}}
            {{/each}}
          </div>
        {{else}}
          <div class="no-results-notice">
            Results are not yet available.
          </div>
        {{/if}}
      </div>
      {{/if}}

    </div>
  </section>

  {{> back-link}}
</div>
