{{! The confirm step before an organizer removes a division or an organizer, or steps down }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <section>
    <p class="notice notice-warn" role="alert">{{content.caution}}</p>

    <div class="form-actions">
      <form method="POST" action="{{content.action}}" class="inline-form">
        {{#if content.hiddenMemberId}}<input type="hidden" name="member_id" value="{{content.hiddenMemberId}}" />{{/if}}
        <input type="hidden" name="confirmed" value="1" />
        <button type="submit" class="btn btn-outline">{{content.buttonLabel}}</button>
      </form>
      <a href="{{siteHref content.cancelHref}}" class="btn btn-outline">Cancel</a>
    </div>
  </section>
</div>
