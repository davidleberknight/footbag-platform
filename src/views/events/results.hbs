{{! An event's organizers upload its results: a file read into a preview, then committed }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">
  {{#if content.notice}}
    {{> outcome-notice text=content.notice.text tone=content.notice.tone}}
  {{/if}}
  {{#if content.errorMessage}}
    {{> outcome-notice tone='no' text=content.errorMessage}}
  {{/if}}
  {{#if content.badge}}
    <p><span class="badge">{{content.badge}}</span></p>
  {{/if}}

  {{#if content.preview}}
    <section>
      <div class="section-heading"><h2>Preview</h2></div>
      {{#if content.preview.hasProblems}}
        {{> outcome-notice tone='no' lines=content.preview.problems}}
        {{#each content.preview.fileErrors}}<p>{{this}}</p>{{/each}}
      {{else}}
        <p>{{content.preview.rowCount}} placings read from {{content.preview.filename}}. Check them, then publish.</p>
      {{/if}}
      {{#if content.preview.missingDivisionsText}}<p>{{content.preview.missingDivisionsText}}</p>{{/if}}

      {{#each content.preview.groups}}
        <h3>{{this.name}}{{#if this.newLabel}} <span class="badge">{{this.newLabel}}</span>{{/if}}</h3>
        <div class="records-table-wrap" tabindex="0" role="region" aria-label="{{this.name}} preview">
        <table class="data-table">
          <thead>
            <tr><th scope="col">Place</th><th scope="col">Competitors</th><th scope="col">Score</th></tr>
          </thead>
          <tbody>
            {{#each this.rows}}
              <tr>
                <td>{{this.place}}{{#if this.tieLabel}} <span class="badge">{{this.tieLabel}}</span>{{/if}}</td>
                <td>
                  {{#each this.competitors}}
                    <div>{{this.name}} <span class="text-muted fs-sm">{{this.matchLabel}}</span></div>
                  {{/each}}
                </td>
                <td>{{this.score}}</td>
              </tr>
            {{/each}}
          </tbody>
        </table>
        </div>
      {{/each}}

      {{#unless content.preview.fileErrors.length}}
        <form method="POST" action="{{content.commitAction}}" enctype="multipart/form-data" class="form-block mt-4">
          <textarea name="results_text" hidden>{{content.preview.text}}</textarea>
          <input type="hidden" name="filename" value="{{content.preview.filename}}" />
          {{#if content.preview.ties.length}}
            <fieldset class="form-fieldset">
              <legend>Ties</legend>
              {{#each content.preview.ties}}
                <div class="form-field">
                  <label>
                    <input type="checkbox" name="{{this.field}}" value="{{this.value}}"{{#if this.checked}} checked{{/if}} />
                    {{this.label}}
                  </label>
                </div>
              {{/each}}
            </fieldset>
          {{/if}}
          {{#if content.preview.contested.length}}
            <fieldset class="form-fieldset">
              <legend>Competitions Not Advertised</legend>
              {{#each content.preview.contested}}
                <div class="form-field">
                  <label>
                    <input type="checkbox" name="{{this.field}}" value="{{this.value}}"{{#if this.checked}} checked{{/if}} />
                    {{this.label}}
                  </label>
                </div>
              {{/each}}
            </fieldset>
          {{/if}}
          <div class="form-actions">
            <button type="submit" name="step" value="check" class="btn btn-outline">Check Again</button>
            {{#if content.preview.committable}}
              <button type="submit" name="step" value="commit" class="btn btn-primary">Publish Results</button>
            {{/if}}
          </div>
        </form>
      {{/unless}}
    </section>
  {{/if}}

  <section>
    <div class="section-heading"><h2>Upload a File</h2></div>
    {{#if content.canUpload}}
      <p>One row per placing, with the columns competition, place, player, partner (doubles only) and score (optional). Use the competition names as the event lists them; for a competition that ran but was not listed, also fill in sport (net, freestyle, golf, consecutives or x-square). Give tied entries the same place. Up to {{content.maxSizeText}}.</p>
      <p><a href="{{siteHref content.templateHref}}" class="action-link">Download a Blank Results File (CSV)</a></p>
      <form method="POST" action="{{content.previewAction}}" enctype="multipart/form-data" class="form-block">
        <div class="form-field">
          <label for="results_file">Results file (CSV)</label>
          <input type="file" id="results_file" name="results_file" accept=".csv,text/csv" required />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Preview Results</button>
        </div>
      </form>
    {{else}}
      <p>{{content.notYetText}}</p>
    {{/if}}
    {{#if content.hasResults}}
      <p><a href="{{siteHref content.eventHref}}" class="action-link">See the Published Results</a></p>
    {{/if}}
    <p><a href="{{siteHref content.attendanceHref}}" class="action-link">Confirm Attendance</a></p>
  </section>

  {{> back-link}}
</div>
