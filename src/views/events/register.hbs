{{! A member registering themselves for an event }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p class="hero-subtitle">{{content.eventDates}}</p>
  </div>
</div>

<div class="wrapper">
  <section>

    {{#if content.errorMessage}}
      {{> outcome-notice tone='no' text=content.errorMessage}}
    {{/if}}
    {{#if content.pendingNote}}
      <p>{{content.pendingNote}}</p>
    {{/if}}

    <form method="POST" action="{{content.formAction}}" id="{{content.formId}}" class="form-block">

      {{#if content.typeChoices}}
        <fieldset class="form-fieldset">
          <legend>Registering As</legend>
          {{#each content.typeChoices}}
            <div class="form-field"><label><input type="radio" name="registration_type" value="{{this.value}}"{{#if this.checked}} checked{{/if}}> {{this.label}}</label></div>
          {{/each}}
          <small class="form-hint">A spectator comes to the event without competing.</small>
        </fieldset>
      {{else}}
        <input type="hidden" name="registration_type" value="{{content.impliedType}}" />
        <p>Registering as: {{content.impliedTypeLabel}}</p>
      {{/if}}

      {{#if content.showDivisions}}
        <fieldset class="form-fieldset">
          <legend>What are you entering?</legend>
          {{#each content.divisions}}
            <div class="form-field">
              <label>
                <input type="checkbox" name="division" value="{{this.id}}"{{#if this.checked}} checked{{/if}} />
                {{this.name}}
              </label>
              {{#if this.genderWarning}}
                <p>{{this.genderWarning}}{{#if this.profileHref}} <a href="{{siteHref this.profileHref}}">Your profile</a>{{/if}}</p>
              {{/if}}
            </div>
            {{#if this.partnerPicker}}
              <input type="hidden" name="partner_division" value="{{this.id}}" />
              {{> member-picker this.partnerPicker}}
            {{/if}}
            {{#if this.offersPrizeMoney}}
              <div class="form-field">
                <label>
                  <input type="checkbox" name="amateur" value="{{this.id}}"{{#if this.amateur}} checked{{/if}} />
                  Enter as an Amateur (no prize money)
                </label>
              </div>
            {{/if}}
          {{/each}}
        </fieldset>
        <div class="form-field">
          <small class="form-hint">A competitor enters at least one competition.</small>
        </div>
      {{/if}}

      {{#if content.tshirtOptions}}
        <div class="form-field">
          <label for="tshirt_size">T-shirt size</label>
          <select id="tshirt_size" name="tshirt_size">
            {{#each content.tshirtOptions}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
        </div>
      {{/if}}

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">{{content.submitLabel}}</button>
        <a href="{{siteHref content.cancelHref}}" class="btn btn-outline">Cancel</a>
      </div>

    </form>
    <script src="{{{asset 'js/member-picker-enter.js'}}}" defer></script>
  </section>

  {{> back-link}}
</div>
