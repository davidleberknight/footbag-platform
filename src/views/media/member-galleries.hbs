<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">
  {{#if content.hasGalleries}}
    <div class="card-grid card-grid-compact">
      {{#each content.galleries}}
      <div class="card">
        {{! The cover opens the gallery too. It is a second pointer for the eye
            and hand only, so keyboard and screen-reader users meet one link
            per card: the name. }}
        {{#if coverThumbUrl}}<a href="{{href}}" tabindex="-1" aria-hidden="true"><img src="{{coverThumbUrl}}" alt="{{name}}" class="card-cover" loading="lazy"></a>{{/if}}
        <a href="{{href}}" class="card-title">{{name}}</a>
        {{#if description}}<p class="card-description">{{description}}</p>{{/if}}
        <p class="card-meta">{{itemCount}} {{itemCountNoun}} by {{#if ownerHref}}<a href="{{ownerHref}}">{{ownerDisplayName}}</a>{{else}}{{ownerDisplayName}}{{/if}}</p>
      </div>
      {{/each}}
    </div>
    {{> _pager pagination=content.pagination}}
  {{else}}
    <div class="empty-state">No member galleries yet.</div>
  {{/if}}
</div>
