<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">
  {{#if content.hasGalleries}}
    <div class="card-grid card-grid-compact">
      {{#each content.galleries}}
      <div class="card">
        {{! The name is the card's one link, stretched over the card. The cover
            opens the gallery too. It is a second pointer for the eye and hand
            only, so keyboard and screen-reader users meet one link per card:
            the name. }}
        {{#if coverThumbUrl}}<a href="{{href}}" tabindex="-1" aria-hidden="true"><img src="{{coverThumbUrl}}" alt="{{name}}" class="card-cover" loading="lazy"></a>{{/if}}
        <a href="{{href}}" class="card-title card-link">{{name}}</a>
        {{#if description}}<p class="card-description">{{description}}</p>{{/if}}
        {{! A member gallery names its owner; a curated gallery is IFPA's and
            carries no owner line. }}
        <p class="card-meta">{{itemCount}} {{itemCountNoun}}{{#if ownerDisplayName}} by {{#if ownerHref}}<a href="{{ownerHref}}">{{ownerDisplayName}}</a>{{else}}{{ownerDisplayName}}{{/if}}{{/if}}</p>
      </div>
      {{/each}}
    </div>
    {{> _pager pagination=content.pagination}}
  {{else}}
    <div class="empty-state">{{content.emptyText}}</div>
  {{/if}}
</div>
