{{#if content.isResultsMode}}
  {{> _set-header header=content.setHeader}}
{{else}}
  <div class="hero hero-sm">
    <div>
      <h1>Browse Media</h1>
      <p class="hero-subtitle">Browse all photos and videos by hashtag.</p>
    </div>
  </div>
{{/if}}

<div class="wrapper">

  {{#if content.isResultsMode}}
  <p class="mt-4 mb-4"><a href="/media/browse" class="btn btn-outline">Browse All Media</a></p>
  {{/if}}

  {{#if content.unresolvedTokens.length}}
    <p class="empty-state">
      No media found for: {{#each content.unresolvedTokens}}<code>#{{this}}</code>{{#unless @last}} {{/unless}}{{/each}}
    </p>
  {{/if}}

  {{#unless content.isResultsMode}}
    {{! One section, three blocks. Separate sibling sections each inherited the
        global section padding and a divider on top of their own margin, which
        is what left the landing mostly empty space. }}
    <section class="media-blocks">
      <div role="region" aria-labelledby="browse-search-heading">
        <h2 id="browse-search-heading" class="browse-section-heading">Find Media by Hashtag</h2>
        <form method="GET" action="/media/browse" class="browse-search-form" role="search">
          <input type="text" name="tag" value="{{content.formIncludeText}}" data-tag-chips class="browse-search-input" placeholder="Include hashtags, e.g. tutorial passback_records" aria-label="Include hashtags">
          <input type="text" name="exclude" value="{{content.formExcludeText}}" data-tag-chips class="browse-search-input" placeholder="Exclude hashtags (optional)" aria-label="Exclude hashtags">
          <button type="submit" class="btn btn-primary">Browse</button>
        </form>
      </div>

      <div role="region" aria-labelledby="browse-popular-heading">
        <h2 id="browse-popular-heading" class="browse-section-heading">Popular Hashtags</h2>
        {{#if content.hashtagIndex.hasPopularTags}}
          <ul class="tag-chip-row">
            {{#each content.hashtagIndex.popularTags}}
            <li><a href="{{href}}" class="tag-chip">{{display}}</a></li>
            {{/each}}
          </ul>
        {{else}}
          <p>No hashtags carry media yet.</p>
        {{/if}}
      </div>

      {{#if content.hashtagIndex.hasHighlights}}
      <div role="region" aria-labelledby="browse-highlight-heading">
        <h2 id="browse-highlight-heading" class="browse-section-heading">Recent Events and Tutorials</h2>
        <ul class="tag-chip-row">
          {{#each content.hashtagIndex.highlightTags}}
          <li><a href="{{href}}" class="tag-chip">{{display}}</a></li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      <div role="region" aria-labelledby="browse-all-heading">
        <h2 id="browse-all-heading" class="browse-section-heading">All Hashtags</h2>
        {{#if content.hashtagIndex.hasCommunityTags}}
          <ul class="tag-chip-row">
            {{#each content.hashtagIndex.communityTags}}
            <li><a href="{{href}}" class="tag-chip">{{display}}</a></li>
            {{/each}}
          </ul>
        {{else}}
          <p>{{content.hashtagIndex.communityEmptyNote}}</p>
        {{/if}}
      </div>

      <div class="browse-tags-help" role="region" aria-labelledby="browse-tags-help-heading">
        <h2 id="browse-tags-help-heading">About Hashtags</h2>
        <p>Popular hashtags are the most-used hashtags across the whole site. All hashtags lists the ones the community shares, in alphabetical order. Event and club hashtags follow fixed patterns (<code>#event_&lt;year&gt;_&lt;event_name&gt;</code>, <code>#club_&lt;location_or_name&gt;</code>). A hashtag only one member uses stays private to that member's gallery.</p>
        {{> hashtag-slug-help}}
      </div>
    </section>
  {{/unless}}

  {{#if content.isResultsMode}}
    <div class="media-layout">
      <div class="media-layout-rail">
        {{#if content.filter}}
          {{> _tag-filter-bar filter=content.filter}}
        {{/if}}
      </div>

      <div class="media-layout-main">
        {{#if content.items.length}}
          <ul class="gallery-grid">
            {{#each content.items}}
              {{> _gallery-tile this}}
            {{/each}}
          </ul>

          {{#if content.pagination}}
            {{#if (or content.pagination.hasPrev content.pagination.hasNext)}}
              <nav class="gallery-pagination" aria-label="Pagination">
                {{#if content.pagination.hasPrev}}<a href="{{content.pagination.prevHref}}" rel="prev">Previous</a>{{/if}}
                <span class="gallery-pagination-status">Page {{content.pagination.page}}</span>
                {{#if content.pagination.hasNext}}<a href="{{content.pagination.nextHref}}" rel="next">Next</a>{{/if}}
              </nav>
            {{/if}}
          {{/if}}
        {{else}}
          {{> _set-empty-state popularTags=content.popularTags}}
        {{/if}}
      </div>
    </div>
  {{/if}}

</div>
{{> fold-token-script}}
<script src="{{{asset 'js/tag-chips.js'}}}" defer></script>
