{{> _set-header header=content.setHeader}}

<div class="wrapper">
  {{> share-notices notices=content.notices}}

  {{#if content.gallery.description}}
    <p class="gallery-description">{{content.gallery.description}}</p>
  {{/if}}

  {{#if content.gallery.externalLinks.length}}
    <ul class="gallery-references">
      {{#each content.gallery.externalLinks}}
        <li>External URL: {{{externalLink url noIcon=true}}}</li>
      {{/each}}
    </ul>
  {{/if}}

  <div class="media-layout">
    <div class="media-layout-rail">
      {{#if content.filter}}
        {{> _tag-filter-bar filter=content.filter}}
      {{/if}}
    </div>

    <div class="media-layout-main">
      {{#if content.pagination.largeSetNotice}}
        <div class="notice-card notice-card--info">{{content.pagination.largeSetNotice}}</div>
      {{/if}}

      {{#if content.items.length}}
        <ul class="gallery-grid">
          {{#each content.items}}
            {{> _gallery-tile this}}
          {{/each}}
        </ul>

        {{> _pager pagination=content.pagination}}
      {{else}}
        {{> _set-empty-state popularTags=content.popularTags}}
      {{/if}}
    </div>
  </div>

</div>
{{> fold-token-script}}
<script src="{{{asset 'js/tag-chips.js'}}}" defer></script>
