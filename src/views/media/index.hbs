<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p>{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">

  {{! ── Media-collection cards; browse-by-hashtag leads with a green accent ─
      The section's own padding is the whole gap above the grid; the extra
      content-section margin on top of it just pushed the cards down. }}
  <section>
    <div class="media-hub-grid">
      {{#each content.cards}}
      <div class="card card-static{{#if accent}} media-hub-card--browse{{/if}}">
        <div class="card-title">{{title}}</div>
        <p>{{description}}</p>
        <a href="{{href}}" class="btn {{#if accent}}btn-inverse{{else}}btn-outline{{/if}}">{{cta}}</a>
      </div>
      {{/each}}
    </div>
  </section>

</div>
