<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <section>
    {{! The three arrivals are mutually exclusive. A failed resend must not fall
        through to the registration-success text: the visitor did not just
        register, and reading "Registration successful!" under a red error
        banner tells them the opposite of what happened. }}
    {{#if content.error}}
      {{> outcome-notice text=content.error tone='no'}}
    {{else if content.resent}}
      {{! The wording cannot say whether anything was sent without telling a
          stranger whether the address has an account, so it claims no change
          and reads neutral. }}
      {{> outcome-notice text="If an unverified account exists for that email, a new verification link has been sent." tone='info'}}
    {{else}}
      <p>
        Registration successful! Please check your email to verify your account.
        The verification link expires in {{content.verifyLinkHours}} hours.
      </p>
    {{/if}}

    <form method="POST" action="/verify/resend" class="form-block">
      <div class="form-field">
        <label for="email">Didn't get the email? Enter your address to resend:</label>
        <input type="email" id="email" name="email" autocomplete="email" required />
      </div>
      {{> captcha-field content}}
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Resend Verification Email</button>
      </div>
    </form>

    <p class="fs-sm">If that mailbox can no longer receive mail, register again using an address you can read, or ask an administrator for help.</p>

    {{#if content.emailPreview}}
      {{> simulated-email-card content.emailPreview}}
    {{/if}}
  </section>
</div>
{{#if content.turnstileSiteKey}}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
{{/if}}
