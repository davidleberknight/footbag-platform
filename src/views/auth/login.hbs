{{! Login page: the single visitor entry. It serves three arrivals, so all three
    sit side by side in one band with nothing to scroll past: signing in on the
    left for the returning member, who is by far the most common; on the right,
    the visitor who was on the old site and the visitor who is new. Both of those
    lead to registration, since there is no other way in. }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p>{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">

  <section>
    {{#if content.authReason}}
      <p class="form-notice">{{content.authReason}}</p>
    {{/if}}
    {{#if content.error}}
      <p class="form-field-error" role="alert">{{content.error}}</p>
    {{/if}}

    <div class="card-grid card-grid-2col">
      <div>
        <form method="POST" action="/login" class="login-form">
          {{#if content.returnTo}}
            <input type="hidden" name="returnTo" value="{{content.returnTo}}" />
          {{/if}}
          <div class="form-field">
            <label for="email">Email address</label>
            <input type="text" id="email" name="email" autocomplete="email" required />
          </div>
          <div class="form-field">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" autocomplete="current-password" required />
          </div>
          {{> captcha-field content}}
          <button type="submit" class="btn btn-primary">Log In</button>
        </form>

        <p class="mt-4"><a href="/password/forgot">Forgot your password?</a></p>
      </div>

      <div>
        <div class="card card-static">
          <div class="card-title">Had an account on the old footbag.org?</div>
          <p class="card-description">You will need to create a new account here first to become a member in the new system. During setup, you can link to your historical data, such as event results, club affiliation, and any paid membership tier you held.</p>
          <p><a href="/register" class="btn btn-primary">Create an Account</a></p>
        </div>

        <div class="card card-static mt-4">
          <div class="card-title">New to IFPA?</div>
          <p class="card-description">Create an account to join the International Footbag Players Association.</p>
          <p><a href="/register" class="btn btn-primary">Create an Account</a></p>
          <p class="fs-sm m-0"><a href="/ifpa">See IFPA membership tiers and benefits</a></p>
        </div>
      </div>
    </div>
  </section>

</div>
{{#if content.turnstileSiteKey}}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" defer></script>
{{/if}}
