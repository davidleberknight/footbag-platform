<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <section>
    <p>Press the button below to confirm your email address.</p>
    <form method="POST" action="/verify" class="form-block">
      <input type="hidden" name="token" value="{{content.token}}" />
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Verify My Email</button>
      </div>
    </form>
  </section>
</div>
