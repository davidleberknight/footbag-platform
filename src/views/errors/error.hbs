{{! The one error page for every failing route. The status digit, the heading,
    the body and the controls all come from the view-model, so the number the
    visitor reads always matches the status the response carries. }}
<div class="wrapper">
  <div class="error-page">
    <div class="error-code">{{content.statusCode}}</div>
    <h1>{{page.title}}</h1>
    {{#each content.paragraphs}}
      <p>{{this}}</p>
    {{/each}}
    <div class="error-actions">
      {{#each content.actions}}
        <a href="{{href}}" class="btn btn-primary">{{label}}</a>
      {{/each}}
    </div>
  </div>
</div>
