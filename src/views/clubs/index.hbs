<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<script type="application/json" id="clubs-map-data">{{{content.mapDataJson}}}</script>
<script src="{{{asset 'js/clubs-map.js'}}}" defer></script>

<div class="wrapper">

  {{! Drawn at its final size from the first paint, so the country index below
      never jumps when the script fills it in; hidden where scripting is off. }}
  <div id="clubs-map"></div>

  {{#if content.countries}}
  {{! Countries only. A club total counts every recorded row, including legacy
      entries nobody has confirmed still exist, so it would read as the size of
      the active club network and the platform cannot know that. The country
      count is a claim about its own coverage, which it can. A count is
      supporting metadata, so it sits with the list it counts, not in the hero. }}
  {{#if content.totalCountries}}<p class="text-muted fs-sm">{{content.totalCountries}} countries</p>{{/if}}
  <ul class="club-country-index">
    {{#each content.countries}}
    <li class="club-country-index-entry">
      <a href="{{countryHref}}" class="club-country-index-link">
        {{country}}
      </a>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <div class="empty-state">No clubs found.</div>
  {{/if}}

</div>
