{{! One earlier year's blog posts: newest first, each a dated item card
    carrying its author, with the year navigation and the link back to the
    blog landing page. }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">
  <section>
    <div class="year-page-nav">
      {{#if navigation.siblings.previous}}
        <a href="{{navigation.siblings.previous.href}}" class="hero-year-arrow">&#8592; {{navigation.siblings.previous.label}}</a>
      {{else}}
        <span class="hero-year-arrow hero-year-arrow--disabled" aria-hidden="true">&#8592;</span>
      {{/if}}

      {{#if navigation.siblings.next}}
        <a href="{{navigation.siblings.next.href}}" class="hero-year-arrow">{{navigation.siblings.next.label}} &#8594;</a>
      {{else}}
        <span class="hero-year-arrow hero-year-arrow--disabled" aria-hidden="true">&#8594;</span>
      {{/if}}
    </div>

    <div class="card-grid" id="blog-posts">
      {{#each content.items}}{{> dated-item this}}{{/each}}
    </div>
  </section>

  {{> back-link}}
</div>
