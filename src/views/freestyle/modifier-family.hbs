{{!--
  Modifier-family teaching page — single template, per-modifier content.

  Design philosophy: this is a TEACHING SURFACE, not a symbolic report.
  Leads with the body and the mechanics; the cohort of tricks is supporting
  evidence, not the primary content. Coach-like prose; "the same idea on
  other bases" phrasing; observational-layer attribution preserved.

  Template is logic-light. All content pre-shaped in
  src/services/symbolicModifierEducation.ts.
--}}

<div class="hero hero-sm">
  <div>
    {{#if navigation.breadcrumbs}}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#each navigation.breadcrumbs}}
        {{#if href}}<a href="{{href}}">{{label}}</a> <span class="breadcrumb-sep">/</span> {{else}}<span>{{label}}</span>{{/if}}
      {{/each}}
    </nav>
    {{/if}}
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper longform-article">
  {{#if content}}
  <article class="content-section symbolic-modifier-family" aria-label="{{content.displayName}} modifier teaching page">

    {{> media-line id="media" display=content.mediaLine.display galleryHref=content.mediaLine.galleryHref galleryLabel=content.mediaLine.galleryLabel}}

    <p class="modifier-subtitle">{{content.pageSubtitle}}</p>

    {{#if content.workingModelNote}}
    <p>{{content.workingModelNote}}</p>
    {{/if}}

    {{#if content.baseAtom}}
    <p class="detail-muted">Base trick: <a href="{{content.baseAtom.href}}">{{content.baseAtom.label}}</a></p>
    {{/if}}

    {{#if content.definition}}
    {{!-- ── Concept-first frozen template (Definition / What changes / How it
          changes / Progression / Representative examples / Related concepts).
          ── --}}
    <section class="content-section" aria-label="What it is">
      <div class="section-heading"><h2>What it is</h2></div>
      <p>{{content.definition}}</p>
    </section>

    <section class="content-section" aria-label="How it changes the base trick">
      <div class="section-heading"><h2>How it changes the base trick</h2></div>
      <p>{{content.howItChangesBase}}</p>
    </section>

    <section class="content-section symbolic-walking-progression" aria-label="Progression {{content.progression.anchorBaseLabel}}">
      <div class="section-heading"><h2>Progression {{content.progression.anchorBaseLabel}}</h2></div>
      <ol class="progression-chain" role="list">
        {{#each content.progression.steps}}
        <li id="modifier-step-{{stepNumber}}-{{slug}}">
          <div class="step-header">
            <span class="step-number" aria-hidden="true">{{stepNumber}}</span>
            {{#if isPilot}}<a class="step-name" href="{{detailHref}}">{{canonicalName}}</a>{{else}}<span class="step-name">{{canonicalName}}</span>{{/if}}
            {{#if adds}}<span class="step-adds">{{adds}} ADD</span>{{/if}}
            <span class="step-modifier">{{modifierAdded}}</span>
          </div>
          <p class="step-rationale">{{rationale}}</p>
        </li>
        {{/each}}
      </ol>
    </section>

    <section class="content-section" aria-label="Representative examples">
      <div class="section-heading"><h2>Representative examples</h2></div>
      <p>{{content.crossBase.framingLine}}</p>
      <ul class="cross-base-list">
        {{#each content.crossBase.examples}}
        <li>
          <span class="cross-base-base">{{baseLabel}}</span>
          {{#if isPilot}}<a class="cross-base-name" href="{{detailHref}}">{{canonicalName}}</a>{{else}}<span class="cross-base-name">{{canonicalName}}</span>{{/if}}
          {{#if adds}}<span class="cross-base-adds">{{adds}} ADD</span>{{/if}}
        </li>
        {{/each}}
      </ul>
    </section>

    <section class="content-section" aria-label="Related concepts">
      <div class="section-heading"><h2>Related concepts</h2></div>
      <ul class="related-modifiers-list">
        {{#each content.relatedModifiers}}
        <li><span class="related-name">{{name}}</span>: {{prose}}</li>
        {{/each}}
      </ul>
      <p class="modifier-glossary-link"><a href="{{content.conceptsHref}}">Read more in Freestyle Concepts</a></p>
    </section>

    {{/if}}

  </article>
  {{else}}
  <section class="content-section">
    <p>This modifier-family page is temporarily unavailable.</p>
  </section>
  {{/if}}
</div>
