{{! /freestyle/glossary — the A–Z Glossary: one alphabetical list of freestyle
    terms, each a short definition plus an optional link to the page that
    explains it in depth. Chapter-length explanation is /freestyle/concepts. }}

<div class="hero hero-sm">
  <div>
    {{#if navigation.breadcrumbs}}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#each navigation.breadcrumbs}}
        {{#if href}}<a href="{{href}}">{{label}}</a> <span class="breadcrumb-sep">/</span> {{else}}<span>{{label}}</span>{{/if}}
      {{/each}}
    </nav>
    {{/if}}
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper glossary-page">

  {{! Where each of the three reference resources fits, so a newcomer can tell
      them apart from here: this page looks up terms, the dictionary finds
      tricks, Freestyle Concepts explains in depth. }}
  <p class="glossary-az-orientation">
    Looking for a trick rather than a term? Use the
    <a href="{{content.crossLinks.dictionaryHref}}">Trick Dictionary</a>. For the
    full explanation behind a term, read
    <a href="{{content.crossLinks.conceptsHref}}">Freestyle Concepts</a>; for the
    modifier and operator vocabulary, the
    <a href="{{content.crossLinks.operatorsHref}}">Operators &amp; Modifiers reference</a>.
  </p>

  <nav class="glossary-az-letter-nav" aria-label="Jump to letter">
    {{#each content.letterNav}}<a href="{{href}}">{{letter}}</a>{{/each}}
  </nav>

  {{#each content.letters}}
  <section class="glossary-az-letter" id="letter-{{letter}}" aria-labelledby="letter-heading-{{letter}}">
    <h2 class="glossary-az-letter-heading" id="letter-heading-{{letter}}">{{letter}}</h2>
    <dl class="glossary-term-list">
      {{#each entries}}
      {{#if isSee}}
      {{! A cross-reference: the word as a reader looks it up, pointing at the
          one entry that defines it. Lighter than a definition on purpose. }}
      <div class="glossary-az-entry glossary-az-see" id="{{anchorId}}">
        <dt>{{term}}</dt>
        <dd>see <a href="{{seeHref}}">{{seeTerm}}</a></dd>
      </div>
      {{else}}
      <div class="glossary-az-entry" id="{{anchorId}}">
        <dt>{{term}}{{#if hasAliases}} <span class="glossary-az-aliases">also: {{aliasText}}</span>{{/if}}</dt>
        <dd>
          {{definition}}
          {{#if hasMore}} <a href="{{moreHref}}">{{moreLabel}}</a>{{/if}}
        </dd>
      </div>
      {{/if}}
      {{/each}}
    </dl>
  </section>
  {{/each}}

  <p class="detail-muted">{{content.entryCount}} terms, {{content.crossReferenceCount}} cross-references.</p>
</div>
