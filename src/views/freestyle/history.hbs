{{! /freestyle/history — the encyclopedia's introduction: how freestyle became a language }}

<div class="hero hero-sm">
  <div>
    {{#if navigation.breadcrumbs}}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#each navigation.breadcrumbs}}
        {{#if href}}<a href="{{href}}">{{label}}</a> <span class="breadcrumb-sep">/</span> {{else}}<span>{{label}}</span>{{/if}}
      {{/each}}
    </nav>
    {{/if}}
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper longform-article">

  {{! ── Thesis + opening ─────────────────────────────────────────────── }}
  <section class="content-section">
    <p class="history-thesis">{{content.thesis}}</p>
    {{#each content.intro}}<p>{{this}}</p>{{/each}}
  </section>

  {{! ── The narrative, one section per idea, each evidence for the thesis.
      A section with a summaryLine is a closed chronological disclosure: its
      header carries the heading plus the one-line gist, so the arc reads
      without opening everything. Sections are independent details elements,
      never an exclusive accordion. A section without a summaryLine renders
      open as plain prose. }}
  {{#each content.sections}}
  {{#if summaryLine}}
  <details class="dict-tile" id="{{id}}">
    <summary class="dict-tile-summary">
      <h2 class="dict-tile-title">{{heading}}</h2>
      <span class="dict-tile-hint">{{summaryLine}}</span>
    </summary>
    <div class="dict-tile-body">
      <section class="content-section">
        {{#each paragraphs}}<p>{{this}}</p>{{/each}}
        {{#if links.length}}
        <div class="card-actions">
          {{#each links}}<a class="btn btn-outline" href="{{href}}">{{label}}</a>{{/each}}
        </div>
        {{/if}}
      </section>
    </div>
  </details>
  {{else}}
  <section id="{{id}}" class="content-section">
    <div class="section-heading">
      <h2>{{heading}}</h2>
    </div>
    {{#each paragraphs}}<p>{{this}}</p>{{/each}}
    {{#if links.length}}
    <div class="card-actions">
      {{#each links}}<a class="btn btn-outline" href="{{href}}">{{label}}</a>{{/each}}
    </div>
    {{/if}}
  </section>
  {{/if}}
  {{/each}}

  {{! ── Sources on this site ──────────────────────────────────────────── }}
  {{#if content.references.length}}
  <section class="content-section">
    <div class="section-heading">
      <h2>Where these facts come from</h2>
      <p class="section-intro">
        This history is drawn from the encyclopedia's own pages. Follow them for the fuller record.
      </p>
    </div>
    <div class="card-actions">
      {{#each content.references}}<a class="btn btn-outline" href="{{href}}">{{label}}</a>{{/each}}
    </div>
  </section>
  {{/if}}

  {{! ── Where to go next ──────────────────────────────────────────────── }}
  {{#if content.whereNext.length}}
  <section class="content-section">
    <div class="section-heading">
      <h2>Where to go next</h2>
    </div>
    <div class="card-actions">
      {{#each content.whereNext}}<a class="btn btn-outline" href="{{href}}">{{label}}</a>{{/each}}
    </div>
  </section>
  {{/if}}

</div>
