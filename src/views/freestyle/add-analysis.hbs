{{!--
  /freestyle/add-analysis — ADD Accounting & Analysis.

  Educational page explaining how ADD values are constructed mechanically:
  how brackets count, the scoring components, a few worked examples, and why
  sources sometimes disagree. Pure curator content via
  FREESTYLE_ADD_ANALYSIS_CONTENT; logic-light template; no client JS.
--}}

<div class="hero hero-sm">
  <div>
    {{#if navigation.breadcrumbs}}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#each navigation.breadcrumbs}}
        {{#if href}}<a href="{{href}}">{{label}}</a> <span class="breadcrumb-sep">/</span> {{else}}<span>{{label}}</span>{{/if}}
      {{/each}}
    </nav>
    {{/if}}
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper add-analysis-page">

  <p class="page-philosophy">{{content.philosophyParagraph}}</p>

  <section id="how-add-is-built" class="content-section">
    <div class="section-heading">
      <h2>How ADD is built</h2>
      <p class="section-intro">
        The ADD (Additional Degree of Difficulty) score counts the recognized
        structural components a trick is made of. It isn&rsquo;t a stylistic
        rating, and it is not a calibrated measure of execution difficulty.
      </p>
    </div>

    <p><strong>The bracket-count rule.</strong> {{content.bracketRuleNote}}</p>

    <div class="records-table-wrap" tabindex="0" role="region" aria-label="How ADD is built">
    <table class="data-table">
      <thead>
        <tr>
          <th>Component</th>
          <th>Typical contribution</th>
          <th>Example</th>
        </tr>
      </thead>
      <tbody>
        {{#each content.componentClasses}}
        <tr>
          <td>{{componentClass}}</td>
          <td>{{contribution}}</td>
          <td>{{example}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    </div>

    <p><strong>What &ldquo;spin&rdquo; means.</strong> {{content.spinNote}} <a href="/freestyle/modifier/spinning">See the spinning modifier page.</a></p>
    <p><strong>Stalls.</strong> {{content.delayNote}}</p>
    <p><strong>The X-Dex.</strong> {{content.xdexNote}} <a href="/freestyle/concepts#term-x-dex">See X-Dex in Freestyle Concepts.</a></p>
    <p><strong>Composite operators.</strong> {{content.compositeNote}}</p>
    <p><strong>Published ADD comes first.</strong> {{content.editorialTruthRule}}</p>
    <p class="add-analysis-callout"><strong>Honest incompleteness.</strong> {{content.incompletenessNote}}</p>
  </section>

  <section id="worked-examples" class="content-section">
    <div class="section-heading">
      <h2>Worked examples</h2>
      <p class="section-intro">Foundational moves first (1-3 ADD), then compounds. Each shows components, the explicit additive breakdown, and a one-line why. The breakdown line is the central pedagogy; it makes visible where each ADD comes from.</p>
    </div>

    <ol class="add-analysis-worked-examples">
      {{#each content.workedExamples}}
      <li class="add-analysis-worked-example">
        <h3 class="add-analysis-example-heading">
          {{#if trickSlug}}<a href="/freestyle/tricks/{{trickSlug}}">{{trickName}}</a>{{else}}{{trickName}}{{/if}}
          <span class="add-analysis-add-label">&middot; {{addLabel}}</span>
        </h3>
        <p class="add-analysis-components-line"><strong>Components:</strong> {{components}}</p>
        <p class="add-analysis-derivation-line"><strong>Breakdown:</strong> <code>{{derivation}}</code></p>
        <p class="add-analysis-why-line">{{whyNote}}</p>
      </li>
      {{/each}}
    </ol>
  </section>

  <section id="discrepancies" class="content-section">
    <div class="section-heading">
      <h2>ADD discrepancies: why they happen</h2>
      <p class="section-intro">
        Different sources count the same trick differently. None of these mean
        any source is &ldquo;wrong&rdquo;; they are differing interpretations
        or structural assumptions.
      </p>
    </div>

    {{#each content.closingParagraphs}}
    <p>{{this}}</p>
    {{/each}}
  </section>

  {{!-- Cross-references ───────────────────────────────────────────────── --}}
  {{#if content.crossLinks.length}}
  <nav class="add-analysis-cross-links" aria-label="Related pages">
    <h3>Where to go next</h3>
    <ul>
      {{#each content.crossLinks}}
      <li><a href="{{href}}">{{label}}</a></li>
      {{/each}}
    </ul>
  </nav>
  {{/if}}

  {{> back-link}}
</div>
