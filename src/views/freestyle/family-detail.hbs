{{!--
  Family detail page.
  One page per curated first-class trick family: what it is, why it matters,
  how to recognize one, its lowest-ADD example tricks, and related families.
  Any section whose source is absent is omitted, never rendered empty.
--}}
<div class="hero hero-sm">
  <div>
    {{#if navigation.breadcrumbs}}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#each navigation.breadcrumbs}}
        {{#if href}}<a href="{{href}}">{{label}}</a> <span class="breadcrumb-sep">/</span> {{else}}<span>{{label}}</span>{{/if}}
      {{/each}}
    </nav>
    {{/if}}
    <p class="hero-eyebrow">{{page.eyebrow}}</p>
    <h1>{{page.title}}</h1>
    {{#if content.teaching}}<p class="hero-subtitle">{{content.teaching.hook}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">
<article data-family-slug="{{content.slug}}" aria-label="{{content.displayName}} family">

  {{#if content.branchParent}}
  <p class="trick-family-branch-of mt-4">Branch of the <a href="{{content.branchParent.href}}">{{content.branchParent.name}}</a> family.</p>
  {{/if}}

  {{> media-line id="media" display=content.mediaLine.display galleryHref=content.mediaLine.galleryHref galleryLabel=content.mediaLine.galleryLabel}}

  {{#if content.teaching}}
  <section class="content-section" aria-label="What is {{content.displayArticle}} {{content.displayName}}">
    <div class="section-heading">
      <h2>What is {{content.displayArticle}} {{content.displayName}}?</h2>
    </div>
    {{#if content.teaching.plainLanguageReading}}
    <p class="section-intro">{{content.teaching.plainLanguageReading}}</p>
    {{/if}}
    <p>{{content.teaching.physicalDescription}}</p>
  </section>

  <section class="content-section" aria-label="Why it matters">
    <div class="section-heading">
      <h2>Why the {{content.displayName}} family matters</h2>
    </div>
    <p>{{content.teaching.importance}}</p>
  </section>
  {{else}}
  <section class="content-section" aria-label="What is {{content.displayArticle}} {{content.displayName}}">
    <div class="section-heading">
      <h2>What is {{content.displayArticle}} {{content.displayName}}?</h2>
    </div>
    <p>{{content.orientation}}</p>
  </section>
  {{/if}}

  {{#if content.exampleTricks.length}}
  <section class="content-section" aria-label="Example tricks">
    <div class="section-heading">
      <h2>Example tricks</h2>
      <span class="section-count">{{content.memberCount}}</span>
    </div>
    <ul class="set-detail-trick-list">
      {{#each content.exampleTricks}}
      <li class="set-detail-trick">
        <a href="{{href}}">{{displayName}}</a>
        <span class="set-detail-trick-add">({{addsLabel}})</span>
        {{#if mediaHref}}<a class="tag-chip tag-chip--sm" href="{{mediaHref}}" aria-label="Media for {{displayName}}">media</a>{{/if}}
      </li>
      {{/each}}
    </ul>
    <p class="mt-2"><a class="action-link" href="{{siteHref content.allTricksHref}}">See All Tricks in This Family</a></p>
  </section>
  {{/if}}

  {{#if content.teaching}}
  {{#if content.teaching.howToRecognize.length}}
  <section class="content-section" aria-label="How to recognize one">
    <div class="section-heading">
      <h2>How to recognize one</h2>
    </div>
    <ul class="family-teaching-list">
      {{#each content.teaching.howToRecognize}}
      <li>{{this}}</li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
  {{/if}}

  {{#if content.siblingFamilies.length}}
  <section class="content-section" aria-label="Related families">
    <div class="section-heading">
      <h2>Related families</h2>
    </div>
    <ul class="set-detail-link-list">
      {{#each content.siblingFamilies}}
      <li><a href="{{href}}">{{name}}</a></li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

</article>
</div>
