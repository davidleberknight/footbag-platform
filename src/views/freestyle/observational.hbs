{{!--
  /freestyle/observational — Emerging Vocabulary, organized by what each name
  actually waits on.

  Observational layer ONLY: a provisional ADD or breakdown is never canonical;
  entries name their source in words, carry no canonical hashtag, no
  detail-page link and no media. Four sections derived from the lifecycle
  model the generator stamps on every row (publicSection): waiting on a curator
  decision, waiting on a rules question (grouped by open question, each shown
  by its plain title and sentence, then the dictionary's own held-out tricks),
  needs evidence, and the names already resolved. Duplicate spellings of one
  identity render once; malformed and rejected rows never render. Every count
  comes from the generated data plus the live publication filter; the
  template computes nothing.
--}}
<div class="hero hero-sm">
  <div>
    {{#if navigation.breadcrumbs}}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#each navigation.breadcrumbs}}
        {{#if href}}<a href="{{href}}">{{label}}</a> <span class="breadcrumb-sep">/</span> {{else}}<span>{{label}}</span>{{/if}}
      {{/each}}
    </nav>
    {{/if}}
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper freestyle-observational">
  <section class="content-section">

    {{#if content.isEmpty}}
    <p class="observational-empty-state">
      Nothing here yet. The
      <a href="/freestyle/tricks">trick dictionary</a> lists the confirmed tricks.
    </p>
    {{else}}

    <p class="observational-layer-note">{{content.layerNote}}</p>

    {{! ── Section 1 — Waiting on a curator decision. Each group keeps its
        description, which states what still separates its names from the
        dictionary; the curator's recommendation and evidence live on the admin
        workbench. ── }}
    {{#if content.decideTotal}}
    <section class="observed-section" id="decide-now" aria-label="Waiting on a Curator Decision">
      <div class="section-heading">
        <h2>Waiting on a Curator Decision</h2>
        <span class="section-count">{{content.decideTotal}}</span>
      </div>
      <p class="observed-section-intro">
        These names are understood well enough to decide. Each waits for a curator to
        confirm it or set it aside.
      </p>
      {{#each content.decideClusters}}
      <div class="observed-eco-group" id="decision-{{id}}">
        <h3 class="observed-eco-heading">{{title}} <span class="text-muted">({{count}})</span></h3>
        <p class="observed-decision-question">{{question}}</p>
        {{#if cards.length}}
        <div class="observed-card-grid">
          {{#each cards}}{{> observed-card-fields}}{{/each}}
        </div>
        {{/if}}
        {{#if externalNames.length}}
        <ul class="observational-tracked-list">
          {{#each externalNames}}
          <li>{{name}}{{#if source}} <span class="tracked-tag">{{source}}</span>{{/if}}</li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
      {{/each}}
    </section>
    {{/if}}

    {{! ── Section 2 — Waiting on a rules question, then the dictionary's own
        tricks held out of its pages ── }}
    {{#if (or content.rulingTotal content.externalUnadjudicated.length)}}
    <section class="observed-section" id="waiting-on-a-ruling" aria-label="Waiting on a Rules Question">
      <div class="section-heading">
        <h2>Waiting on a Rules Question</h2>
        <span class="section-count">{{content.rulingTotal}}</span>
      </div>
      <p class="observed-section-intro">
        Each of these names depends on an open question about how a movement is defined
        or scored. Open a question to see the names its answer would settle.
      </p>
      {{#each content.questions}}
      <details class="observed-disclosure" id="question-{{id}}">
        <summary class="observed-disclosure-summary">{{title}} <span class="text-muted">({{unlockCount}} names)</span></summary>
        <p class="observed-question-text">{{question}}</p>
        <ul class="observational-tracked-list observed-fulllist-grid">
          {{#each names}}
          <li>{{name}}{{#if source}} <span class="tracked-tag">{{source}}</span>{{/if}}{{#if publishedTarget}} <span class="text-muted">already in the dictionary as {{publishedTarget}}; only this spelling is open</span>{{/if}}</li>
          {{/each}}
        </ul>
      </details>
      {{/each}}
      {{#if content.externalUnadjudicated.length}}
      <details class="observed-disclosure" id="held-out">
        <summary class="observed-disclosure-summary">Tricks Held Out of the Dictionary <span class="text-muted">({{content.externalUnadjudicated.length}})</span></summary>
        <ul class="observational-tracked-list">
          {{#each content.externalUnadjudicated}}
          <li>{{name}}{{#if source}} <span class="tracked-tag">{{source}}</span>{{/if}}</li>
          {{/each}}
        </ul>
      </details>
      {{/if}}
    </section>
    {{/if}}

    {{! ── Section 3 — Needs evidence ── }}
    {{#if content.evidenceRows.length}}
    <section class="observed-section" id="needs-evidence" aria-label="Needs Evidence">
      <div class="section-heading">
        <h2>Needs Evidence</h2>
        <span class="section-count">{{content.evidenceRows.length}}</span>
      </div>
      <p class="observed-section-intro">
        We cannot yet tell what movement these names describe. Each one says what would
        help.
      </p>
      <ul class="observational-tracked-list">
        {{#each content.evidenceRows}}
        <li>{{name}}{{#if source}} <span class="tracked-tag">{{source}}</span>{{/if}} <span>{{missing}}</span></li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    {{! ── Section 4 — Already resolved: names that need nothing further ── }}
    <section class="observed-section" id="documented-archive" aria-label="Already Resolved">
      <div class="section-heading">
        <h2>Already Resolved</h2>
        <span class="section-count">{{content.archiveTotal}}</span>
      </div>
      <p class="observed-section-intro">
        Names that need nothing further: other spellings of tricks already in the
        dictionary, and words that turned out to be sets or notation terms.
      </p>
      {{#if content.archiveRepresented.total}}
      <details class="observed-disclosure">
        <summary class="observed-disclosure-summary">Other Names for Dictionary Tricks <span class="text-muted">({{content.archiveRepresented.total}})</span></summary>
        {{> observed-summary-section section=content.archiveRepresented title="Other Names for Dictionary Tricks" anchor="archive-represented"}}
      </details>
      {{/if}}
      {{#if content.archiveObservational.total}}
      <details class="observed-disclosure">
        <summary class="observed-disclosure-summary">Community Names on Record <span class="text-muted">({{content.archiveObservational.total}})</span></summary>
        {{> observed-summary-section section=content.archiveObservational title="Community Names on Record" anchor="archive-observational"}}
      </details>
      {{/if}}
      {{#if content.archiveTerms.total}}
      <details class="observed-disclosure">
        <summary class="observed-disclosure-summary">Sets and Terms, Not Tricks <span class="text-muted">({{content.archiveTerms.total}})</span></summary>
        {{> observed-summary-section section=content.archiveTerms title="Sets and Terms, Not Tricks" anchor="archive-terms"}}
      </details>
      {{/if}}
    </section>

    {{/if}}

    <p class="observational-footer">
      Established tricks are in the <a href="{{content.dictionaryLink.href}}">{{content.dictionaryLink.label}}</a>.
      See also <a href="{{content.operatorsLink.href}}">{{content.operatorsLink.label}}</a>
      and <a href="{{content.addAnalysisLink.href}}">{{content.addAnalysisLink.label}}</a>.
    </p>
  </section>
  {{> back-link}}
</div>
