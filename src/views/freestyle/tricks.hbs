  {{! Collapsed curation-rationale disclosure; closed by default, native marker. }}
  <details class="browse-view-why">
    <summary>{{content.modifierWhyDisclosure.summary}}</summary>
    <div class="browse-view-why-body">
      {{#each content.modifierWhyDisclosure.paragraphs}}<p>{{this}}</p>{{/each}}
