  {{#each content.movementSystemView.axes}}
  <details class="content-section trick-movement-axis" id="{{anchorId}}">
    <summary class="trick-movement-axis-summary">
      <h2 class="trick-movement-axis-name">{{axisName}} <span class="section-count">{{cards.length}}</span></h2>
      <span class="movement-axis-definition">{{axisDefinition}}</span>
    </summary>
    {{! Secondary ADD bands: cards are ordered by ADD, each run gets a header. }}
    {{#each addBands}}
    <div class="trick-add-lineage">
      <h3 class="add-lineage-header">{{addLabel}}</h3>
      <div class="dict-trick-row-stack">
        {{#each cards}}
          {{> dictionary-trick-row}}
        {{/each}}
      </div>
    </div>
    {{/each}}
  </details>
  {{/each}}
  {{else}}
  <section class="content-section">
    <p class="detail-muted">
      <em>No tricks currently link to a Movement System modifier. As the
      dictionary expands, axis sections populate from
      <code>freestyle_trick_modifier_links</code>.</em>
    </p>
  </section>
  {{/if}}

  {{! ── Alternative surfaces. A browse section organized on one principle:
      what surface the bag is controlled on. Each group renders the shared
      dictionary-trick-row, so its rows match every other browse view (name
      + Trick Detail link + media hashtag, JOB and ADD on the second line). }}
  {{#if content.movementSystemView.alternativeSurfaces.groups.length}}
  <details class="content-section alt-surfaces" id="alt-surfaces" aria-label="Alternative surfaces">
    <summary class="trick-movement-axis-summary">
      <h2 class="trick-movement-axis-name">Alternative surfaces <span class="section-count">{{content.movementSystemView.alternativeSurfaces.groups.length}}</span></h2>
      <span class="movement-axis-definition">{{content.movementSystemView.alternativeSurfaces.intro}}</span>
    </summary>
    {{#each content.movementSystemView.alternativeSurfaces.groups}}
    <section class="alt-surface-group" id="{{slug}}">
      <h3 class="alt-surface-group-label">{{label}}</h3>
      <p class="alt-surface-group-note">{{note}}</p>
      <div class="dict-trick-row-stack">
        {{#each cards}}
          {{> dictionary-trick-row}}
        {{/each}}
      </div>
    </section>
    {{/each}}
  </details>
  {{/if}}
  {{/if}}

  {{! The list runs long, so the foot of the page offers the way back up
      rather than provenance the reader needed before they started reading. }}
  <p class="dict-back-to-top"><a class="btn btn-outline" href="#dictionary-top">{{content.backToTopLabel}}</a></p>

</div>
