{{! /freestyle/tricks — trick dictionary index }}

<div class="hero hero-sm">
  <div>
    {{#if navigation.breadcrumbs}}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#each navigation.breadcrumbs}}
        {{#if href}}<a href="{{href}}">{{label}}</a> <span class="breadcrumb-sep">/</span> {{else}}<span>{{label}}</span>{{/if}}
      {{/each}}
    </nav>
    {{/if}}
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">

  {{! ── Size of the subset in view: the family filter's M-of-N, or the ADD
      tier's own count. The unfiltered dictionary opens on orientation, not a
      total. ── }}
  {{#if content.headerCount}}<p class="dict-header-count">{{content.headerCount}}</p>{{/if}}

  {{! ── Actions card: the two things a reader can DO from here, on one row.
      Search submits to the dedicated search page (typeahead lives there) and
      works without JS; Watch Videos leaves for the freestyle media hub, so it
      is a button, not a tile that looks like it would open in place. ── }}
  <div class="card search-box-card mt-5" id="dictionary-top">
    <div class="search-box-section">
      <h2 class="card-title">{{content.searchSection.heading}}</h2>
      <form method="GET" action="/freestyle/search" class="search-box-form" role="search">
        <input type="text" name="q" minlength="2" maxlength="100"
               placeholder="Name or alias"
               aria-label="Search tricks by name or alias"
               title="Search tricks by name or alias"
               autocomplete="off"
               class="search-box-input" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
      <a class="btn btn-outline" href="{{content.watchVideosButton.href}}">{{content.watchVideosButton.label}}</a>
    </div>
  </div>

  {{! ── Orientation tiles: one wrapping row of two closed disclosures holding
      the beginner links and the how-tricks-are-built primer, ordered beginner
      to expert. Every tile in the row
      behaves the same way (opens in place, independently, nothing persists),
      so the row carries no control that navigates away. An open tile stretches
      to the full row and the rest reflow. Default landing only: secondary
      views and the family filter carry their own state-specific
      orientation. ── }}
  {{#if (eq content.activeView "add")}}
  {{#unless content.activeFamily}}
  {{#unless content.isAddTierView}}
  <div class="dict-tile-grid">
    <details class="dict-tile">
      <summary class="dict-tile-summary">
        <span class="dict-tile-title">{{content.landingTiles.start.title}}</span>
        <span class="dict-tile-hint">{{content.landingTiles.start.hint}}</span>
      </summary>
      <div class="dict-tile-body">
        {{! Each of these is a destination that must read as important without
            being a button, which is the prominent-action-link tier; as
            dot-separated prose links they read as running text instead. }}
        <div class="dict-onboarding-links">
          {{#each content.landingOnboarding.links}}<a class="action-link" href="{{href}}">{{label}}</a>{{/each}}
        </div>
      </div>
    </details>
    <details class="dict-tile">
      <summary class="dict-tile-summary">
        <span class="dict-tile-title">{{content.landingTiles.built.title}}</span>
        <span class="dict-tile-hint">{{content.landingTiles.built.hint}}</span>
      </summary>
      <div class="dict-tile-body">
        {{#each content.landingOnboarding.intro}}<p class="dict-onboarding-intro">{{this}}</p>{{/each}}
        {{#if content.landingOnboarding.definitions.length}}
        <dl class="dict-onboarding-defs">
          {{#each content.landingOnboarding.definitions}}<div class="dict-onboarding-def"><dt>{{term}}</dt><dd>{{plain}}</dd></div>{{/each}}
        </dl>
        {{/if}}
        <p class="dict-onboarding-example">
          <span class="dict-onboarding-example-label">{{content.landingOnboarding.example.label}}:</span>
          {{#each content.landingOnboarding.example.steps}}<span class="dict-onboarding-step"><strong>{{name}}</strong> <span class="dict-onboarding-step-note">{{note}}</span></span>{{#unless @last}} <span class="dict-onboarding-arrow">&rarr;</span> {{/unless}}{{/each}}
        </p>
        <ul class="dict-onboarding-lenses">
          {{#each content.landingOnboarding.lenses}}<li><strong>{{label}}</strong> <span class="dict-onboarding-lens-note">{{note}}</span></li>{{/each}}
        </ul>
      </div>
    </details>
  </div>
  {{/unless}}
  {{/unless}}
  {{/if}}

  {{#if content.activeFamily}}
  <p class="browse-view-intro">{{content.familyFilterIntro}}
    <a href="/freestyle/tricks">Clear the filter</a> to see the full dictionary.</p>
  {{#if content.relatedModifierGroups.length}}
  <nav class="related-modifier-groups" aria-label="Related set or modifier groups">
    <span class="related-modifier-groups-label">Related set/modifier groups:</span>
    {{#each content.relatedModifierGroups}}
      <a href="{{{href}}}">{{modifierName}} <span class="related-modifier-group-count">({{count}})</span></a>{{#unless @last}} <span class="related-modifier-group-sep">·</span> {{/unless}}
    {{/each}}
  </nav>
  {{/if}}
  {{/if}}

  {{! ── Browse navigation, gathered into one titled card so the three control
      rows (which view, how each tier sorts, and where to jump) read as one
      thing rather than three loose lines. "By ADD" is the default; the other
      systems are secondary ways to navigate the same movement universe. No
      JavaScript; view selected via the ?view= query param. ── }}
  <div class="card dict-nav-card">
    <h2 class="card-title">{{content.navSection.heading}}</h2>
  {{! Each entry carries the lens question as its title, so what an axis is FOR
      arrives on hover and focus instead of costing a line of layout. }}
  <nav class="trick-view-toggle" aria-label="Browse the dictionary">
    <span class="dict-nav-label">{{content.navSection.viewLabel}}</span>
    {{#if (eq content.activeView "add")}}
      <span title="{{content.navSection.viewTitles.add}}" aria-current="page" class="trick-view-toggle-active">By ADD</span>
    {{else}}
      <a title="{{content.navSection.viewTitles.add}}" href="/freestyle/tricks?view=add">By ADD</a>
    {{/if}}
    <span class="trick-view-toggle-sep">·</span>
    {{#if (eq content.activeView "family")}}
      <span title="{{content.navSection.viewTitles.family}}" aria-current="page" class="trick-view-toggle-active">By family</span>
    {{else}}
      <a title="{{content.navSection.viewTitles.family}}" href="/freestyle/tricks?view=family">By family</a>
    {{/if}}
    <span class="trick-view-toggle-sep">·</span>
    {{#if (eq content.activeView "set")}}
      <span title="{{content.navSection.viewTitles.set}}" aria-current="page" class="trick-view-toggle-active">By set</span>
    {{else}}
      <a title="{{content.navSection.viewTitles.set}}" href="/freestyle/tricks?view=set">By set</a>
    {{/if}}
    <span class="trick-view-toggle-sep">·</span>
    {{#if (eq content.activeView "modifier")}}
      <span title="{{content.navSection.viewTitles.modifier}}" aria-current="page" class="trick-view-toggle-active">By modifier</span>
    {{else}}
      <a title="{{content.navSection.viewTitles.modifier}}" href="/freestyle/tricks?view=modifier">By modifier</a>
    {{/if}}
  </nav>
  {{! Reference surfaces that are NOT dictionary browse axes, so they never
      belong in the View row above. This carried the browse grid's two
      cross-links, which is why it now renders on every view rather than only
      the secondary ones. }}
  <p class="trick-view-toggle-aside">New to the dictionary? Look up a term in the <a href="/freestyle/glossary">Glossary</a> or read the <a href="/freestyle/concepts">Freestyle Concepts</a> chapters. Modifier and operator vocabulary is in the <a href="/freestyle/operators">Operators &amp; Modifiers reference</a>, and set systems are in the <a href="/freestyle/sets">Set Encyclopedia</a>.</p>

  {{#if (eq content.activeView "add")}}
  {{! Within-tier browse mode: Alphabetical (default, flat A-Z for lookup) or
      By family (nearest-anchor family bands in public-family order). Selected
      via ?sort=; server-rendered, no JavaScript. }}
  <nav class="trick-view-toggle" aria-label="Sort within each ADD tier">
    <span class="dict-nav-label">{{content.navSection.sortLabel}}</span>
    {{#if (eq content.addSort "alpha")}}
      <a href="{{{content.addSortToggle.familyHref}}}">By family</a>
      <span class="trick-view-toggle-sep">·</span>
      <span aria-current="true" class="trick-view-toggle-active">Alphabetical</span>
    {{else}}
      <span aria-current="true" class="trick-view-toggle-active">By family</span>
      <span class="trick-view-toggle-sep">·</span>
      <a href="{{{content.addSortToggle.alphaHref}}}">Alphabetical</a>
    {{/if}}
  </nav>
  {{#if content.addJumpChips.length}}
  <nav class="jump-bar" aria-label="Browse by ADD level">
    <span class="jump-bar-label">ADD levels:</span>
    {{#each content.addJumpChips}}
      <a href="{{{href}}}">{{label}}</a>{{#unless @last}} <span class="jump-bar-sep">·</span> {{/unless}}
    {{/each}}
  </nav>
  {{/if}}
  {{/if}}
  </div>

  {{! ── Default ADD-grouped view — two-line row contract.
       Every row: line 1 = name/hashtag/≡interpretation/media; line 2 =
       JOB: + ADD:. No green ADD chip (the value is in the section header
       + the line-2 ADD: formula). See dictionary-trick-row.hbs. }}
  {{#if (eq content.activeView "add")}}
  {{#each content.addGroups}}
  <section class="content-section trick-add-group" id="{{anchorId}}">
    <div class="section-heading">
      <h2>{{addLabel}}</h2>
      <span class="section-count">{{countLabel}}</span>
    </div>
    {{#if (eq @root.content.addSort "alpha")}}
    {{! Alphabetical: flat A-Z across the whole tier, by canonical name. }}
    <ul class="dict-trick-row-stack" role="list">
      {{#each cards}}
        {{> dictionary-trick-row}}
      {{/each}}
    </ul>
    {{else}}
    {{! By family: nearest-anchor family bands in public-family order; the
        "Other / standalone tricks" band trails, alphabetized. Family parents
        / minor lineages only — no surface/root buckets. }}
    {{#each lineageBands}}
    <div class="trick-add-lineage">
      <h3 class="add-lineage-header">{{rootLabel}}</h3>
      <ul class="dict-trick-row-stack" role="list">
        {{#each cards}}
          {{> dictionary-trick-row}}
        {{/each}}
      </ul>
    </div>
    {{/each}}
    {{/if}}
  </section>
  {{/each}}
  {{/if}}

  {{! ── By modifier view — modifier-grouped trick lists (answers "which
       tricks use this modifier?"). The launch sets browse at ?view=set; the
       Set Encyclopedia at /freestyle/sets stays the set-definition surface.
       Clusters organize the sections; each modifier is its own subsection
       with a modifier-{slug} anchor, and the jump index lists every rendered
       modifier so common ones (paradox, symposium) are one click away. }}
  {{#if (eq content.activeView "modifier")}}
  {{#if content.modifierIntro}}<p class="browse-view-intro">{{content.modifierIntro}} For the launch sets, use <a href="/freestyle/tricks?view=set">By set</a>. For what a set system actually is, see the <a href="/freestyle/sets">Set Encyclopedia</a>.</p>{{/if}}
  {{#if content.modifierScale}}<p class="browse-view-scale">{{content.modifierScale}}</p>{{/if}}
  {{! Collapsed curation-rationale disclosure; closed by default, native marker. }}
  <details class="browse-view-why">
    <summary>{{content.modifierWhyDisclosure.summary}}</summary>
    <div class="browse-view-why-body">
      {{#each content.modifierWhyDisclosure.paragraphs}}<p>{{this}}</p>{{/each}}
      <p>The broader modifier and operator vocabulary lives in the <a href="/freestyle/operators">Operators &amp; Modifiers reference</a>.</p>
    </div>
  </details>
  {{#if content.modifierClusterView.length}}

  <nav class="jump-bar jump-bar--inline" aria-label="Modifier jump">
    {{#each content.modifierJumpIndex}}
      <a href="{{anchor}}">{{name}} ({{count}})</a>{{#unless @last}} <span class="jump-bar-sep">·</span> {{/unless}}
    {{/each}}
  </nav>

  {{#each content.modifierClusterView}}
  <section class="content-section trick-modifier-cluster-section" id="cluster-{{key}}">
    <div class="section-heading">
      <h2>{{label}}</h2>
      <span class="section-count">{{trickCount}}</span>
    </div>
    <p class="modifier-cluster-blurb detail-muted">{{blurb}}</p>
    {{#each groups}}
    <section class="trick-modifier-group" id="modifier-{{slug}}">
      <div class="section-heading">
        <h3><a href="{{{href}}}">{{name}}</a></h3>
        <span class="section-count">{{trickCount}}</span>
      </div>
      <ul class="dict-trick-row-stack" role="list">
        {{#each cards}}
          {{> dictionary-trick-row}}
        {{/each}}
      </ul>
    </section>
    {{/each}}
  </section>
  {{/each}}
  {{else}}
  <section class="content-section">
    <div class="empty-state"><p>No tricks are listed by modifier yet.</p></div>
  </section>
  {{/if}}

  {{! Compact band for linked groups outside the first-class roster: name and
      count only, each linking to the reference surface that documents it. }}
  {{#if content.modifierOtherGroups.length}}
  <section class="content-section trick-minor-lineage-band" id="modifier-other-groups" aria-label="Other tracked groups">
    <div class="section-heading">
      <h2>Other tracked groups</h2>
      <span class="section-count">{{content.modifierOtherGroups.length}}</span>
    </div>
    <p class="trick-minor-lineage-intro">Tracked groups without full browse sections. Their placement is an editorial classification rather than a threshold based on the number of tricks.</p>
    <ul class="trick-minor-lineage-list">
      {{#each content.modifierOtherGroups}}
      <li>{{#if href}}<a href="{{href}}">{{name}}</a>{{else}}{{name}}{{/if}} <span class="trick-minor-lineage-count">{{count}}</span></li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
  {{/if}}

  {{! ── By set view — the set / uptime systems as first-class sections
      ("which tricks begin with this set?"). Split from the modifier view
      along the set-uptime cluster seam; body and timing operators stay in
      ?view=modifier, and the Set Encyclopedia at /freestyle/sets remains the
      set-definition reference. Same two-line row contract as the other
      row-density views. }}
  {{#if (eq content.activeView "set")}}
  {{#if content.setViewIntro}}<p class="browse-view-intro">{{content.setViewIntro}} The <a href="/freestyle/sets">Set Encyclopedia</a> holds the full set vocabulary and what each set is. For body and timing operators, use <a href="/freestyle/tricks?view=modifier">By modifier</a>.</p>{{/if}}
  {{#if content.setScale}}<p class="browse-view-scale">{{content.setScale}}</p>{{/if}}
  {{! Collapsed curation-rationale disclosure; closed by default, native marker. }}
  <details class="browse-view-why">
    <summary>{{content.setWhyDisclosure.summary}}</summary>
    <div class="browse-view-why-body">
      {{#each content.setWhyDisclosure.paragraphs}}<p>{{this}}</p>{{/each}}
      <p>The <a href="/freestyle/sets">Set Encyclopedia</a> covers the complete set vocabulary.</p>
    </div>
  </details>
  {{#if content.setViewGroups.length}}
  <nav class="jump-bar jump-bar--inline" aria-label="Set jump">
    {{#each content.setViewGroups}}
      <a href="#set-{{slug}}">{{label}}</a>{{#unless @last}} <span class="jump-bar-sep">·</span> {{/unless}}
    {{/each}}
  </nav>

  {{#each content.setViewGroups}}
  <section class="content-section trick-set-group" id="set-{{slug}}">
    <div class="section-heading">
      <h2><a href="{{{href}}}">{{label}}</a></h2>
      <span class="section-count">{{trickCount}}</span>
    </div>
    <ul class="dict-trick-row-stack" role="list">
      {{#each cards}}
        {{> dictionary-trick-row}}
      {{/each}}
    </ul>
  </section>
  {{/each}}
  {{else}}
  <section class="content-section">
    <div class="empty-state"><p>No tricks are listed by set yet.</p></div>
  </section>
  {{/if}}
  {{/if}}

  {{! ── Family view — two-line row contract.
      Same generalized dictionary-trick-row partial as the ADD view; only the
      grouping (family sections + family-anchor sublabel) differs. }}
  {{#if (eq content.activeView "family")}}
  {{#if content.familyViewIntro}}
  <p class="browse-view-intro">{{content.familyViewIntro}}</p>
  {{/if}}
  <p class="family-view-ordering-note"><em>Families are listed in the dictionary's canonical order: the root families first, then the derived branch families (torque and blender under osis; double legover and eggbeater under legover).</em></p>
  {{#if content.familyScale}}<p class="browse-view-scale">{{content.familyScale}}</p>{{/if}}
  {{! Collapsed curation-rationale disclosure; closed by default, native marker. }}
  <details class="browse-view-why">
    <summary>{{content.familyWhyDisclosure.summary}}</summary>
    <div class="browse-view-why-body">
      {{#each content.familyWhyDisclosure.paragraphs}}<p>{{this}}</p>{{/each}}
    </div>
  </details>
  {{! Family jump index. Static hash-anchor chips (no JS), grouped into root
      families and derived branch families, plus a link to the minor-lineages
      band. Lets readers skip between family sections without scrolling. }}
  {{#if content.familyJumpIndex.roots.length}}
  <nav class="jump-bar jump-bar--wide" aria-label="Jump to family">
    <span class="jump-bar-label">Root families:</span>
    {{#each content.familyJumpIndex.roots}}
      <a href="{{anchor}}">{{name}} <span class="jump-bar-count">{{count}}</span></a>{{#unless @last}} <span class="jump-bar-sep">·</span> {{/unless}}
    {{/each}}
    {{#if content.familyJumpIndex.branches.length}}
    <span class="jump-bar-label jump-bar-label--branch">Derived / branch:</span>
    {{#each content.familyJumpIndex.branches}}
      <a href="{{anchor}}">{{name}} <span class="jump-bar-count">{{count}}</span></a>{{#unless @last}} <span class="jump-bar-sep">·</span> {{/unless}}
    {{/each}}
    {{/if}}
    {{#if content.familyJumpIndex.hasMinorLineages}}
    <span class="jump-bar-label jump-bar-label--minor">Minor lineages:</span>
    <a href="#minor-lineages">All minor lineages</a>
    {{/if}}
  </nav>
  {{/if}}
  {{#if content.familyGroups.length}}
  {{#each content.familyGroups}}
  <section class="content-section trick-family-group" id="family-{{familySlug}}">
    <div class="section-heading">
      <h2><a href="{{{familyHref}}}">{{familyName}} family</a></h2>
      <span class="section-count">{{cards.length}}</span>
    </div>
    {{#if branchParentName}}
    <p class="trick-family-branch-of">Branch of the {{branchParentName}} family.</p>
    {{/if}}
    {{! Family-anchor sub-label. Names
        the canonical family-anchor trick so readers connect the
        glossary's "family-anchor trick" vocabulary to the dictionary
        surface. The name links to the family page when one exists (the
        primary explanation of the family), otherwise to the anchor trick. }}
    <p class="trick-family-anchor-sublabel"><span class="trick-family-anchor-label">Family-anchor:</span> {{#if familyAnchorHref}}<a href="{{familyAnchorHref}}">{{familyName}}</a>{{else}}{{familyName}}{{/if}}</p>
    {{! Family-level shared-terminal-structure invariant. Curator-authored per
        family slug; rendered between the heading and the card stack.
        Source: src/content/freestyleFamilyInvariants.ts. }}
    {{#if sharedStructure}}
    <p class="trick-family-shared-structure">Shared terminal structure: <code>{{sharedStructure}}</code></p>
    {{/if}}
    {{#if crossLink}}
    <p class="trick-family-cross-link"><a href="{{crossLink.href}}">{{crossLink.label}}</a></p>
    {{/if}}
    {{! Operator-rung bands: simplest/base forms first, then 1-, 2-, 3+-operator
        forms. Band headers show only when a family spans more than one rung
        (showRungLabels), so single-rung families stay header-free. }}
    {{#each rungGroups}}
    <div class="trick-family-rung">
      {{#if ../showRungLabels}}<h3 class="family-rung-header">{{label}}</h3>{{/if}}
      <ul class="dict-trick-row-stack" role="list">
        {{#each cards}}
          {{> dictionary-trick-row}}
        {{/each}}
      </ul>
    </div>
    {{/each}}
  </section>
  {{/each}}
  {{/if}}
  {{#if content.minorLineages.length}}
  <section class="content-section trick-minor-lineage-band" id="minor-lineages" aria-label="Minor lineages">
    <div class="section-heading">
      <h2>Minor lineages</h2>
      <span class="section-count">{{content.minorLineages.length}}</span>
    </div>
    <p class="trick-minor-lineage-intro">Additional curated lineages appear in the family view but do not have their own standalone family pages. Their placement is an editorial classification rather than a threshold based on the number of tricks.</p>
    <ul class="trick-minor-lineage-list">
      {{#each content.minorLineages}}
      <li><a href="{{{href}}}">{{name}}</a> <span class="trick-minor-lineage-count">{{count}}</span></li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
  {{/if}}

  {{! The list runs long, so the foot of the page offers the way back up
      rather than provenance the reader needed before they started reading. }}
  <p class="dict-back-to-top"><a class="btn btn-outline" href="#dictionary-top">{{content.backToTopLabel}}</a></p>

</div>
