{{! /freestyle/by-the-numbers — histogram cards summarizing how the dictionary
    distributes across difficulty, dexterity, entry, family ending, and body
    movement. A card whose dimension a dictionary view groups by links to that
    view and carries a Browse label; a summary-only card (dexterity, which no
    view groups by) renders the same histogram with no link and no label. }}

<div class="hero hero-sm">
  <div>
    {{#if navigation.breadcrumbs}}
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#each navigation.breadcrumbs}}
        {{#if href}}<a href="{{href}}">{{label}}</a> <span class="breadcrumb-sep">/</span> {{else}}<span>{{label}}</span>{{/if}}
      {{/each}}
    </nav>
    {{/if}}
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">

  <section>
    <div class="by-numbers-grid">
      {{#each content.cards}}
      {{#if href}}<a class="by-numbers-card" href="{{{href}}}">{{else}}<div class="by-numbers-card">{{/if}}
        <span class="by-numbers-eyebrow">{{eyebrow}}</span>
        <span class="by-numbers-title">{{title}}</span>
        <span class="by-numbers-bars">
          {{#each bars}}
          <span class="by-numbers-bar">
            <span class="by-numbers-bar-label">{{label}}</span>
            <span class="by-numbers-bar-track"><span class="by-numbers-bar-fill gloss-bar-fill--w{{widthBucket}}"></span></span>
            <span class="by-numbers-bar-count">{{count}}</span>
          </span>
          {{/each}}
        </span>
        {{#if footnote}}<span class="by-numbers-footnote">{{footnote}}</span>{{/if}}
        {{#if href}}<span class="by-numbers-cta">Browse</span>
      </a>{{else}}</div>{{/if}}
      {{/each}}
    </div>
    <p class="text-muted fs-sm mt-4">{{content.note}}</p>
  </section>

</div>
