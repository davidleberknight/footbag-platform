    <h3 class="section-heading">Other foundational atoms</h3>
    <p class="detail-muted">
      The atoms that are not family roots: the two foundational stalls (toe and
      clipper) and the two entry movements used within tricks (around-the-world
      and orbit).
    </p>
    {{> core-tricks-grid tricks=content.otherFoundationalAtoms idPrefix="term-"}}

    {{#if content.familyTrees.length}}
    <details class="glossary-family-card-observational">
      <summary class="glossary-family-card-observational-summary">
        <span class="glossary-family-card-observational-title">Family-tree visualizations (4 pilot families)</span>
        <span class="glossary-layer-badge glossary-layer-badge--advanced">advanced</span>
      </summary>
      <div class="glossary-family-trees">
        {{#each content.familyTrees}}
        <div class="glossary-family-tree" id="family-tree-{{anchorSlug}}">
