{{! /records — WFA Consecutive Kicks Records }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">

  {{#if content.worldRecords}}
  <section class="content-section">
    <div class="section-heading"><h2>Current World Records</h2></div>
    <div class="records-table-wrap" tabindex="0" role="region" aria-label="Current World Records">
      <table class="data-table">
        <thead>
          <tr>
            <th>Discipline</th>
            <th>Holder(s)</th>
            <th class="col-num">Kicks</th>
            <th>Event</th>
            <th>Date</th>
            <th>Location</th>
          </tr>
        </thead>
        <tbody>
          {{#each content.worldRecords}}
          <tr>
            <td>{{discipline}}</td>
            <td class="col-holder">
              {{player_1}}{{#if player_2}} &amp; {{player_2}}{{/if}}
            </td>
            <td class="col-num">{{scoreFormatted}}</td>
            <td>{{#if eventName}}{{eventName}}{{else}}&mdash;{{/if}}</td>
            <td class="col-date">{{#if eventDate}}{{formatDateRange eventDate}}{{else}}&mdash;{{/if}}</td>
            <td>{{#if location}}{{location}}{{else}}&mdash;{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
  {{/if}}

  {{#if content.highestScores}}
  <section class="content-section">
    <div class="section-heading"><h2>Highest Official Scores</h2></div>
    {{#each content.highestScores}}
    <h3 class="content-subheading">{{subsection}}</h3>
    <div class="records-table-wrap" tabindex="0" role="region" aria-label="{{subsection}}">
      <table class="data-table">
        <thead>
          <tr>
            <th class="col-rank">#</th>
            <th>Player(s)</th>
            <th>Discipline</th>
            <th class="col-num">Kicks</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr>
            <td class="col-rank">{{rank}}</td>
            <td class="col-holder">
              {{player_1}}{{#if player_2}} &amp; {{player_2}}{{/if}}
            </td>
            <td>{{discipline}}</td>
            <td class="col-num">{{scoreFormatted}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{#each footnotes}}<p class="mt-2">{{this}}</p>{{/each}}
    {{/each}}
  </section>
  {{/if}}

  {{#if content.progression}}
  <section class="content-section">
    <div class="section-heading"><h2>World Record Progression</h2></div>
    {{#each content.progression}}
    <h3 class="content-subheading">{{subsection}}</h3>
    <div class="records-table-wrap" tabindex="0" role="region" aria-label="{{subsection}}">
      <table class="data-table">
        <thead>
          <tr>
            <th class="col-year">Year</th>
            <th>Holder(s)</th>
            <th class="col-num">Kicks</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr>
            <td class="col-year">{{#if year}}{{year}}{{else}}&mdash;{{/if}}</td>
            <td class="col-holder">
              {{player_1}}{{#if player_2}} &amp; {{player_2}}{{/if}}
            </td>
            <td class="col-num">{{scoreFormatted}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{#each footnotes}}<p class="mt-2">{{this}}</p>{{/each}}
    {{/each}}
  </section>
  {{/if}}

  {{#if content.milestones}}
  <section class="content-section">
    <div class="section-heading"><h2>Milestone Firsts</h2></div>
    <p class="section-desc">First player to reach each milestone kick count.</p>
    {{#each content.milestones}}
    <h3 class="content-subheading">{{subsection}}</h3>
    <div class="records-table-wrap" tabindex="0" role="region" aria-label="{{subsection}}">
      <table class="data-table">
        <thead>
          <tr>
            <th>Player(s)</th>
            <th>Discipline</th>
            <th class="col-num">Milestone</th>
          </tr>
        </thead>
        <tbody>
          {{#each rows}}
          <tr>
            <td class="col-holder">
              {{player_1}}{{#if player_2}} &amp; {{player_2}}{{/if}}
            </td>
            <td>{{discipline}}</td>
            <td class="col-num">{{scoreFormatted}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{#each footnotes}}<p class="mt-2">{{this}}</p>{{/each}}
    {{/each}}
  </section>
  {{/if}}

  {{! The passback records live on the freestyle records page; repeating them
      here would put the same 160-odd rows on two pages. }}
  <section class="content-section">
    <div class="section-heading"><h2>Freestyle Passback Records</h2></div>
    <p>The record for each freestyle trick is listed with the trick records.</p>
    <a href="/freestyle/records" class="action-link">See All Trick Records</a>
  </section>

  <p class="source-note">Consecutive kicks records sanctioned by the World Footbag Association (WFA).</p>

</div>
