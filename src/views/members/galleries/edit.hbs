{{!-- Member's own gallery edit form. Owner-only view. --}}
<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <p>
    Editing your gallery. Items appear here when they carry every
    <strong>criteria tag</strong> and no <strong>exclude tag</strong>.
    Leave criteria empty to show everything you have uploaded.
  </p>

  <p>
    Need to add new photos? <a href="{{content.uploadMediaHref}}">Upload more media</a>,
    then return here to attach them to this gallery.
  </p>

  {{> gallery-edit-form
      formAction=content.formAction
      gallery=content.gallery
      errorMessage=content.errorMessage
      fieldErrors=content.fieldErrors
      cancelHref=content.cancelHref
      currentItems=content.currentItems
      currentItemsTruncated=content.currentItemsTruncated
      uploadTags=content.uploadTags
      externalLinkSlots=content.externalLinkSlots
  }}
</div>
<script src="{{{asset 'js/tag-chips.js'}}}" defer></script>
