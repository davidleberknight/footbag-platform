{{!-- Member's own gallery edit form. Owner-only view. Nothing is uploaded
      here: the share link opens the Share Media form with this gallery's
      hashtags filled in. --}}
<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <p>{{content.intro}}</p>

  <p><a href="{{{content.shareWithTagsHref}}}" class="action-link">Share Media With These Hashtags</a></p>

  {{> gallery-edit-form
      formAction=content.formAction
      gallery=content.gallery
      errorMessage=content.errorMessage
      fieldErrors=content.fieldErrors
      cancelHref=content.cancelHref
      currentItems=content.currentItems
      currentItemsTruncated=content.currentItemsTruncated
      externalLinkSlots=content.externalLinkSlots
  }}
</div>
{{> fold-token-script}}
<script src="{{{asset 'js/tag-chips.js'}}}" defer></script>
