{{!-- Member's own named-gallery list. Owner-only view. --}}
<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <p>
    Your media collections. A gallery is a saved view of your photos and videos
    that match a set of hashtags. Items appear when they carry every required
    tag, and none of the excluded tags.
  </p>

  {{#if content.benefitNotice}}
    {{> _tier-benefit-notice notice=content.benefitNotice}}
  {{else}}
    <p>
      <a href="{{content.uploadMediaHref}}" class="btn btn-primary">Upload Media</a>
      <a href="{{content.newGalleryHref}}" class="btn btn-outline">Create New Gallery</a>
    </p>
  {{/if}}

  {{! A write this page refused states why here. Without it the list simply
      re-appears and the member is left to guess what happened. }}
  {{> outcome-notice text=content.errorMessage tone='no'}}
  {{> outcome-notice text=content.savedMessage tone='ok'}}

  {{#if content.galleries.length}}
    {{! Seven columns including two tag lists and the row actions. Scrolls
        inside its own container so the page body never does, and so the
        controls at the end of each row stay reachable at phone width. }}
    <div class="records-table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Sort order</th>
          <th>Criteria tags</th>
          <th>Exclude tags</th>
          <th>Items</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {{#each content.galleries}}
          <tr>
            <td>{{name}}</td>
            <td>{{description}}</td>
            <td><code>{{sortOrder}}</code></td>
            <td>
              {{#each criteriaTags}}
                <code class="tag-chip">{{this}}</code>
              {{/each}}
            </td>
            <td>
              {{#each excludeTags}}
                <code class="tag-chip">{{this}}</code>
              {{else}}
                <span class="text-muted">(none)</span>
              {{/each}}
            </td>
            <td>{{itemCount}}</td>
            <td>
              {{! Without the benefits the row keeps its read and loses its
                  write controls. The notice above the table says why once,
                  rather than repeating itself on every row. }}
              {{#unless ../content.benefitNotice}}<a href="{{editHref}}">Edit</a>{{/unless}}
              <a href="/media/{{id}}" target="_blank" rel="noopener noreferrer">View</a>
              {{#unless ../content.benefitNotice}}
                {{#if isDefault}}
                  <span class="text-muted">Created for you, and kept</span>
                {{else if isConfirmDelete}}
                  <form method="POST" action="{{deleteHref}}" class="inline-form">
                    <input type="hidden" name="confirmed" value="1" />
                    <span class="text-secondary">Are you sure?</span>
                    <button type="submit" class="btn-link-danger">Confirm Delete</button>
                    <a href="{{../content.listHref}}">Cancel</a>
                  </form>
                {{else}}
                  <form method="POST" action="{{deleteHref}}" class="inline-form" data-confirm="Delete this gallery? This cannot be undone.">
                    <button type="submit" class="btn-link-danger">Delete</button>
                  </form>
                {{/if}}
              {{/unless}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    </div>
  {{else}}
    {{#if content.teaching}}
      {{> _teaching-empty-state teaching=content.teaching uploadMediaHref=content.uploadMediaHref}}
    {{else}}
      <p class="empty-state">You haven't created any galleries yet.</p>
    {{/if}}
  {{/if}}
</div>
