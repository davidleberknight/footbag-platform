{{> player-hero heroData=content.heroData}}

<div class="wrapper">
  <section>
    {{#if page.notice}}
      <div class="form-success-banner" role="status">{{page.notice}}</div>
    {{/if}}
    {{#if content.clubActionNotice}}
      <p class="notice mb-6" role="status">{{content.clubActionNotice}}</p>
    {{/if}}
    <div class="profile-layout">

      <div class="profile-sidebar">
        <div class="profile-avatar-card card">
          {{#if content.avatarThumbUrl}}
          <img src="{{content.avatarThumbUrl}}" alt="{{content.displayName}}" class="profile-avatar-img" />
          {{else}}
          <div class="profile-avatar-placeholder" aria-hidden="true">&#128100;</div>
          {{/if}}
          {{#each navigation.contextLinks}}
            <a href="{{href}}" class="btn btn-primary profile-edit-btn">{{label}}</a>
          {{/each}}
        </div>
      </div>

      <div class="profile-main">

        {{! Sections run in the order a member reads them: what the platform is
            waiting on, then who you are, then what being a member gets you,
            then your own things, then account administration. Nothing
            outstanding renders nothing at all: no empty state, no "all caught
            up". The member's own links sit inside About rather than taking a
            heading of their own, because they are part of who you are. }}

        {{#unless content.actions.isEmpty}}
          {{> member-block-actions content.actions}}
        {{/unless}}

        <div class="profile-section">
          <h2 class="profile-section-heading">About</h2>
          {{#if content.bio}}
            <p>{{content.bio}}</p>
          {{else}}
            <p class="text-muted">No bio yet. <a href="{{content.profileBase}}/edit">Edit your profile</a> to tell people about yourself.</p>
          {{/if}}
          {{#if content.links.length}}
            <ul>
              {{#each content.links}}
                <li>{{{externalLink this.url label=this.label}}}</li>
              {{/each}}
            </ul>
          {{/if}}
        </div>

        {{> member-block-membership content.membership}}

        {{> member-block-search content.search}}

        {{! Only an organizer-tier member has a shortcut left here, so the block
            is absent for everyone else rather than standing empty. It sits with
            the other things a tier buys. }}
        {{#if content.quickActions.length}}
          {{> member-block-quick-actions content.quickActions}}
        {{/if}}

        {{> member-block-my-clubs content.myClubs}}

        {{! Rendered whether or not the member has media: this is where sharing
            is found, so a member with none needs it most. }}
        {{> member-block-media content.media}}

        <div class="profile-section">
          {{#if content.eventGroups.length}}
            <h2 class="profile-section-heading">Competitive Results <span class="section-count">{{content.eventGroups.length}} events</span></h2>
          {{/if}}
          {{#unless content.showCompetitiveResults}}
            <p class="text-muted fs-sm">Only you can see this. Public viewers do not see your competition results because "Show my competition results on my profile" is off.</p>
          {{/unless}}
          {{> player-results eventGroups=content.eventGroups firstCompetitionYear=content.firstCompetitionYear showCompetingSince=content.showCompetingSince}}
        </div>

        {{> member-block-identity content.identity}}

        <div class="profile-section">
          <h2 class="profile-section-heading">Account</h2>
          <ul class="profile-account-list">
            <li><a href="{{content.profileBase}}/edit/password">Change Password</a></li>
            <li><a href="{{content.profileBase}}/email-preferences">Email Preferences</a></li>
            <li><a href="{{content.profileBase}}/payments">Payment History</a></li>
            <li><a href="/donate">Donate to IFPA</a></li>
            <li><span class="disabled">Download My Data</span></li>
            <li><span class="disabled">Delete Account</span></li>
          </ul>
        </div>

      </div>
    </div>
  </section>
</div>
