<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">
  <section>
    {{> outcome-notice lines=content.errorList tone='no'}}
    {{> outcome-notice text=content.notice tone=content.noticeTone}}

    {{#if content.pendingNotice}}
    <p class="notice-card notice-card--info" data-announce-pending>{{content.pendingNotice}}</p>
    {{/if}}
    {{#if content.returnedNotice}}
    <p class="notice-card notice-card--info" data-announce-returned>{{content.returnedNotice}}</p>
    {{/if}}

    {{#if content.hasRecipients}}
    <p class="text-muted">{{content.recipientLine}}</p>
    {{else}}
    <p class="notice-card notice-card--warn">Nobody is subscribed to community announcements at the moment, so a message sent now would reach no one.</p>
    {{/if}}

    <form method="POST" action="{{content.formAction}}" class="form-block">
      <input type="hidden" name="sendToken" value="{{content.sendToken}}" />
      <div class="form-field">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" value="{{content.subject}}" maxlength="{{content.subjectMax}}" required />
      </div>
      <div class="form-field">
        <label for="bodyText">Message</label>
        <textarea id="bodyText" name="bodyText" rows="16" maxlength="{{content.bodyMax}}" required>{{content.bodyText}}</textarea>
        <p class="fs-sm">Plain text only. Every recipient chose to receive these and can stop at any time from their own email preferences, so there is no need to write an unsubscribe line.</p>
      </div>
      <div class="form-field">
        <input type="hidden" name="agree" value="0" />
        <label><input type="checkbox" id="agree" name="agree" value="1" {{#if content.agreeChecked}}checked{{/if}} /> I have read and agree to the <a href="/community-standards">Community Standards</a>.</label>
      </div>
      {{> volunteer-admin-notice}}
      <button type="submit" class="btn btn-primary">Submit for Review</button>
    </form>
  </section>

  {{> back-link}}
</div>
