<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    {{#if page.intro}}<p class="hero-subtitle">{{page.intro}}</p>{{/if}}
  </div>
</div>

<div class="wrapper">
  <section>
    {{> outcome-notice lines=content.errorList tone='no'}}
    {{> outcome-notice text=content.notice tone=content.noticeTone}}

    {{#if content.pendingNotice}}
    <p class="notice-card notice-card--info" data-announce-pending>{{content.pendingNotice}}</p>
    {{/if}}
    {{#if content.returnedNotice}}
    <p class="notice-card notice-card--info" data-announce-returned>{{content.returnedNotice}}</p>
    {{/if}}

    {{#if content.hasRecipients}}
    <p class="text-muted">{{content.recipientLine}}</p>
    {{else}}
    <p class="notice-card notice-card--warn">Nobody is subscribed to community announcements at the moment, so an email sent now would reach no one. A post in the news feed or on the blog can still be published.</p>
    {{/if}}

    <form method="POST" action="{{content.formAction}}" class="form-block">
      <input type="hidden" name="sendToken" value="{{content.sendToken}}" />
      <div class="form-field">
        <label for="subject">Subject</label>
        <input type="text" id="subject" name="subject" value="{{content.subject}}" maxlength="{{content.subjectMax}}" required />
      </div>
      <div class="form-field">
        <label for="bodyText">Message</label>
        <textarea id="bodyText" name="bodyText" rows="16" maxlength="{{content.bodyMax}}" required>{{content.bodyText}}</textarea>
        <p class="fs-sm">The email sends your message exactly as typed. In the news feed and on the blog it is shown as Markdown, so **bold**, *italics*, lists and [links](https://example.com) are formatted there. Every email recipient chose to receive these and can stop at any time from their own email preferences, so there is no need to write an unsubscribe line.</p>
      </div>
      <fieldset class="form-fieldset" data-announce-places>
        <legend>Where to Publish</legend>
        <div class="form-field">
          <input type="hidden" name="publishList" value="0" />
          <label><input type="checkbox" id="publishList" name="publishList" value="1" {{#if content.publishListChecked}}checked{{/if}} /> By email to the announcements list</label>
        </div>
        <div class="form-field">
          <input type="hidden" name="publishFeed" value="0" />
          <label><input type="checkbox" id="publishFeed" name="publishFeed" value="1" {{#if content.publishFeedChecked}}checked{{/if}} /> In the news feed, as a Community post</label>
        </div>
        <div class="form-field">
          <input type="hidden" name="publishBlog" value="0" />
          <label><input type="checkbox" id="publishBlog" name="publishBlog" value="1" {{#if content.publishBlogChecked}}checked{{/if}} /> On the blog, as your own post under your name</label>
        </div>
        <p class="fs-sm">Choose the email, a place on the site, or both. A post goes in the news feed or on the blog, not both. A Community post must be news for the community, not opinion; a blog post is your own writing under your name.</p>
      </fieldset>
      {{#if content.hasSummaryEventOptions}}
        <div class="form-field">
          <label for="summaryEventId">This is the after-event summary for</label>
          <select id="summaryEventId" name="summaryEventId">
            <option value="">No event: an ordinary announcement</option>
            {{#each content.summaryEventOptions}}
              <option value="{{this.value}}"{{#if this.selected}} selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          <p class="fs-sm">A sanctioned event's organizers send a short summary of it to the announcements list within 20 days of its last day. Choose the event when this is that summary; a summary must go to the announcements list.</p>
        </div>
      {{/if}}
      <div class="form-field">
        <input type="hidden" name="agree" value="0" />
        <label><input type="checkbox" id="agree" name="agree" value="1" {{#if content.agreeChecked}}checked{{/if}} /> I have read and agree to the <a href="/community-standards">Community Standards</a>.</label>
      </div>
      {{> volunteer-admin-notice}}
      <button type="submit" class="btn btn-primary">Submit for Review</button>
    </form>
  </section>

  {{> back-link}}
</div>
