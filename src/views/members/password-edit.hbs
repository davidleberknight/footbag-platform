<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <section>
    {{#each navigation.contextLinks}}
      <a href="{{href}}" class="back-link">{{label}}</a>
    {{/each}}

    {{#if content.success}}
      {{> outcome-notice text="Your password has been changed." tone='ok'}}
    {{/if}}

    {{> outcome-notice text=content.error tone='no'}}

    <form method="POST" action="/members/{{content.memberKey}}/edit/password" class="form-block">
      <div class="form-field">
        <label for="oldPassword">Current password</label>
        <input
          type="password"
          id="oldPassword"
          name="oldPassword"
          autocomplete="current-password"
          maxlength="128"
          required
        />
      </div>

      <div class="form-field">
        <label for="newPassword">New password</label>
        <input
          type="password"
          id="newPassword"
          name="newPassword"
          autocomplete="new-password"
          minlength="8"
          maxlength="128"
          required
        />
      </div>

      <div class="form-field">
        <label for="confirmPassword">Confirm new password</label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          autocomplete="new-password"
          minlength="8"
          maxlength="128"
          required
        />
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Change Password</button>
      </div>
    </form>
  </section>
</div>
