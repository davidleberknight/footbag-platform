{{!--
  Share Media: the one form a member shares through, the shared Share Media
  form (partial share-media-form). Owner-only view (anti-enumeration 404
  elsewhere).
--}}
<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <p>{{content.intro}}</p>

  {{> outcome-notice text=content.notice}}
  {{> outcome-notice text=content.errorMessage tone='no'}}

  {{> share-media-form c=content}}
</div>
