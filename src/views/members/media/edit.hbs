{{!--
  Member-owned per-item media edit form. Owner-only (anti-enumeration
  404 elsewhere). Mirrors the form rows of the admin curator edit
  page; sidecar / creator / tier / clip-range fields are admin-only
  and not surfaced here.
--}}
<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <p>{{content.intro}}</p>

  {{> outcome-notice text=content.errorMessage tone='no'}}

  <form id="{{content.editFormId}}" action="{{content.formAction}}" method="POST" class="form-block">
    <div class="form-field">
      <label for="member-media-caption">Caption (optional, up to 500 characters):</label>
      <textarea id="member-media-caption" name="caption" maxlength="500" rows="3">{{content.formValues.caption}}</textarea>
    </div>

    <div class="form-field">
      <label for="member-media-tags">Hashtags (start each with #; typing # or pressing Enter starts the next):</label>
      <input id="member-media-tags" type="text" name="tags" value="{{content.formValues.tags}}" placeholder="#freestyle #spike" data-tag-chips data-tag-entry>
      {{> hashtag-slug-help}}
    </div>
    {{#if content.tagSuggestions}}
    <div class="tag-suggestions">
      {{#if content.tagSuggestions.playerTags.length}}
      <div class="tag-suggestions-group">
        <span class="tag-suggestions-label">You as the player:</span>
        {{#each content.tagSuggestions.playerTags}}
        <button type="button" class="tag-chip tag-suggestion" data-tag="{{normalized}}">{{display}}</button>
        {{/each}}
      </div>
      {{/if}}
      {{#if content.tagSuggestions.clubTags.length}}
      <div class="tag-suggestions-group">
        <span class="tag-suggestions-label">Your clubs:</span>
        {{#each content.tagSuggestions.clubTags}}
        <button type="button" class="tag-chip tag-suggestion" data-tag="{{normalized}}">{{display}}</button>
        {{/each}}
      </div>
      {{/if}}
      {{#if content.tagSuggestions.participatedEventTags.length}}
      <div class="tag-suggestions-group">
        <span class="tag-suggestions-label">Your events:</span>
        {{#each content.tagSuggestions.participatedEventTags}}
        <button type="button" class="tag-chip tag-suggestion" data-tag="{{normalized}}">{{display}}</button>
        {{/each}}
      </div>
      {{/if}}
      {{#if content.tagSuggestions.recentEventTags.length}}
      <div class="tag-suggestions-group">
        <span class="tag-suggestions-label">Recent events:</span>
        {{#each content.tagSuggestions.recentEventTags}}
        <button type="button" class="tag-chip tag-suggestion" data-tag="{{normalized}}">{{display}}</button>
        {{/each}}
      </div>
      {{/if}}
      {{#if content.galleryChips.length}}
      <div class="tag-suggestions-group">
        <span class="tag-suggestions-label">Your galleries:</span>
        {{#each content.galleryChips}}
        <button type="button" class="tag-chip tag-suggestion" data-tag="{{tagsAttr}}">{{label}}</button>
        {{/each}}
      </div>
      <p class="form-hint">Adding a gallery's hashtags makes what you share show in that gallery.</p>
      {{/if}}
      {{#if content.tagSuggestions.popularTags.length}}
      <div class="tag-suggestions-group">
        <span class="tag-suggestions-label">Popular:</span>
        {{#each content.tagSuggestions.popularTags}}
        <button type="button" class="tag-chip tag-suggestion" data-tag="{{normalized}}">{{display}}</button>
        {{/each}}
      </div>
      {{/if}}
    </div>
    {{/if}}

    <div class="form-field">
      <label for="member-media-external-url">External URL (optional, link to source page or creator):</label>
      <input id="member-media-external-url" type="url" name="externalUrl" value="{{content.formValues.externalUrl}}" placeholder="https://example.com/article">
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save</button>
      <a href="{{content.cancelHref}}" class="btn btn-outline">Cancel</a>
    </div>
  </form>

  {{!-- The player search sits after the edit form, never inside it: its
        controls belong to the edit form by id, and coming after Save keeps
        Save the form's first submit button, the one Enter in a field presses. --}}
  <div class="section-heading"><h2>Find a Player</h2></div>
  {{> member-block-search content.playerSearch creditFormId=content.editFormId searchFormId=content.editFormId intro="Search for a member or historical player, then press Credit as Player to add their player hashtag and save the item."}}

  {{!-- A link, not a form: deletion is permanent with cascading tag removal,
        so it goes through a confirm page that works without JavaScript. --}}
  <a href="{{content.deleteConfirmHref}}" class="btn btn-outline btn-sm">Delete This Item</a>
</div>
{{> fold-token-script}}
<script src="{{{asset 'js/tag-chips.js'}}}" defer></script>
{{#if content.tagSuggestions}}
<script src="{{{asset 'js/tag-suggestions.js'}}}" defer></script>
{{/if}}
