<div class="results-section">
  <div class="results-section-header">
    <h3>{{#if disciplineName}}{{disciplineName}}{{else}}General Results{{/if}}</h3>
    {{#if teamType}}
      <span class="discipline-meta">{{teamType}}</span>
    {{/if}}
  </div>

  {{#if placements.length}}
    <div class="records-table-wrap" tabindex="0" role="region" aria-label="{{#if disciplineName}}{{disciplineName}}{{else}}Results{{/if}}">
    <table class="data-table" data-sortable>
      <thead>
        <tr>
          <th class="w-12" data-sort-type="number">Place</th>
          <th data-sort-type="text">Name</th>
          <th class="w-20" data-sort-type="text">Score</th>
        </tr>
      </thead>
      <tbody>
        {{#each placements}}
          <tr>
            <td class="placement-num {{medalClass}}">{{placement}}</td>
            <td>
              {{#if participants.length}}
                <ul class="participants-list">
                  {{#each participants}}
                    <li>
                      {{#if participantHref}}
                        <a href="{{participantHref}}">{{participantDisplayName}}</a>
                      {{else}}
                        {{participantDisplayName}}
                      {{/if}}
                      {{#if amateurLabel}} <span class="badge">{{amateurLabel}}</span>{{/if}}
                    </li>
                  {{/each}}
                </ul>
              {{/if}}
            </td>
            <td class="score-text">{{#if scoreText}}{{scoreText}}{{/if}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
    </div>
  {{/if}}
</div>
