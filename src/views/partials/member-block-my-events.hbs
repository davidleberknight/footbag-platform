<div class="profile-section" id="upcoming-events">
  <h2 class="profile-section-heading">Upcoming Events</h2>
  {{#if upcoming.length}}
    <div class="dated-list">
      {{#each upcoming}}{{> dated-item this compact=true}}{{/each}}
    </div>
  {{else}}
    <p>You are not registered for any upcoming events.</p>
  {{/if}}
</div>

<div class="profile-section" id="organized-events">
  <h2 class="profile-section-heading">Events I Organize</h2>
  <div class="my-clubs-block">
    {{#if events.length}}
      <ul class="my-clubs-list">
        {{#each events}}
          <li class="my-clubs-item">
            <div class="my-clubs-item-header">
              <a href="{{siteHref this.manageHref}}" class="my-clubs-name">{{this.title}}</a>
              <span class="badge">{{this.statusLabel}}</span>
              <span class="text-muted">{{this.dates}}</span>
            </div>
            <div class="my-clubs-actions">
              <a href="{{siteHref this.manageHref}}" class="btn btn-outline btn-sm">Manage Event</a>
              <form method="POST" action="{{this.stepDownAction}}" class="inline-form">
                <button type="submit" class="btn btn-outline btn-sm">Step Down as Organizer</button>
              </form>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p>You are not organizing any events.</p>
    {{/if}}

    {{#if createEventHref}}
      <div class="my-clubs-ctas">
        <a href="{{createEventHref}}" class="btn btn-outline">Create an Event</a>
      </div>
    {{/if}}
    {{#if createTierNotice}}
      <div class="mt-2">{{> _tier-benefit-notice notice=createTierNotice}}</div>
    {{/if}}
  </div>
</div>
