<div class="profile-section">
  <h2 class="profile-section-heading">My Clubs</h2>
  <div class="my-clubs-block">
    {{#if clubs.length}}
      <ul class="my-clubs-list">
        {{#each clubs}}
          <li class="my-clubs-item">
            <div class="my-clubs-item-header">
              <a href="{{this.clubHref}}" class="my-clubs-name">{{this.clubName}}</a>
              <span class="badge">{{this.designationLabel}}</span>
              {{#if this.isLeader}}
                <span class="badge badge-honor">{{this.leaderRole}}</span>
              {{/if}}
              {{#if this.canMakePrimary}}
                <form method="POST" action="{{this.makePrimaryHref}}" class="inline-form">
                  <input type="hidden" name="club_key" value="{{this.makePrimaryClubKey}}">
                  <button type="submit" class="btn btn-outline btn-sm">Make Primary</button>
                </form>
              {{/if}}
            </div>
            <div class="my-clubs-actions">
              {{#if this.canStepDown}}
                <form method="POST" action="{{this.clubHref}}/step-down" class="inline-form">
                  <button type="submit" class="btn btn-outline btn-sm">Step Down as Co-leader</button>
                </form>
              {{/if}}
              {{#if this.canMarkInactive}}
                <form method="POST" action="{{this.clubHref}}/mark-inactive" class="inline-form">
                  <button type="submit" class="btn btn-outline btn-sm">Mark Inactive</button>
                </form>
              {{/if}}
              {{#if this.canReactivate}}
                <form method="POST" action="{{this.clubHref}}/reactivate" class="inline-form">
                  <button type="submit" class="btn btn-outline btn-sm">Reactivate Club</button>
                </form>
              {{/if}}
              {{#if this.canVolunteer}}
                <form method="POST" action="{{this.volunteerHref}}" class="inline-form">
                  <button type="submit" class="btn btn-outline btn-sm">{{#if this.clubIsLeaderless}}This Club Has No Co-leader Yet; Become Its First{{else}}Volunteer to Co-lead{{/if}}</button>
                </form>
              {{/if}}
              <form method="POST" action="{{this.leaveHref}}" class="inline-form">
                <button type="submit" class="btn btn-outline btn-sm">Leave Club</button>
              </form>
            </div>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="text-muted">You have no club affiliations yet.</p>
      {{#if nearbySuggestions.length}}
        <h3 class="mt-4">Clubs in Your Area</h3>
        <ul class="candidate-list">
          {{#each nearbySuggestions}}
            <li class="candidate-card">
              <div class="candidate-card-name">{{this.clubName}}</div>
              {{#if this.city}}<div class="candidate-card-meta text-muted">{{this.city}}</div>{{/if}}
              <a href="{{this.clubHref}}" class="btn btn-outline mt-2">View Club</a>
            </li>
          {{/each}}
        </ul>
      {{/if}}
    {{/if}}

    <div class="my-clubs-ctas mt-4">
      {{#if canAddClub}}
        <a href="{{browseClubsHref}}" class="btn btn-outline">Browse Clubs</a>
      {{/if}}
      {{#if createClubHref}}
        <a href="{{createClubHref}}" class="btn btn-outline">Start a New Club</a>
      {{/if}}
    </div>
    {{#if createTierNotice}}
      <div class="mt-2">{{> _tier-benefit-notice notice=createTierNotice}}</div>
    {{/if}}
  </div>
</div>
