<div class="profile-section">
  <h2 class="profile-section-heading">Identity &amp; History</h2>
  {{> player-facts heroData=heroData}}
  <div>
    {{#if legacyAccount.linked}}
      <p data-old-account="linked">Old footbag.org account: linked{{#if legacyAccount.sinceDisplay}} (since {{legacyAccount.sinceDisplay}}){{/if}}.</p>
    {{else}}
      {{#if historicalPerson.linked}}
        <p data-old-account="none">Old footbag.org account: none on file.</p>
      {{else}}
        <p>No old account or past competition results linked.</p>
      {{/if}}
    {{/if}}
    {{#if historicalPerson.linked}}
      {{#unless heroData.historicalPersonName}}
        <p>Past competition results: linked.</p>
      {{/unless}}
    {{else}}
      {{#if legacyAccount.linked}}
        <p>Past competition results: not yet linked.</p>
      {{/if}}
    {{/if}}
    {{#if cta}}
      <a href="{{cta.href}}" class="btn btn-primary">{{cta.label}}</a>
    {{/if}}
  </div>
</div>
