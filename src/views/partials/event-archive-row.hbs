{{! One completed event as a compact ruled row, on the events landing page and
    the year pages: the title linking to the event and its description on the
    left, the date and the meta line (location, host club, hashtag, gallery) on
    the right. It draws the same service-shaped fields as a dated item. The
    title is the row's link, since the meta line carries links of its own. }}
<div class="event-list-row">
  <div class="event-list-main">
    <a class="event-list-title" href="{{siteHref href}}">{{title}}</a>
    {{#if excerpt}}<span class="text-muted fs-sm">{{excerpt}}</span>{{/if}}
  </div>
  <div class="event-list-meta">
    <span class="event-list-date">{{date}}</span>
    {{#each meta}}<span class="event-list-location">{{#if isHashtag}}{{#if href}}<a class="hashtag hashtag--media" href="{{siteHref href}}">{{text}}</a>{{else}}<span class="hashtag">{{text}}</span>{{/if}}{{else}}{{#if href}}<a href="{{siteHref href}}">{{text}}</a>{{else}}{{text}}{{/if}}{{/if}}</span>{{/each}}
  </div>
</div>
