{{#if showCompetingSince}}
  <p class="text-muted fs-sm">Competing since {{firstCompetitionYear}}</p>
{{/if}}

{{! The heading belongs to the page, not to this partial. Three pages render
    these results and they do not share one section style, so a heading carried
    in here would be native on one page and foreign on the others. }}
{{#if eventGroups.length}}
<p class="fs-xs mb-4">Published event results only. Historical records may be incomplete.</p>

{{! One table for the whole career: an event's name and year span its result
    rows, so a player with many events reads one list, not a table per event. }}
<div class="records-table-wrap" tabindex="0" role="region" aria-label="Competitive Results">
<table class="data-table">
  <thead>
    <tr>
      <th>Event</th>
      <th>Year</th>
      <th>Category</th>
      <th class="col-num">Place</th>
      {{#if hasDetailColumn}}<th>Details</th>{{/if}}
    </tr>
  </thead>
  <tbody>
    {{#each eventGroups}}
      {{#each results}}
        <tr>
          {{#if @first}}
          <td rowspan="{{../results.length}}"><a href="{{../eventHref}}">{{../eventTitle}}</a></td>
          <td rowspan="{{../results.length}}">{{yearFromDate ../startDate}}</td>
          {{/if}}
          <td>{{#if disciplineName}}{{disciplineName}}{{else}}&mdash;{{/if}}</td>
          <td class="col-num placement-num {{#if (eq placement 1)}}gold{{else if (eq placement 2)}}silver{{else if (eq placement 3)}}bronze{{/if}}">{{placement}}</td>
          {{#if ../../hasDetailColumn}}
          <td>{{detailPrefix}}{{#each teammates}}{{#unless @first}}, {{/unless}}{{#if playerHref}}<a href="{{playerHref}}">{{name}}</a>{{else}}{{name}}{{/if}}{{/each}}{{#if scoreText}}{{#if teammates.length}} &middot; {{/if}}{{scoreText}}{{/if}}</td>
          {{/if}}
        </tr>
      {{/each}}
    {{/each}}
  </tbody>
</table>
</div>

{{else}}
<div class="empty-state mt-10">
  <p>No competitive results on record.</p>
</div>
{{/if}}
