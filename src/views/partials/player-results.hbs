{{#if showCompetingSince}}
  <p class="text-muted fs-sm">Competing since {{firstCompetitionYear}}</p>
{{/if}}

{{! The heading belongs to the page, not to this partial. Three pages render
    these results and they do not share one section style, so a heading carried
    in here would be native on one page and foreign on the others. }}
{{#if eventGroups.length}}
<p class="text-muted fs-xs mb-4">Published event results only. Historical records may be incomplete.</p>

{{#each eventGroups}}
  <div class="player-event-block">
    <div class="player-event-header">
      <a href="{{eventHref}}" class="player-event-title">{{eventTitle}}</a>
      <span class="player-event-meta">{{formatDate startDate}} &middot; {{formatLocation city eventRegion eventCountry}}</span>
    </div>
    <table class="results-table player-results-table">
      <thead>
        <tr>
          <th>Discipline</th>
          <th>Place</th>
          {{#if hasDetailColumn}}<th></th>{{/if}}
        </tr>
      </thead>
      <tbody>
        {{#each results}}
          <tr>
            <td>{{#if disciplineName}}{{disciplineName}}{{else}}<span class="text-muted">-</span>{{/if}}</td>
            <td class="placement-num {{#if (eq placement 1)}}gold{{else if (eq placement 2)}}silver{{else if (eq placement 3)}}bronze{{/if}}">
              {{placement}}
            </td>
            {{#if ../hasDetailColumn}}
            <td>{{detailPrefix}}{{#each teammates}}{{#unless @first}}, {{/unless}}{{#if playerHref}}<a href="{{playerHref}}">{{name}}</a>{{else}}{{name}}{{/if}}{{/each}}{{#if scoreText}}{{#if teammates.length}} &middot; {{/if}}{{scoreText}}{{/if}}</td>
            {{/if}}
          </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{/each}}

{{else}}
<div class="empty-state mt-10">
  <p>No competitive results on record.</p>
</div>
{{/if}}
