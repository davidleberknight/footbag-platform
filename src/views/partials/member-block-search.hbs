{{!-- The one member search. Its heading belongs to the page that renders it,
      so each page heads it in its own section system. --}}
<div id="find-members">
  {{#if intro}}<p>{{intro}}</p>{{/if}}
  <div class="search-box-section">
    {{#if searchFormId}}
      {{!-- On an edit page the search belongs to the edit form and submits it by
            GET, so what was typed into the form arrives with the search and is
            shown again on the reloaded page instead of being lost. --}}
      <label for="find-members-q">Search members by name</label>
      <div class="search-box-form" role="search">
        <input type="text" id="find-members-q" name="q" form="{{searchFormId}}" minlength="2" maxlength="100"
               placeholder="Search by name..."
               value="{{query}}"
               class="search-box-input" />
        <button type="submit" form="{{searchFormId}}" formmethod="get" formaction="{{formAction}}#find-members" formnovalidate class="btn btn-primary" data-member-search-submit>Search</button>
      </div>
      <script src="{{{asset 'js/member-search-enter.js'}}}" defer></script>
    {{else}}
      <form method="GET" action="{{formAction}}#find-members" class="search-box-form" role="search">
        <input type="text" name="q" minlength="2" maxlength="100"
               placeholder="Search by name..."
               value="{{query}}"
               aria-label="Search members by name"
               class="search-box-input" />
        <button type="submit" class="btn btn-primary">Search</button>
      </form>
    {{/if}}
    </div>

    {{#if hasQuery}}
      {{#if rateLimited}}
        <p>Too many searches just now. Please wait a moment and try again.</p>
      {{else if tooShort}}
        <p>Please enter at least 2 characters.</p>
      {{else if results.length}}
        <div class="search-box-card-results-head">
          <strong>Results</strong>
          <span class="section-count">{{results.length}}{{#if hasMore}}+{{/if}}</span>
        </div>
        {{#if hasMore}}
          <p>Too many results. Please refine your search.</p>
        {{/if}}
        <div class="search-box-results">
          {{#each results}}
            <div class="search-box-result">
              <a href="{{href}}">{{displayName}}</a>
              {{#if location}}<span class="text-muted">{{location}}</span>{{/if}}
              {{#if genderLabel}}<span class="text-muted">{{genderLabel}}</span>{{/if}}
              {{#if isHistorical}}<span class="badge badge-historical">Historical</span>{{else}}<span class="badge badge-member">Member</span>{{/if}}
              {{#if tierBadge}}<span class="badge badge-tier">{{tierBadge}}</span>{{/if}}
              {{#if isActivePlayer}}<span class="badge badge-honor">Active Player</span>{{/if}}
              {{#if isHof}}<span class="badge badge-honor">HoF</span>{{/if}}
              {{#if isBap}}<span class="badge badge-honor">BAP</span>{{/if}}
              {{#if isBoard}}<span class="badge badge-honor">Board</span>{{/if}}
              {{#if ../creditFormId}}<button type="submit" form="{{../creditFormId}}" name="addPlayer" value="{{playerTag}}" class="btn btn-outline btn-sm">Credit as Player</button>{{/if}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <p>No members found matching "{{query}}".</p>
      {{/if}}
    {{/if}}
</div>
