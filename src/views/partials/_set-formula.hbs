{{! The set's formula.

    Where a set has no formula, the section says so rather than showing an empty
    code block: the launch mechanics can be settled while the bracket-grammar form
    is not yet authored, and those are different states. }}
<section class="set-detail-section" aria-label="Formula">
  <h2>Formula</h2>
  {{#if content.formula}}
  <code class="set-detail-formula">{{content.formula}}</code>
  {{else}}
  <p class="set-detail-component-note">Canonical JOB notation is pending: the launch mechanics are defined, but the bracket-grammar form is not yet authored.</p>
  {{/if}}
</section>
