{{!--
  Pathways block (Learn / Watch / Family cross-link summary).

  Only the pathways that lead somewhere render. A pathway with nothing behind
  it used to render anyway, carrying a sentence about its own emptiness ("No
  records yet", "This trick is not part of a named family."), which spends a
  heading and a line telling a reader about an absence they did not ask about.
  When none of the three leads anywhere the whole section is omitted.
--}}
{{#if (or content.pathways.learn.available (or content.pathways.watch.available content.pathways.family.available))}}
<section class="content-section trick-pathways" aria-label="What you can do with this trick">
  <div class="section-heading">
    <h2>What you can do with this trick</h2>
  </div>
  <ul class="trick-pathway-list">
    {{#if content.pathways.learn.available}}
    <li class="trick-pathway trick-pathway--learn">
      <h3 class="trick-pathway-title">Learn this trick</h3>
      <p class="trick-pathway-primary">{{content.pathways.learn.primaryText}}</p>
      {{#if content.pathways.learn.secondaryText}}
      <p class="trick-pathway-secondary">{{content.pathways.learn.secondaryText}}</p>
      {{/if}}
      {{#if content.pathways.learn.href}}
      <a class="action-link" href="{{{content.pathways.learn.href}}}">{{content.pathways.learn.hrefLabel}}</a>
      {{/if}}
    </li>
    {{/if}}
    {{#if content.pathways.watch.available}}
    <li class="trick-pathway trick-pathway--watch">
      <h3 class="trick-pathway-title">Watch records</h3>
      <p class="trick-pathway-primary">{{content.pathways.watch.primaryText}}</p>
      {{#if content.pathways.watch.secondaryText}}
      <p class="trick-pathway-secondary">{{content.pathways.watch.secondaryText}}</p>
      {{/if}}
      {{#if content.pathways.watch.href}}
      <a class="action-link" href="{{{content.pathways.watch.href}}}">{{content.pathways.watch.hrefLabel}}</a>
      {{/if}}
    </li>
    {{/if}}
    {{#if content.pathways.family.available}}
    <li class="trick-pathway trick-pathway--family">
      <h3 class="trick-pathway-title">Related families</h3>
      <p class="trick-pathway-primary">{{content.pathways.family.primaryText}}</p>
      {{#if content.pathways.family.secondaryText}}
      <p class="trick-pathway-secondary">{{content.pathways.family.secondaryText}}</p>
      {{/if}}
      {{#if content.pathways.family.href}}
      <a class="action-link" href="{{{content.pathways.family.href}}}">{{content.pathways.family.hrefLabel}}</a>
      {{/if}}
    </li>
    {{/if}}
  </ul>
</section>
{{/if}}
