{{! A legal document's body: last-updated date, contents, and its anchored sections of
    service-shaped prose. Shared by the legal page and the Community Standards. }}
<p class="legal-last-updated text-muted">Last updated: {{content.lastUpdated}}</p>

<nav class="legal-toc" aria-label="{{content.tocLabel}}">
  {{#each content.sections}}
    <a href="#{{id}}">{{heading}}</a>
  {{/each}}
</nav>

{{#each content.sections}}
  <section class="content-section legal-section" id="{{id}}">
    <h2 class="section-heading">{{heading}}</h2>
    {{#each paragraphs}}
      {{#if subheading}}<h3 class="content-subheading"{{#if id}} id="{{id}}"{{/if}}>{{subheading}}</h3>{{/if}}
      <p>{{#each body}}{{#if href}}{{{externalLink href label=text noIcon=true}}}{{else if path}}<a href="{{siteHref path}}">{{text}}</a>{{else if email}}<a href="mailto:{{email}}">{{text}}</a>{{else}}{{text}}{{/if}}{{/each}}</p>
      {{#if steps}}
        <ol>
          {{#each steps}}<li>{{this}}</li>{{/each}}
        </ol>
      {{/if}}
    {{/each}}
  </section>
{{/each}}
