{{! /net/teams/:teamId — team competitive history }}

<div class="hero hero-sm">
  <div>
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/net/teams">Teams</a> <span class="breadcrumb-sep">/</span>
      <span>{{page.title}}</span>
    </nav>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">

  <div class="event-meta-row">
    <span><a href="{{{content.team.hrefA}}}">{{content.team.personNameA}}</a> / <a href="{{{content.team.hrefB}}}">{{content.team.personNameB}}</a></span>
    <span>{{content.summary.appearanceCount}} appearances</span>
    <span>{{content.summary.winCount}} wins</span>
    <span>{{content.summary.podiumCount}} podiums</span>
    {{#if content.summary.yearSpan}}<span>{{content.summary.yearSpan}}</span>{{/if}}
  </div>

  <p class="source-note">{{content.disclaimer}}</p>

  {{#if content.byYear.length}}
  <section class="content-section">
    <div class="section-heading">
      <h2>Competition History</h2>
    </div>
    {{#each content.byYear}}
    <h3 class="year-heading">{{year}}</h3>
    <table class="data-table">
      <thead>
        <tr>
          <th>Event</th>
          <th>Discipline</th>
          <th class="col-rank">Place</th>
        </tr>
      </thead>
      <tbody>
        {{#each appearances}}
        <tr>
          <td><a href="{{{eventHref}}}">{{eventTitle}}</a></td>
          <td>{{disciplineLabel}}</td>
          <td class="col-rank">{{placementLabel}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/each}}
  </section>
  {{else}}
  <div class="empty-state">No competitive history found.</div>
  {{/if}}

</div>
