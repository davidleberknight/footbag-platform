<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p class="hero-subtitle">Your account is pending until these steps are done. Member features unlock when you finish.</p>
  </div>
</div>

<div class="wrapper">
  <section>
    <div class="card">
      <div class="card-title">Your Details</div>
      <p>Tell us where you live now and when you were born. These fields come first because we use them to find your old footbag.org records in the next step. The fields marked (required) must be filled in to save.</p>

      {{> outcome-notice text=content.error tone='no'}}

      <form method="POST" action="/register/wizard/personal_details/submit" class="form-block">
        <div class="form-field">
          <label for="city">City <span class="fw-600">(required)</span></label>
          <input type="text" id="city" name="city" maxlength="64" value="{{content.city}}" required />
          {{#if content.fieldErrors.city}}<p class="form-field-error" role="alert">{{content.fieldErrors.city}}</p>{{/if}}
        </div>

        <div class="form-field">
          <label for="country">Country <span class="fw-600">(required)</span></label>
          <select id="country" name="country" required data-country-picker>
            <option value="">Select your country</option>
            {{#each content.countryOptions}}
              <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          {{#if content.fieldErrors.country}}<p class="form-field-error" role="alert">{{content.fieldErrors.country}}</p>{{/if}}
        </div>

        {{#> region-picker id="region" pickers=content error=content.fieldErrors.region}}
          <label for="region">State or province <span class="fw-600">(required in the USA and Canada)</span></label>
        {{/region-picker}}

        <fieldset class="form-fieldset">
          <legend>Date of birth <span class="fw-600">(required)</span></legend>
          <small class="form-hint">For example, 31 March 1980. Your date of birth helps us match your old footbag.org account and competition records. It is private: only you and IFPA administrators can see it.</small>
          <div class="form-date-parts">
            <div class="form-field form-date-day">
              <label for="birthDay">Day</label>
              <input type="text" id="birthDay" name="birthDay" inputmode="numeric" maxlength="2"
                     autocomplete="bday-day" value="{{content.birthDay}}" />
              {{#if content.fieldErrors.birthDay}}<p class="form-field-error" role="alert">{{content.fieldErrors.birthDay}}</p>{{/if}}
            </div>
            <div class="form-field form-date-month">
              <label for="birthMonth">Month</label>
              <select id="birthMonth" name="birthMonth" autocomplete="bday-month">
                <option value="">Choose a month</option>
                {{#each content.birthMonthOptions}}
                  <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </select>
              {{#if content.fieldErrors.birthMonth}}<p class="form-field-error" role="alert">{{content.fieldErrors.birthMonth}}</p>{{/if}}
            </div>
            <div class="form-field form-date-year">
              <label for="birthYear">Year</label>
              <input type="text" id="birthYear" name="birthYear" inputmode="numeric" maxlength="4"
                     autocomplete="bday-year" value="{{content.birthYear}}" />
              {{#if content.fieldErrors.birthYear}}<p class="form-field-error" role="alert">{{content.fieldErrors.birthYear}}</p>{{/if}}
            </div>
          </div>
        </fieldset>

        <fieldset class="form-fieldset">
          <legend>Gender (competition eligibility) <span class="text-muted">(optional)</span></legend>
          <p class="fs-sm">Private by default: visible only to you and IFPA administrators. You can choose later, in your profile settings, to show it to signed-in members on your profile, in member search, and on club rosters. Used only to decide which women's or mixed competitions you can enter. Choose 'Prefer not to say' to keep it private; you can record your gender anytime to enter women's or mixed competitions.</p>
          <div class="form-field">
            <label>
              <input type="radio" name="gender" value="male" {{#if (eq content.gender "male")}}checked{{/if}} />
              Male
            </label>
            <label>
              <input type="radio" name="gender" value="female" {{#if (eq content.gender "female")}}checked{{/if}} />
              Female
            </label>
            <label>
              <input type="radio" name="gender" value="undisclosed" {{#if (eq content.gender "undisclosed")}}checked{{/if}} />
              Prefer not to say
            </label>
            {{#if content.fieldErrors.gender}}<p class="form-field-error" role="alert">{{content.fieldErrors.gender}}</p>{{/if}}
          </div>
        </fieldset>

        <div class="form-field">
          <label for="year">First competition year <span class="text-muted">(optional)</span></label>
          <input type="number" id="year" name="year" min="1972" inputmode="numeric"
                 value="{{content.yearValue}}" placeholder="e.g. 1998" />
          <small class="form-hint">Optional. The year you first competed in a footbag tournament. Will display on your profile if set.</small>
          {{#if content.fieldErrors.year}}<p class="form-field-error" role="alert">{{content.fieldErrors.year}}</p>{{/if}}
        </div>

        <div class="form-field">
          <label>
            <input type="hidden" name="showCompetitiveResults" value="0" />
            <input type="checkbox" name="showCompetitiveResults" value="1"
                   {{#if content.showCompetitiveResults}}checked{{/if}} />
            Show my competition results on my public profile
          </label>
          <small class="form-hint">You can change this any time from your profile settings.</small>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">{{content.submitLabel}}</button>
        </div>
      </form>
    </div>

  </section>
</div>
<script src="{{{asset 'js/region-picker.js'}}}" defer></script>
