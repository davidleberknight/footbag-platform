<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">
  <section>
    {{#if content.capHitNotice}}
      {{#> outcome-notice tone='info'}}
        {{content.capHitNotice.message}}
        <a href="{{content.capHitNotice.manageClubsHref}}">Manage your clubs</a>
      {{/outcome-notice}}
    {{/if}}

    <p>Your onboarding is complete. Welcome! Your profile is ready to use, and clubs, events, and everything else are open to you.</p>

    <p class="mt-2"><a href="{{content.dashboardHref}}" class="btn btn-primary">Continue to Your Profile</a></p>
  </section>
</div>
