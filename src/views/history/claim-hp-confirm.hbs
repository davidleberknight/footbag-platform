{{! Historical-person claim confirmation page }}

<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
  </div>
</div>

<div class="wrapper">

  <section>
    <p>These are a past player's competition results from the footbag archive. Claiming them links them to your account, so your Hall of Fame status, country, and career results appear on your profile.</p>

    {{#if content.error}}
      {{> outcome-notice text=content.error tone='no'}}
    {{else}}
      <div class="card mb-6">
        <p class="m-0 fw-500">Results under the name: {{content.personName}}</p>
        {{#if content.country}}
          <p class="m-0 mt-1 text-muted">Country: {{content.country}}</p>
        {{/if}}
        {{#if content.isHof}}
          <p class="m-0 mt-1 fw-500 text-secondary">Hall of Fame member</p>
        {{/if}}
        {{#if content.isBap}}
          <p class="m-0 mt-1 fw-500 text-secondary">Big Add Posse member</p>
        {{/if}}
        {{#if content.bioExcerpt}}
          <p class="m-0 mt-2 text-muted fs-sm">{{content.bioExcerpt}}</p>
        {{/if}}
      </div>

      {{#if content.clubAffiliations.length}}
        <h3>Club Affiliations</h3>
        <ul>{{#each content.clubAffiliations}}<li>{{this}}</li>{{/each}}</ul>
      {{/if}}
      {{#if content.eventsAttended.length}}
        <h3>Events Attended</h3>
        <ul>{{#each content.eventsAttended}}<li>{{this.title}} ({{this.year}})</li>{{/each}}</ul>
      {{/if}}

      {{#if content.firstNameWarning}}
        <div class="notice-card notice-card--warn-strong my-4">
          <p class="m-0">First-name difference: the first name on these results does not exactly match the first name on your account. This is allowed if you use a common variant (e.g. Dave vs David). Go ahead only if these results are yours.</p>
        </div>
      {{/if}}

      <p>This will link these results to your account and carry forward country, Hall of Fame status, and induction year where applicable. Your display name and login credentials will not be changed.</p>

      <form method="POST" action="/history/{{content.personId}}/claim/confirm">
        <button type="submit" class="btn btn-primary">Yes, This Is Me: Link These Results</button>
      </form>

      <p class="mt-4"><a href="{{content.cancelHref}}">Cancel</a></p>
    {{/if}}
  </section>

</div>
