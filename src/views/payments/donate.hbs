<div class="hero hero-sm">
  <div>
    <h1>{{page.title}}</h1>
    <p class="hero-subtitle">{{page.intro}}</p>
  </div>
</div>

<div class="wrapper">
  <section>
    {{> outcome-notice text=content.formError tone='no'}}

    {{#if content.hasActiveRecurring}}
      <p class="notice-card notice-card--info">
        You already have a recurring donation running. You can review or cancel it on your
        <a href="{{content.paymentHistoryHref}}">payment history</a> page. Setting up another one
        here will run alongside it.
      </p>
    {{/if}}

    <form method="POST" action="{{content.action}}" class="form-block">
      <input type="hidden" name="returnTo" value="{{content.returnTo}}">

      <fieldset class="form-fieldset">
        <legend>How much would you like to give?</legend>

        {{#each content.suggestedAmounts}}
          <div class="form-field">
            <label>
              <input type="radio" name="amountChoice" value="{{this.cents}}"{{#if this.checked}} checked{{/if}}>
              {{this.label}}
            </label>
          </div>
        {{/each}}

        <div class="form-field">
          <label>
            <input type="radio" name="amountChoice" value="custom"{{#if content.customAmountChecked}} checked{{/if}}>
            Another amount
          </label>
        </div>
        {{#if content.fieldErrors.amountChoice}}
          <p class="form-field-error" role="alert">{{content.fieldErrors.amountChoice}}</p>
        {{/if}}

        <div class="form-field">
          <label for="customAmount">Another amount, in US dollars</label>
          <input type="text" id="customAmount" name="customAmount" inputmode="decimal"
                 autocomplete="off" placeholder="25.00" value="{{content.customAmountValue}}">
          {{#if content.fieldErrors.customAmount}}
            <p class="form-field-error" role="alert">{{content.fieldErrors.customAmount}}</p>
          {{/if}}
          <small class="form-hint">
            Between {{content.minAmountDisplay}} and {{content.maxAmountDisplay}}. Used only when
            you choose Another amount above.
          </small>
        </div>
      </fieldset>

      <fieldset class="form-fieldset">
        <legend>How often?</legend>

        <div class="form-field">
          <label>
            <input type="radio" name="recurring" value="no"{{#unless content.recurringYearly}} checked{{/unless}}>
            Once
          </label>
        </div>

        <div class="form-field">
          <label>
            <input type="radio" name="recurring" value="yes"{{#if content.recurringYearly}} checked{{/if}}>
            Every year
          </label>
          {{#if content.fieldErrors.recurring}}
            <p class="form-field-error" role="alert">{{content.fieldErrors.recurring}}</p>
          {{/if}}
          <small class="form-hint">
            An annual donation renews on its own. You can cancel it at any time from your payment
            history page, and the period you have already given still counts.
          </small>
        </div>
      </fieldset>

      <fieldset class="form-fieldset">
        <legend>Would you like to add a note?</legend>

        <div class="form-field">
          <label for="note">Note (optional)</label>
          <input type="text" id="note" name="note" maxlength="{{content.noteMaxChars}}"
                 placeholder="In memory of..." value="{{content.noteValue}}">
          {{#if content.fieldErrors.note}}
            <p class="form-field-error" role="alert">{{content.fieldErrors.note}}</p>
          {{/if}}
          <small class="form-hint">
            For example "Worlds", the name of a tournament, "General fund" or "In memory of...".
            Stored with your donation and shown on your payment history. Up to
            {{content.noteMaxChars}} characters.
          </small>
        </div>
      </fieldset>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Continue to Payment</button>
        <a href="{{content.returnTo}}" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </section>
</div>
